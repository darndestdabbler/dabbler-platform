bin/
obj/
.vs/
TestResults/
playwright-report/
test-results/
.idea/
*.user
*.suo
*.swp
*.tmp
__pycache__/
*.pyc
.venv/

# Dev IdP runtime SQLite database (created on first run)
src/Libs/Dabbler.Security.DevIdp/devidp.db
src/Libs/Dabbler.Security.DevIdp/devidp.db-shm
src/Libs/Dabbler.Security.DevIdp/devidp.db-wal

# Local dotnet tools (dabbler-uat-dsl CLI etc. — installed on demand
# via `dotnet tool install --tool-path .tools`; never committed.
# Fresh clones / CI install from Directory.Packages.props or the
# sibling repo's pack-output).
.tools/

# Session-state migrator rollback artifacts (one-cycle backups).
# git history is the canonical rollback path; .bak files are
# short-window cruft. See ../dabbler-ai-orchestration/docs/v3-to-v4-rollback-procedure.md.
docs/session-sets/*/session-state.v3.bak.json
docs/session-sets/*/session-state.lwbak.json

# Dabbler router machine-side state: the run ledger records each
# verification round after the tree it describes, so committing it
# makes verified work look like it changed post-verification.
.dabbler/

# v3 Dabbler: machine-only overlay
local-overrides.yaml
# packed artifacts come from tools/pack.ps1 or `dabbler packaging`, never from git
pack-output/
tmp/
.tmp/
# DevIdp dev database at the repo root
/devidp.db*

# MSBuild's own output, and what `dotnet test` and Coverlet write, which land inside the project they ran in.
coverage*.json
coverage*.xml
