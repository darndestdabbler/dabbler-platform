<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- dotnet tool packaging (A6) -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dabbler-devidp</ToolCommandName>
    <IsPackable>true</IsPackable>

    <!-- NuGet package identity -->
    <PackageId>Dabbler.Security.DevIdp.Tool</PackageId>
    <Description>Loopback dev IdP for Dabbler platform development. Run `dabbler-devidp` to start an OpenIddict-backed OIDC server on localhost:5100 that issues Entra-ID-compatible tokens for local development without a real cloud IdP.</Description>
    <PackageTags>dotnet-tool;devidp;oidc;development;dabbler</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Exclude from solution-level build by default (tool, not a library) -->
    <IsTestProject>false</IsTestProject>

    <!-- The tool serves no static files (no wwwroot, no UseStaticFiles or
         MapStaticAssets). Under .NET SDK 11 a Debug build of a Web SDK project
         adds a Hot Reload browser-tools module, which fails the build here
         because it has no matching static asset endpoint. -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Libs\Dabbler.Security.DevIdp\Dabbler.Security.DevIdp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
