@using Dabbler.Security.Blazor.Components.Admin
@using MudBlazor
@inject IDialogService DialogService

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@code {
    public async Task ShowAsync(
        string roleName,
        List<string> existingRoleNames,
        bool isEdit = false)
    {
        var parameters = new DialogParameters<RoleFormDialog>
        {
            { x => x.RoleName, roleName },
            { x => x.IsEdit, isEdit },
            { x => x.AvailableRoles, new List<string>() },
            { x => x.ExistingRoleNames, existingRoleNames }
        };

        await DialogService.ShowAsync<RoleFormDialog>(
            isEdit ? "Edit Role" : "Add Role",
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
    }
}
