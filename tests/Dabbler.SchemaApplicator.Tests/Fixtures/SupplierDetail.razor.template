@using AcmeCoffeeOnline.Shared.DTOs
@using AcmeCoffeeOnline.Web.Data
@using Dabbler.Components.MasterDetail
@using MudBlazor
@inject SupplierApiClient ApiClient
@inject IDialogService DialogService
@inject NavigationManager NavigationManager

@* Generated by dabbler-crud-page; per-property form fields are filled in by
   Apply-SupplierSchema.ps1 (re-run after editing the schema).

   Form fields use explicit Value + ValueChanged plus _session?.NotifyChanged();
   the two-way binding shorthand is forbidden because it bypasses EditSession<T>'s
   dirty tracking. See docs/planning/project-guidance.md → CRUD Form Conventions. *@

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" Color="Color.Primary" Class="ma-4" />
}
else if (_record is not null)
{
    @* ── Action row (Save + Undo) ──────────────────────────────────── *@
    @if (!IsReadOnly)
    {
        <DirtyAwareActionRow IsDirty="@(IsNew || (_session?.IsDirty ?? false))"
                             Saving="@_saving"
                             ShowCancel="false"
                             OnSave="HandleSaveAsync"
                             Class="mb-4"
                             CustomActionsPosition="ActionRowSlot.End">
            <CustomActions>
                @if (!IsNew)
                {
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.Undo"
                               OnClick="HandleUndo"
                               Disabled="@(!_session?.IsDirty ?? true)"
                               data-testid="undo-button">
                        Undo
                    </MudButton>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Error"
                               StartIcon="@Icons.Material.Filled.Delete"
                               OnClick="HandleDeleteAsync"
                               Disabled="@_saving"
                               data-testid="delete-button">
                        Delete
                    </MudButton>
                }
            </CustomActions>
        </DirtyAwareActionRow>
    }

    @* ── Form ─────────────────────────────────────────────────────── *@
    <MudForm @ref="_form" Model="_record">
        <MudGrid>
            @* DABBLER-SCAFFOLD:FORM-FIELDS:BEGIN *@
            @* (no form fields yet — re-run Apply-SupplierSchema.ps1 with a schema file) *@
            @* DABBLER-SCAFFOLD:FORM-FIELDS:END *@
        </MudGrid>
    </MudForm>
}
else
{
    <MudAlert Severity="Severity.Warning" Class="ma-4">Supplier not found.</MudAlert>
}

@code {
    [Parameter]
    public int? SupplierId { get; set; }

    [Parameter]
    public bool IsNew { get; set; }

    [Parameter]
    public bool IsReadOnly { get; set; }

    [Parameter]
    public EventCallback OnSaved { get; set; }

    [Parameter]
    public EventCallback OnDeleted { get; set; }

    private MudForm? _form;
    private SupplierDto? _record;
    private EditSession<SupplierDto>? _session;
    private bool _loading = true;
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        if (IsNew)
        {
            _record = new SupplierDto();
            _session = new EditSession<SupplierDto>(_record);
            _loading = false;
        }
        else if (SupplierId is not null)
        {
            _record = await ApiClient.GetByIdAsync(SupplierId.Value);
            if (_record is not null)
                _session = new EditSession<SupplierDto>(_record);
            _loading = false;
        }
        else
        {
            _loading = false;
        }
    }

    private void HandleUndo()
    {
        _session?.Undo();
    }

    private async Task HandleDeleteAsync()
    {
        if (_record is null) return;

        var confirmed = await DialogService.ShowMessageBox(
            "Delete Supplier",
            $"Delete Supplier #{_record.Id}? This cannot be undone.",
            yesText: "Delete",
            cancelText: "Cancel");
        if (confirmed != true) return;

        _saving = true;
        try
        {
            var deleted = await ApiClient.DeleteAsync(_record.Id);
            if (deleted)
            {
                await OnDeleted.InvokeAsync();
                NavigationManager.NavigateTo("/suppliers");
            }
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task HandleSaveAsync()
    {
        if (_form is not null)
        {
            await _form.Validate();
            if (!_form.IsValid) return;
        }

        if (_record is null) return;

        _saving = true;
        try
        {
            if (IsNew)
            {
                var created = await ApiClient.CreateAsync(_record);
                if (created is not null)
                {
                    _record = created;
                    _session = new EditSession<SupplierDto>(_record);
                    IsNew = false;
                }
            }
            else
            {
                var updated = await ApiClient.UpdateAsync(_record.Id, _record);
                if (updated is not null)
                    _session?.CommitFrom(updated);
            }

            await OnSaved.InvokeAsync();
        }
        finally
        {
            _saving = false;
        }
    }
}
