@using AcmeCoffeeOnline.Shared.DTOs
@using Dabbler.Components.Data
@using Dabbler.Components.MasterDetail
@using MudBlazor

@* Generated by dabbler-crud-page; per-property grid columns + filter properties are
   filled in by Apply-SupplierSchema.ps1 (re-run after editing the schema). *@

@* ── Filter panel ───────────────────────────────────────────────────── *@
<DeclarativeFilterPanel TEntity="SupplierDto"
                        Config="_filterConfig"
                        FilterChanged="@OnFilterChangedAsync" />

@* ── Toolbar ────────────────────────────────────────────────────────── *@
<div class="d-flex align-center gap-2 my-2">
    @if (!string.IsNullOrEmpty(_statusText))
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary">@_statusText</MudText>
    }
    <MudSpacer />
</div>

@* ── Error banner ───────────────────────────────────────────────────── *@
@if (_error is not null)
{
    <MudAlert Severity="Severity.Error"
              Variant="Variant.Filled"
              ShowCloseIcon="true"
              CloseIconClicked="@(() => { _error = null; StateHasChanged(); })"
              Class="mb-2">
        @_error.Message
    </MudAlert>
}

@* ── Data grid ──────────────────────────────────────────────────────── *@
<MudDataGrid T="SupplierDto"
             @ref="_mudDataGrid"
             ServerData="@ServerDataFuncAsync"
             Dense="true"
             Hover="true"
             Bordered="true"
             RowsPerPage="25"
             ReadOnly="true"
             Loading="@_isLoading"
             RowClick="@OnRowClick">
    <Columns>
        @* DABBLER-SCAFFOLD:GRID-COLUMNS:BEGIN *@
        <PropertyColumn Property="e => e.Id" Title="Id" />
        <PropertyColumn Property="e => e.Name" Title="Name" />
        <PropertyColumn Property="e => e.City" Title="City" />
        <PropertyColumn Property="e => e.Country" Title="Country" />
        <PropertyColumn Property="e => e.ContactEmail" Title="Contact Email" Sortable="false" />
        <PropertyColumn Property="e => e.IsActive" Title="Is Active" Sortable="false" />
        @* DABBLER-SCAFFOLD:GRID-COLUMNS:END *@
    </Columns>
    <PagerContent>
        <MudDataGridPager T="SupplierDto" />
    </PagerContent>
</MudDataGrid>

@code {
    private MudDataGrid<SupplierDto>? _mudDataGrid;
    private bool _isLoading;
    private Exception? _error;
    private int _currentTotal;
    private CompositeFilterDescriptor? _currentFilter;
    private CancellationTokenSource? _debounceCts;
    private string? _statusText;

    [Parameter, EditorRequired]
    public IGridDataProvider<SupplierDto> DataProvider { get; set; } = default!;

    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;

    private static readonly FilterConfig<SupplierDto> _filterConfig = new(
        FilterMode.ServerSide,
        new FilterProperty<SupplierDto>[]
        {
            // DABBLER-SCAFFOLD:FILTER-PROPERTIES:BEGIN
            new FilterProperty<SupplierDto>.Numeric { Property = e => (object?)e.Id, Label = "Id" },
            new FilterProperty<SupplierDto>.Text { Property = e => (object?)e.Name, Label = "Name" },
            new FilterProperty<SupplierDto>.Text { Property = e => (object?)e.City, Label = "City" },
            new FilterProperty<SupplierDto>.Text { Property = e => (object?)e.Country, Label = "Country" },
            new FilterProperty<SupplierDto>.Bool { Property = e => (object?)e.IsActive, Label = "Is Active" },
            // DABBLER-SCAFFOLD:FILTER-PROPERTIES:END
        });

    private async Task<GridData<SupplierDto>> ServerDataFuncAsync(GridState<SupplierDto> state)
    {
        _isLoading = true;
        _error = null;
        StateHasChanged();

        try
        {
            var request = new GridDataRequest
            {
                PageIndex = state.Page,
                PageSize = state.PageSize,
                CompositeFilter = _currentFilter,
                Sorts = state.SortDefinitions
                    .Select(s => new SortDescriptor(s.SortBy, s.Descending))
                    .ToList(),
            };

            var response = await DataProvider.FetchAsync(request);

            _currentTotal = response.TotalCount;
            _statusText = $"{_currentTotal:N0} records";

            return new GridData<SupplierDto>
            {
                Items = response.Items,
                TotalItems = response.TotalCount,
            };
        }
        catch (Exception ex)
        {
            _error = ex;
            _currentTotal = 0;
            _statusText = "0 records";
            return new GridData<SupplierDto> { Items = [], TotalItems = 0 };
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task OnFilterChangedAsync(CompositeFilterDescriptor? filter)
    {
        _currentFilter = filter;

        _debounceCts?.Cancel();
        _debounceCts = new CancellationTokenSource();

        try
        {
            await Task.Delay(200, _debounceCts.Token);
            if (_mudDataGrid is not null)
                await _mudDataGrid.ReloadServerData();
        }
        catch (TaskCanceledException) { }
    }

    private void OnRowClick(DataGridRowClickEventArgs<SupplierDto> args)
    {
        NavigationManager.NavigateTo($"/suppliers/{args.Item.Id}");
    }
}
