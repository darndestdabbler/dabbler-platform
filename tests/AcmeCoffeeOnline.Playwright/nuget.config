<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- W0 (dabbler-uat-dsl) packages produced by `dotnet pack -o pack-output`
         in the sibling repo. Re-pack after pulling W0 changes.
         Path is relative to THIS nuget.config file's directory
         (tests/AcmeCoffeeOnline.Playwright/), so three levels up reaches
         the parent of dabbler-platform where the sibling repo lives. -->
    <add key="dabbler-uat-dsl-local" value="..\..\..\dabbler-uat-dsl\pack-output" />
  </packageSources>
</configuration>
