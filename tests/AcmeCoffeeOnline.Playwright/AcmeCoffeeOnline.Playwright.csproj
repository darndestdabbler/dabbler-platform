<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <RootNamespace>AcmeCoffeeOnline.Playwright</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="PdfPig" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Xunit.SkippableFact" />
    <!-- W0 (dabbler-uat-dsl) packages. The runner emits Playwright C# code
         via the W0 compiler; the emitted code references IPlaywrightUatFixture
         from the Emitters.Playwright.CSharp package. Core is brought in
         transitively but listed explicitly for clarity. Local feed is
         configured in the repo-root nuget.config. -->
    <PackageReference Include="Dabbler.Uat.Dsl.Core" />
    <PackageReference Include="Dabbler.Uat.Dsl.Emitters.Playwright.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
