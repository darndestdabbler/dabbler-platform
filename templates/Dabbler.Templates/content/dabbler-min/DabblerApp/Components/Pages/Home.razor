@page "/"
@attribute [DabblerPageAuthorize("/")]
<PageTitle>Home — DabblerApp</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Welcome to DabblerApp</MudText>

<MudText Class="mb-3">
    This app was scaffolded from the <strong>dabbler-min</strong> template.
    It includes magic-link authentication and restriction-based authorization
