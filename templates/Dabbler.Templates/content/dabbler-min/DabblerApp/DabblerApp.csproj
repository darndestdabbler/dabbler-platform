<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Minimal platform surface: components + security only -->
    <PackageReference Include="Dabbler.Components" Version="DABBLER_PACKAGE_VERSION" />
    <PackageReference Include="Dabbler.Security" Version="DABBLER_PACKAGE_VERSION" />
    <PackageReference Include="Dabbler.Security.Blazor" Version="DABBLER_PACKAGE_VERSION" />

    <!-- UI -->
    <PackageReference Include="MudBlazor" Version="9.12.0" />

    <!-- Security DB -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.15" />
  </ItemGroup>

</Project>
