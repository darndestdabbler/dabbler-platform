<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Minimal platform surface: components + security only -->
    <PackageReference Include="Dabbler.Components" Version="0.1.0-preview.1" />
    <PackageReference Include="Dabbler.Security" Version="0.1.0-preview.1" />
    <PackageReference Include="Dabbler.Security.Blazor" Version="0.1.0-preview.1" />

    <!-- UI -->
    <PackageReference Include="MudBlazor" Version="8.15.0" />

    <!-- Security DB -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.5" />
  </ItemGroup>

</Project>
