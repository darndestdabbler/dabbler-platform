{
  "$schema": "http://json.schemastore.org/template",
  "author": "Dabbler Platform contributors",
  "classifications": [ "Web", "Blazor", "Server", "Security", "Reports" ],
  "identity": "Dabbler.Templates.App.CSharp",
  "name": "Dabbler App",
  "shortName": "dabbler-app",
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "sourceName": "DabblerApp",
  "preferNameDirectory": true,
  "description": "Full Blazor Server app with Dabbler security (magic-link, cookie auth, restriction-based authz), one sample CRUD entity, one sample report, and a bUnit test project with stub providers.",
  "symbols": {
    "Framework": {
      "type": "parameter",
      "description": "Target framework",
      "datatype": "choice",
      "choices": [
        { "choice": "net10.0", "description": ".NET 10.0 (LTS)" }
      ],
      "defaultValue": "net10.0",
      "replaces": "net10.0"
    }
  }
}
