<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- Local packages feed for Dabbler.* platform packages not yet on nuget.org.
         Populate by copying the .nupkg files from dabbler-platform pack-output/ into packages/. -->
    <add key="local" value="./packages" />
  </packageSources>
</configuration>
