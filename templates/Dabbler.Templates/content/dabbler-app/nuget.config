<?xml version="1.0" encoding="utf-8"?>
<!--
  Feed-only NuGet configuration. The Dabbler.* platform packages restore from
  nuget.org (anonymous read — no auth token required for restore). <clear/>
  drops any inherited machine/user package sources so restore is deterministic
  across every consumer repo and CI runner.

  Dabbler.* references are pinned to the exact version of the
  Dabbler.Templates package that scaffolded this app (never a floating range).
  Offline / air-gapped restore is an opt-in procedure — see README "Offline
  restore"; do not commit a local packages source by default.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
