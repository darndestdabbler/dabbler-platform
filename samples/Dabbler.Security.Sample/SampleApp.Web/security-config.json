{
  "Roles": [
    {
      "RoleName": "SystemAdministrator",
      "Description": "Full administrative access including runtime security configuration."
    },
    {
      "RoleName": "UserAdministrator",
      "Description": "Can manage users and assign roles."
    },
    {
      "RoleName": "Manager",
      "Description": "Full widget access \u2014 can create, read, update, and delete."
    },
    {
      "RoleName": "Viewer",
      "Description": "Read-only widget access."
    },
    {
      "RoleName": "ViewerPlus",
      "Description": "Enhanced viewer \u2014 can see the Delete button (disabled, not hidden)."
    }
  ],
  "PagePermissions": [
    {
      "PageKey": "/",
      "AllowedRoles": [],
      "DeniedRoles": []
    },
    {
      "PageKey": "/widgets",
      "AllowedRoles": [
        "SystemAdministrator",
        "UserAdministrator",
        "Manager",
        "Viewer",
        "ViewerPlus"
      ],
      "DeniedRoles": []
    },
    {
      "PageKey": "/admin/security",
      "AllowedRoles": [
        "SystemAdministrator"
      ],
      "DeniedRoles": []
    },
    {
      "PageKey": "/admin/users",
      "AllowedRoles": [
        "SystemAdministrator",
        "UserAdministrator"
      ],
      "DeniedRoles": []
    }
  ],
  "EntityPermissions": [
    {
      "EntityKey": "Widget",
      "RolePermissions": [
        {
          "RoleName": "SystemAdministrator",
          "AllowedOperations": [
            "Create",
            "Read",
            "Update",
            "Delete"
          ]
        },
        {
          "RoleName": "Manager",
          "AllowedOperations": [
            "Create",
            "Read",
            "Update",
            "Delete"
          ]
        },
        {
          "RoleName": "Viewer",
          "AllowedOperations": [
            "Read"
          ]
        }
      ]
    }
  ],
  "FieldPermissions": [],
  "EndpointPermissions": [
    {
      "EndpointKey": "GET /api/widgets",
      "AllowedRoles": [
        "SystemAdministrator",
        "Manager",
        "Viewer"
      ]
    }
  ],
  "ControlPermissions": [
    {
      "PageKey": "/widgets",
      "ControlKey": "AddButton",
      "RolePermissions": [
        {
          "RoleName": "SystemAdministrator",
          "State": "Enabled"
        },
        {
          "RoleName": "Manager",
          "State": "Enabled"
        },
        {
          "RoleName": "Viewer",
          "State": "Hidden"
        }
      ]
    },
    {
      "PageKey": "/widgets",
      "ControlKey": "EditButton",
      "RolePermissions": [
        {
          "RoleName": "SystemAdministrator",
          "State": "Enabled"
        },
        {
          "RoleName": "Manager",
          "State": "Enabled"
        },
        {
          "RoleName": "Viewer",
          "State": "Hidden"
        }
      ]
    },
    {
      "PageKey": "/widgets",
      "ControlKey": "DeleteButton",
      "RolePermissions": [
        {
          "RoleName": "SystemAdministrator",
          "State": "Enabled"
        },
        {
          "RoleName": "Manager",
          "State": "Enabled"
        },
        {
          "RoleName": "Viewer",
          "State": "Hidden"
        }
      ]
    },
    {
      "PageKey": "/widgets",
      "ControlKey": "ExportButton",
      "RolePermissions": [
        {
          "RoleName": "SystemAdministrator",
          "State": "Enabled"
        },
        {
          "RoleName": "Manager",
          "State": "Enabled"
        },
        {
          "RoleName": "Viewer",
          "State": "Enabled"
        }
      ]
    }
  ],
  "RowFilters": [
    {
      "EntityKey": "Widget",
      "RoleName": "Viewer",
      "FilterExpression": "OwnerId == @CurrentUserId",
      "Description": "Viewers see only widgets they own."
    }
  ],
  "RoleSwitching": {
    "AllowedRoles": [
      "SystemAdministrator",
      "UserAdministrator"
    ]
  }
}