@page "/"

<PageTitle>Home — Dabbler Security Sample</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Welcome to Dabbler Security Sample</MudText>

<AuthorizeView>
    <Authorized>
        <MudAlert Severity="Severity.Success" Class="mb-4">
            Signed in as <strong>@context.User.Identity!.Name</strong>
            (roles: @string.Join(", ", context.User.Claims
                .Where(c => c.Type == System.Security.Claims.ClaimTypes.Role)
                .Select(c => c.Value)))
        </MudAlert>

        <MudGrid>
            <MudItem xs="12" sm="6" md="4">
                <MudCard>
                    <MudCardContent>
                        <MudText Typo="Typo.h6"><MudIcon Icon="@Icons.Material.Filled.Widgets" Class="mr-1" />Widgets</MudText>
                        <MudText Typo="Typo.body2">View the widget list. Requires Widget.Read permission (Manager or Viewer role).</MudText>
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton Href="/widgets" Variant="Variant.Filled" Color="Color.Primary">Open Widgets</MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudCard>
                    <MudCardContent>
                        <MudText Typo="Typo.h6"><MudIcon Icon="@Icons.Material.Filled.People" Class="mr-1" />User Admin</MudText>
                        <MudText Typo="Typo.body2">Manage users and assign roles. Requires UserAdministrator role.</MudText>
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton Href="/admin/users" Variant="Variant.Filled" Color="Color.Secondary">Open Users</MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudCard>
                    <MudCardContent>
                        <MudText Typo="Typo.h6"><MudIcon Icon="@Icons.Material.Filled.Badge" Class="mr-1" />Role Admin</MudText>
                        <MudText Typo="Typo.body2">View and manage roles and their permissions. Requires UserAdministrator role.</MudText>
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton Href="/admin/roles" Variant="Variant.Filled" Color="Color.Secondary">Open Roles</MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudCard>
                    <MudCardContent>
                        <MudText Typo="Typo.h6"><MudIcon Icon="@Icons.Material.Filled.Security" Class="mr-1" />Security Dashboard</MudText>
                        <MudText Typo="Typo.body2">Runtime permission configurator — manage roles, page/entity/endpoint access, row filters, and user assignments. Requires SystemAdministrator role.</MudText>
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton Href="/admin/security" Variant="Variant.Filled" Color="Color.Error">Open Dashboard</MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        </MudGrid>
    </Authorized>
    <NotAuthorized>
        <MudAlert Severity="Severity.Info" Class="mb-4">
            Sign in to explore the demo. Use the magic-link login — no password required.
        </MudAlert>
        <MudButton Href="/login" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large">
            Sign In
        </MudButton>
    </NotAuthorized>
</AuthorizeView>
