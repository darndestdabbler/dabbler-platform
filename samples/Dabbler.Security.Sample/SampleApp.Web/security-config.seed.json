{
  "Roles": [
    {
      "RoleName": "SystemAdministrator",
      "Description": "Full administrative access including runtime security configuration.",
      "IsSystemRole": true
    },
    {
      "RoleName": "UserAdministrator",
      "Description": "Can manage users and assign roles.",
      "IsSystemRole": true
    },
    {
      "RoleName": "Manager",
      "Description": "Full widget access — can create, read, update, and delete."
    },
    {
      "RoleName": "Editor",
      "Description": "Can read and update widgets."
    },
    {
      "RoleName": "Viewer",
      "Description": "Read-only widget access."
    }
  ],
  "PagePermissions": [
    {
      "PageKey": "/widgets",
      "AllowedRoles": [ "SystemAdministrator", "UserAdministrator", "Manager", "Editor", "Viewer" ]
    },
    {
      "PageKey": "/admin/security",
      "AllowedRoles": [ "SystemAdministrator" ]
    },
    {
      "PageKey": "/admin/users",
      "AllowedRoles": [ "UserAdministrator", "SystemAdministrator" ]
    }
  ],
  "EntityPermissions": [
    {
      "EntityKey": "Widget",
      "RolePermissions": [
        {
          "RoleName": "SystemAdministrator",
          "AllowedOperations": [ "Create", "Read", "Update", "Delete" ]
        },
        {
          "RoleName": "Manager",
          "AllowedOperations": [ "Create", "Read", "Update", "Delete" ]
        },
        {
          "RoleName": "Editor",
          "AllowedOperations": [ "Read", "Update" ]
        },
        {
          "RoleName": "Viewer",
          "AllowedOperations": [ "Read" ]
        }
      ]
    }
  ],
  "FieldPermissions": [],
  "EndpointPermissions": [
    {
      "EndpointKey": "GET /api/widgets",
      "AllowedRoles": [ "SystemAdministrator", "Manager", "Editor", "Viewer" ]
    }
  ],
  "ControlPermissions": [
    {
      "PageKey": "/widgets",
      "ControlKey": "AddButton",
      "RolePermissions": [
        { "RoleName": "SystemAdministrator", "State": "Enabled" },
        { "RoleName": "Manager",             "State": "Enabled" },
        { "RoleName": "Editor",              "State": "Enabled" },
        { "RoleName": "Viewer",              "State": "Hidden"  }
      ]
    },
    {
      "PageKey": "/widgets",
      "ControlKey": "EditButton",
      "RolePermissions": [
        { "RoleName": "SystemAdministrator", "State": "Enabled" },
        { "RoleName": "Manager",             "State": "Enabled" },
        { "RoleName": "Editor",              "State": "Enabled" },
        { "RoleName": "Viewer",              "State": "Hidden"  }
      ]
    },
    {
      "PageKey": "/widgets",
      "ControlKey": "DeleteButton",
      "RolePermissions": [
        { "RoleName": "SystemAdministrator", "State": "Enabled" },
        { "RoleName": "Manager",             "State": "Enabled" },
        { "RoleName": "Editor",              "State": "Hidden"  },
        { "RoleName": "Viewer",              "State": "Hidden"  }
      ]
    },
    {
      "PageKey": "/widgets",
      "ControlKey": "ExportButton",
      "RolePermissions": [
        { "RoleName": "SystemAdministrator", "State": "Enabled" },
        { "RoleName": "Manager",             "State": "Enabled" },
        { "RoleName": "Editor",              "State": "Enabled" },
        { "RoleName": "Viewer",              "State": "Enabled" }
      ]
    }
  ],
  "RowFilters": [
    {
      "EntityKey": "Widget",
      "RoleName": "Viewer",
      "FilterExpression": "OwnerId == @CurrentUserId",
      "Description": "Viewers see only widgets they own."
    }
  ],
  "RoleSwitching": {
    "AllowedRoles": [ "SystemAdministrator", "UserAdministrator" ]
  }
}
