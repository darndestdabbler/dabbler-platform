FROM mcr.microsoft.com/dotnet/sdk:10.0 AS runner
WORKDIR /src

COPY Directory.Build.props Directory.Packages.props Dabbler.Platform.sln ./
COPY src/Apps/AcmeCoffeeOnline.Api/AcmeCoffeeOnline.Api.csproj src/Apps/AcmeCoffeeOnline.Api/
COPY src/Apps/AcmeCoffeeOnline.Web/AcmeCoffeeOnline.Web.csproj src/Apps/AcmeCoffeeOnline.Web/
COPY tests/AcmeCoffeeOnline.Playwright/AcmeCoffeeOnline.Playwright.csproj tests/AcmeCoffeeOnline.Playwright/

RUN dotnet restore tests/AcmeCoffeeOnline.Playwright/AcmeCoffeeOnline.Playwright.csproj

COPY . .

RUN dotnet build tests/AcmeCoffeeOnline.Playwright/AcmeCoffeeOnline.Playwright.csproj -c Release --no-restore
RUN tests/AcmeCoffeeOnline.Playwright/bin/Release/net10.0/.playwright/node/linux-x64/node \
    tests/AcmeCoffeeOnline.Playwright/bin/Release/net10.0/.playwright/package/cli.js \
    install --with-deps chromium

ENV PLAYWRIGHT_BASE_URL=http://web:8080

ENTRYPOINT ["dotnet", "test", "tests/AcmeCoffeeOnline.Playwright/AcmeCoffeeOnline.Playwright.csproj", "-c", "Release", "--no-build", "--logger", "console;verbosity=normal"]
