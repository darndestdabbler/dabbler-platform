# syntax=docker/dockerfile:1.7
#
# Optional — only needed if you still want to run Playwright tests inside a
# container (e.g. in CI). For local dev, run them from the host instead.
#
# Key differences from the original:
#   1. Base image is mcr.microsoft.com/playwright/dotnet, which ships with the
#      .NET SDK + Chromium + Firefox + WebKit + all their apt dependencies
#      ALREADY installed. That's ~2 GB of work we no longer have to redo on
#      every code change (this was the biggest contributor to image churn).
#   2. The version tag must match the Microsoft.Playwright NuGet package
#      version in Directory.Packages.props. Bump both together.
#   3. BuildKit cache mount on the NuGet folder so `dotnet restore` reuses
#      packages across builds instead of re-downloading them each time.
#   4. `playwright install --with-deps chromium` is gone entirely — browsers
#      are pre-installed in the base image.

FROM mcr.microsoft.com/playwright/dotnet:v1.50.0-jammy AS runner
WORKDIR /src

# ---- Restore layer (invalidated only when csproj / props files change) ------
COPY Directory.Build.props Directory.Packages.props Dabbler.Platform.sln ./
COPY src/Apps/AcmeCoffeeOnline.Api/AcmeCoffeeOnline.Api.csproj       src/Apps/AcmeCoffeeOnline.Api/
COPY src/Apps/AcmeCoffeeOnline.Web/AcmeCoffeeOnline.Web.csproj       src/Apps/AcmeCoffeeOnline.Web/
COPY tests/AcmeCoffeeOnline.Playwright/AcmeCoffeeOnline.Playwright.csproj tests/AcmeCoffeeOnline.Playwright/

RUN --mount=type=cache,target=/root/.nuget/packages \
    dotnet restore tests/AcmeCoffeeOnline.Playwright/AcmeCoffeeOnline.Playwright.csproj

# ---- Source + build layer (invalidated on any source change) ----------------
# Everything above this line is cached unless a project file changes, so the
# expensive steps (base image pull, NuGet restore) don't re-run for code edits.
COPY . .

RUN --mount=type=cache,target=/root/.nuget/packages \
    dotnet build tests/AcmeCoffeeOnline.Playwright/AcmeCoffeeOnline.Playwright.csproj \
        -c Release --no-restore

ENV PLAYWRIGHT_BASE_URL=http://web:8080

ENTRYPOINT ["dotnet", "test", \
    "tests/AcmeCoffeeOnline.Playwright/AcmeCoffeeOnline.Playwright.csproj", \
    "-c", "Release", "--no-build", \
    "--logger", "console;verbosity=normal"]