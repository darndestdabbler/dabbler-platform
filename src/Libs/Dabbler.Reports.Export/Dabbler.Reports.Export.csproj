<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- NuGet package metadata -->
    <PackageId>Dabbler.Reports.Export</PackageId>
    <Description>PDF export for Dabbler Reports: renders composed report pages to PDF documents using the DabblerPdf library.</Description>
    <PackageTags>blazor;reports;pdf;export;pdf-generation</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591 suppression removed — all public members must have XML docs -->
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Dabbler.Components.Tests" />
  </ItemGroup>

  <!-- Development: use ProjectReference for inner-loop builds -->
  <ItemGroup Condition="'$(PackAsDependency)' != 'true'">
    <ProjectReference Include="..\Dabbler.Reports.Core\Dabbler.Reports.Core.csproj" />
  </ItemGroup>

  <!-- NuGet pack: use PackageReference so consumers resolve via NuGet -->
  <ItemGroup Condition="'$(PackAsDependency)' == 'true'">
    <PackageReference Include="Dabbler.Reports.Core" Version="$(DabblerVersion)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DabblerPdf" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
