<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageId>Dabbler.Platform.Stubs.Reports</PackageId>
    <Description>Stub report-data, artifact-catalog, and usage-tracking providers for Dabbler.Reports.Core and Dabbler.Components consumers. Carries a transitive dependency on DabblerPdf (LGPL-2.1-only OR MPL-2.0) via Dabbler.Reports.Core.</Description>
    <PackageTags>blazor;stubs;testing;bunit;reports;dabbler-reports</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dabbler.Reports.Core\Dabbler.Reports.Core.csproj" />
    <ProjectReference Include="..\Dabbler.Components\Dabbler.Components.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
