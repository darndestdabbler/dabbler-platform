@page "/login/mfa"
@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Routing
@using MudBlazor
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar

<PageTitle>Two-Factor Authentication</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-16">
    <MudPaper Elevation="3" Class="pa-8">
        <MudText Typo="Typo.h1" Align="Align.Center" Class="mb-6">Two-Factor Authentication</MudText>
        <div class="visually-hidden" role="status" aria-live="polite" aria-atomic="true">@_statusMessage</div>
        <div class="visually-hidden" role="alert" aria-live="assertive" aria-atomic="true">@_errorMessage</div>

        <MudText Typo="Typo.body1" Class="mb-4">
            Enter the 6-digit code from your authenticator app.
        </MudText>

        <EditForm Model="@_model" OnValidSubmit="VerifyTotp">
            <DataAnnotationsValidator />
            
            <MudTextField @bind-Value="_model.Code" 
                          Label="Authenticator Code" 
                          Variant="Variant.Outlined" 
                          MaxLength="6"
                          For="@(() => _model.Code)"
                          Class="mb-4" />
                          
            <MudButton ButtonType="ButtonType.Submit" 
                       Variant="Variant.Filled" 
                       Color="Color.Primary" 
                       FullWidth="true" 
                       Disabled="@_isProcessing">
                @if (_isProcessing)
                {
                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                    <MudText Class="ms-2">Verifying...</MudText>
                }
                else
                {
                    <MudText>Verify</MudText>
                }
            </MudButton>
        </EditForm>
    </MudPaper>
</MudContainer>

@code {
    /// <summary>
    /// Handles the second factor of authentication (MFA/TOTP) for users who have successfully
    /// completed the first step of login but require additional verification.
    /// </summary>
    [System.Diagnostics.CodeAnalysis.SuppressMessage("AsyncUsage", "AsyncFixer03:Fire-and-forget async-void methods or delegates", Justification = "Blazor component lifecycle method.")]
    private bool _isProcessing;
    private string _statusMessage = string.Empty;
    private string _errorMessage = string.Empty;
    private TotpModel _model = new();

    /// <summary>
    /// Gets or sets the ID of the user attempting to complete MFA. This is required and supplied from the query string.
    /// </summary>
    [SupplyParameterFromQuery]
    public int UserId { get; set; }

    /// <summary>
    /// Gets or sets the URL to redirect to after successful MFA verification. Supplied from the query string.
    /// </summary>
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    /// <summary>
    /// Initializes the component. Redirects to the main login page if the required <see cref="UserId"/> is not provided.
    /// </summary>
    protected override void OnInitialized()
    {
        if (UserId <= 0)
        {
            NavigationManager.NavigateTo("/login");
        }
    }

    private static bool IsLocalUrl(string? url)
    {
        if (string.IsNullOrEmpty(url)) return false;
        return url.StartsWith("/") && !url.StartsWith("//") && !url.StartsWith("/\\");
    }

    private string SafeReturnUrl => IsLocalUrl(ReturnUrl) ? ReturnUrl! : "/";

    private async Task VerifyTotp()
    {
        _isProcessing = true;
        try
        {
            var response = await Http.PostAsJsonAsync("/auth/verify-totp", new
            {
                UserId = UserId,
                Code = _model.Code
            });

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<VerifyTotpResult>();
                if (!string.IsNullOrWhiteSpace(result?.ExchangeToken))
                {
                    _statusMessage = "Verification succeeded. Signing you in now.";
                    _errorMessage = string.Empty;
                    var dest = $"/auth/complete?token={Uri.EscapeDataString(result.ExchangeToken)}&returnUrl={Uri.EscapeDataString(SafeReturnUrl)}";
                    NavigationManager.NavigateTo(dest, forceLoad: true);
                }
                else
                {
                    _statusMessage = "Verification succeeded. Redirecting now.";
                    _errorMessage = string.Empty;
                    NavigationManager.NavigateTo(SafeReturnUrl, forceLoad: true);
                }
            }
            else
            {
                Announce("Verification failed. Please check your code and try again.", Severity.Error);
            }
        }
        catch
        {
            Announce("An unexpected error occurred. Please try again.", Severity.Error);
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private void Announce(string message, Severity severity)
    {
        Snackbar.Add(message, severity);

        if (severity == Severity.Error)
        {
            _errorMessage = message;
            _statusMessage = string.Empty;
            return;
        }

        _statusMessage = message;
        _errorMessage = string.Empty;
    }

    /// <summary>
    /// Represents the data model for the TOTP code submission form.
    /// </summary>
    public class TotpModel
    {
        /// <summary>
        /// Gets or sets the 6-digit TOTP code from the user's authenticator app.
        /// </summary>
        [Required]
        [StringLength(6, MinimumLength = 6)]
        public string Code { get; set; } = string.Empty;
    }

    /// <summary>
    /// Represents the result of a TOTP verification attempt from the backend API.
    /// </summary>
    public class VerifyTotpResult
    {
        /// <summary>
        /// Gets or sets a value indicating whether the TOTP verification was successful.
        /// </summary>
        public bool Success { get; set; }
        /// <summary>
        /// Gets or sets a short-lived token used to complete the sign-in flow,
        /// primarily for Blazor Server to establish a cookie-based session.
        /// </summary>
        public string? ExchangeToken { get; set; }
    }
}
