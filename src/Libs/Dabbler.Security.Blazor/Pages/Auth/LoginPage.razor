@page "/login"
@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Json
@using Dabbler.Security.Options
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.Extensions.Options
@using MudBlazor
@inject HttpClient Http
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IOptions<DabblerSecurityOptions> SecurityOptions

<PageTitle>Sign In</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-16">
    <MudPaper Elevation="3" Class="pa-8">
        <MudText Typo="Typo.h1" Align="Align.Center" Class="mb-6">Sign In</MudText>
        <div class="visually-hidden" role="status" aria-live="polite" aria-atomic="true">@_statusMessage</div>
        <div class="visually-hidden" role="alert" aria-live="assertive" aria-atomic="true">@_errorMessage</div>

        @if ((_oidcProviders.Count > 0 || _oauthProviders.Count > 0) && !_codeSent)
        {
            @foreach (var provider in _oidcProviders)
            {
                <MudButton Variant="Variant.Filled"
                           Color="Color.Dark"
                           FullWidth="true"
                           StartIcon="@Icons.Material.Filled.Business"
                           Class="mb-2"
                           data-testid="@($"external-provider-{provider.AuthenticationScheme}")"
                           data-provider="@provider.AuthenticationScheme"
                           OnClick="@(() => ChallengeExternalProvider(provider))">
                    @provider.DisplayName
                </MudButton>
            }

            @foreach (var provider in _oauthProviders)
            {
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Dark"
                           FullWidth="true"
                           StartIcon="@Icons.Material.Filled.Login"
                           Class="mb-2"
                           data-testid="@($"external-provider-{provider.AuthenticationScheme}")"
                           data-provider="@provider.AuthenticationScheme"
                           OnClick="@(() => ChallengeExternalProvider(provider))">
                    @provider.DisplayName
                </MudButton>
            }

            <MudDivider Class="my-6" data-testid="login-auth-divider" />
            <MudText Typo="Typo.body2" Align="Align.Center" Class="mb-4" Style="color: var(--mud-palette-text-secondary);">
                or sign in with email
            </MudText>
        }

        @if (!_codeSent)
        {
            <EditForm Model="@_emailModel" OnValidSubmit="RequestMagicLink">
                <DataAnnotationsValidator />

                <MudTextField @bind-Value="_emailModel.Email"
                              Label="Email Address"
                              Variant="Variant.Outlined"
                              InputType="InputType.Email"
                              For="@(() => _emailModel.Email)"
                              data-testid="magic-link-email-input"
                              Class="mb-4" />

                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           data-testid="magic-link-send-button"
                           Disabled="@_isProcessing">
                    @if (_isProcessing)
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                        <MudText Class="ms-2">Sending...</MudText>
                    }
                    else
                    {
                        <MudText>Send Login Link</MudText>
                    }
                </MudButton>
            </EditForm>
        }
        else
        {
            <MudText Typo="Typo.body1" Class="mb-4">
                We've sent a login link to <strong>@_emailModel.Email</strong>. 
                Click the link in the email, or enter the 6-digit code below.
            </MudText>

            <EditForm Model="@_codeModel" OnValidSubmit="VerifyCode">
                <DataAnnotationsValidator />
                
                <MudTextField @bind-Value="_codeModel.Code" 
                              Label="6-Digit Code" 
                              Variant="Variant.Outlined" 
                              MaxLength="6"
                              For="@(() => _codeModel.Code)"
                              Class="mb-4" />
                              
                <MudButton ButtonType="ButtonType.Submit" 
                           Variant="Variant.Filled" 
                           Color="Color.Primary" 
                           FullWidth="true" 
                           Disabled="@_isProcessing">
                    @if (_isProcessing)
                    {
                        <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                        <MudText Class="ms-2">Verifying...</MudText>
                    }
                    else
                    {
                        <MudText>Verify Code</MudText>
                    }
                </MudButton>
                
                <MudButton Variant="Variant.Text" 
                           Color="Color.Secondary" 
                           FullWidth="true" 
                           Class="mt-2"
                           OnClick="() => _codeSent = false">
                    Use a different email
                </MudButton>
            </EditForm>
        }
    </MudPaper>
</MudContainer>

@code {
    /// <summary>
    /// Handles user sign-in via magic link (email/code) or external identity providers (OIDC/OAuth).
    /// </summary>
    [System.Diagnostics.CodeAnalysis.SuppressMessage("AsyncUsage", "AsyncFixer03:Fire-and-forget async-void methods or delegates", Justification = "Blazor component lifecycle method.")]
    private bool _codeSent;
    private bool _isProcessing;
    private string _statusMessage = string.Empty;
    private string _errorMessage = string.Empty;
    private EmailModel _emailModel = new();
    private CodeModel _codeModel = new();
    private IReadOnlyList<ExternalProviderDisplayInfo> _oidcProviders = [];
    private IReadOnlyList<ExternalProviderDisplayInfo> _oauthProviders = [];

    /// <summary>
    /// Gets or sets the URL to redirect to after a successful login. Supplied from the query string.
    /// </summary>
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    /// <summary>
    /// Gets or sets a one-time token from a magic link used to complete the login process. Supplied from the query string.
    /// </summary>
    [SupplyParameterFromQuery]
    public string? Token { get; set; }

    private string SafeReturnUrl => IsLocalUrl(ReturnUrl) ? ReturnUrl! : "/";

    private static bool IsLocalUrl(string? url)
    {
        if (string.IsNullOrEmpty(url)) return false;
        return url.StartsWith("/") && !url.StartsWith("//") && !url.StartsWith("/\\");
    }

    /// <summary>
    /// Initializes the component by loading available external authentication providers
    /// and attempting to verify a login token if one is present in the URL.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        var providers = SecurityOptions.Value.GetConfiguredProviders();
        _oidcProviders = providers.Where(p => p.IsOidc).ToList();
        _oauthProviders = providers.Where(p => !p.IsOidc).ToList();

        if (!string.IsNullOrEmpty(Token))
        {
            await VerifyTokenAsync(Token);
        }
    }

    private void ChallengeExternalProvider(ExternalProviderDisplayInfo provider)
    {
        var returnUrl = Uri.EscapeDataString(SafeReturnUrl);
        NavigationManager.NavigateTo(
            $"/auth/challenge/{provider.AuthenticationScheme}?returnUrl={returnUrl}",
            forceLoad: true);
    }

    private async Task RequestMagicLink()
    {
        _isProcessing = true;
        try
        {
            var baseUri = NavigationManager.BaseUri;
            var verifyUrl = $"{baseUri}login";
            
            var response = await Http.PostAsJsonAsync("/auth/send-magic-link", new 
            { 
                Email = _emailModel.Email,
                BaseVerifyUrl = verifyUrl
            });

            if (response.IsSuccessStatusCode)
            {
                _codeSent = true;
                Announce("Login link sent! Check your email.", Severity.Success);
            }
            else
            {
                Announce("Failed to send login link. Please try again.", Severity.Error);
            }
        }
        catch
        {
            Announce("An unexpected error occurred. Please try again.", Severity.Error);
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private async Task VerifyCode()
    {
        _isProcessing = true;
        try
        {
            var response = await Http.PostAsJsonAsync("/auth/verify", new 
            { 
                Email = _emailModel.Email,
                Code = _codeModel.Code
            });

            await HandleVerifyResponse(response);
        }
        catch
        {
            Announce("An unexpected error occurred. Please try again.", Severity.Error);
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private async Task VerifyTokenAsync(string token)
    {
        _isProcessing = true;
        try
        {
            var response = await Http.PostAsJsonAsync("/auth/verify", new 
            { 
                Token = token
            });

            await HandleVerifyResponse(response);
        }
        catch
        {
            Announce("An unexpected error occurred. Please try again.", Severity.Error);
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private async Task HandleVerifyResponse(HttpResponseMessage response)
    {
        if (response.IsSuccessStatusCode)
        {
            var result = await response.Content.ReadFromJsonAsync<VerifyResult>();
            if (result != null && result.RequiresMfa)
            {
                NavigationManager.NavigateTo($"/login/mfa?userId={result.UserId}&returnUrl={Uri.EscapeDataString(SafeReturnUrl)}");
            }
            else if (result?.ExchangeToken is not null)
            {
                // Blazor Server: the HttpClient call is server-to-server so Set-Cookie from
                // /auth/verify never reaches the browser. Navigate to /auth/complete (a real
                // browser GET) which sets the cookie and redirects to the return URL.
                var dest = $"/auth/complete?token={Uri.EscapeDataString(result.ExchangeToken)}&returnUrl={Uri.EscapeDataString(SafeReturnUrl)}";
                NavigationManager.NavigateTo(dest, forceLoad: true);
            }
            else
            {
                NavigationManager.NavigateTo(SafeReturnUrl, forceLoad: true);
            }
        }
        else
        {
            Announce("Verification failed. Please check your code and try again.", Severity.Error);
        }
    }

    private void Announce(string message, Severity severity)
    {
        Snackbar.Add(message, severity);

        if (severity == Severity.Error)
        {
            _errorMessage = message;
            _statusMessage = string.Empty;
            return;
        }

        _statusMessage = message;
        _errorMessage = string.Empty;
    }

    /// <summary>
    /// Represents the data model for the email submission form.
    /// </summary>
    public class EmailModel
    {
        /// <summary>
        /// Gets or sets the user's email address.
        /// </summary>
        [Required]
        [EmailAddress]
        public string Email { get; set; } = string.Empty;
    }

    /// <summary>
    /// Represents the data model for the 6-digit code submission form.
    /// </summary>
    public class CodeModel
    {
        /// <summary>
        /// Gets or sets the 6-digit verification code sent to the user's email.
        /// </summary>
        [Required]
        [StringLength(6, MinimumLength = 6)]
        public string Code { get; set; } = string.Empty;
    }

    /// <summary>
    /// Represents the result of a verification attempt from the backend API.
    /// </summary>
    public class VerifyResult
    {
        /// <summary>
        /// Gets or sets a value indicating whether the user must complete a second factor of authentication.
        /// </summary>
        public bool RequiresMfa { get; set; }
        /// <summary>
        /// Gets or sets the user's ID, provided when MFA is required.
        /// </summary>
        public int? UserId { get; set; }
        /// <summary>
        /// Gets or sets a value indicating whether the overall verification process was successful.
        /// </summary>
        public bool Success { get; set; }
        /// <summary>
        /// Gets or sets a short-lived token used to complete the sign-in flow,
        /// primarily for Blazor Server to establish a cookie-based session.
        /// </summary>
        public string? ExchangeToken { get; set; }
    }
}
