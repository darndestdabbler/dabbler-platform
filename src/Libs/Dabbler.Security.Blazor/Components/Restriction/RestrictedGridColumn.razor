@using Dabbler.Security.Services
@namespace Dabbler.Security.Blazor.Components.Restriction
@inject IRestrictionBinder Binder
@inject AuthorizationStateNotifier Notifier
@* IFieldMaskService injected here so grid-column consumers can render masked cell values
   without needing a separate @inject in each consumer. Session Set D wires the CellTemplate. *@
@inject IFieldMaskService FieldMaskService
@implements IDisposable

@if (_resolved.Visibility == ColumnVisibility.Hidden)
{
    @* Hidden: emit no column. MudDataGrid registers only columns that render,
       so a column gated to Hidden simply disappears from the grid layout. *@
}
else
{
    @ChildContent?.Invoke(_resolved)
}

@code {
    /// <summary>
    /// Wraps a single MudDataGrid column definition and applies the active
    /// user's restrictions for the given (EntityKey, ColumnKey) tuple. The
    /// wrapper resolves through <see cref="IRestrictionBinder"/> on
    /// initialise and on every <see cref="AuthorizationStateNotifier"/>
    /// notification.
    /// </summary>
    /// <remarks>
    /// <para>
    /// Render contract:
    /// </para>
    /// <list type="bullet">
    ///   <item><c>Hidden</c> → emits no column. MudDataGrid registers only
    ///   columns that actually render, so the column disappears from the
    ///   grid header and from every row.</item>
    ///   <item>Otherwise → invokes <see cref="ChildContent"/> with the
    ///   resolved <see cref="RestrictionResolution"/>. The consumer wires
    ///   <c>IsEditable</c> / <c>Editable</c> from
    ///   <c>state.Editability</c>, and (for masked columns) a
    ///   <c>CellTemplate</c> that renders through the Set D hook based on
    ///   <c>state.IsMasked</c> / <c>state.MaskFormat</c>.</item>
    /// </list>
    /// <para>
    /// Symmetry with <see cref="RestrictedFormField"/>: the form-field
    /// wrapper auto-renders a <c>********</c> placeholder for masked
    /// fields because a single field has a single rendering surface; a
    /// grid column has N cells and the rendering must happen per-row, so
    /// the consumer keeps that wiring on the column itself.
    /// </para>
    /// </remarks>

    /// <summary>The entity (table) key the wrapped column binds to. Required.</summary>
    [Parameter, EditorRequired] public string EntityKey { get; set; } = string.Empty;

    /// <summary>The column (field) key the wrapped column binds to. Required.</summary>
    [Parameter, EditorRequired] public string ColumnKey { get; set; } = string.Empty;

    /// <summary>
    /// Optional entity instance identifier used for column-level
    /// (non-cell-keyed) audit emission when the wrapper is rendered for a
    /// single entity surface. The grid itself renders one column wrapper
    /// across many rows — per-cell <c>FieldUnmaskedRead</c> emission is the
    /// consumer's responsibility through <see cref="ChildContent"/>'s
    /// <c>CellTemplate</c>, which knows the row's identifier and can call
    /// <see cref="IRestrictionBinder.ResolveAsync(string, string, string?)"/>
    /// directly. This parameter exists so callers using the wrapper for a
    /// single entity (e.g., a key-value details view rendered as a grid)
    /// can opt into batched audit rows symmetrically with
    /// <see cref="RestrictedFormField"/>.
    /// </summary>
    [Parameter] public string? EntityId { get; set; }

    /// <summary>
    /// The column template. Receives the resolved <see cref="RestrictionResolution"/>
    /// so the consumer can wire <c>IsEditable</c>, <c>CellTemplate</c>, or
    /// any other column property from the state.
    /// </summary>
    [Parameter] public RenderFragment<RestrictionResolution>? ChildContent { get; set; }

    private RestrictionResolution _resolved =
        RestrictionResolution.Unrestricted(string.Empty, string.Empty);

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        Notifier.Subscribe(OnConfigChangedAsync);
        await ResolveAsync();
    }

    private string? _lastResolvedEntityId;

    /// <inheritdoc />
    protected override async Task OnParametersSetAsync()
    {
        if (!string.Equals(_resolved.EntityKey, EntityKey, StringComparison.OrdinalIgnoreCase)
            || !string.Equals(_resolved.ColumnKey, ColumnKey, StringComparison.OrdinalIgnoreCase)
            || !string.Equals(_lastResolvedEntityId, EntityId, StringComparison.Ordinal))
        {
            await ResolveAsync();
        }
    }

    private async Task ResolveAsync()
    {
        _resolved = await Binder.ResolveAsync(EntityKey, ColumnKey, EntityId);
        _lastResolvedEntityId = EntityId;
    }

    private async Task OnConfigChangedAsync(AuthorizationConfigurationChanged _)
    {
        await ResolveAsync();
        await InvokeAsync(StateHasChanged);
    }

    /// <inheritdoc />
    public void Dispose() => Notifier.Unsubscribe(OnConfigChangedAsync);
}
