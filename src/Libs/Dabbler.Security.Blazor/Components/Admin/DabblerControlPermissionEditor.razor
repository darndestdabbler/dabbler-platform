@using Dabbler.Security.Configuration
@using Dabbler.Security.Registration
@using Dabbler.Security.Services
@using MudBlazor
@inject SecurityConfigurationManager ConfigManager
@inject ResourceRegistry Registry
@inject AuthorizationStateNotifier Notifier
@inject ISnackbar Snackbar
@implements IDisposable

@{
    var controls = Registry.Controls
        .Where(c => string.Equals(c.PageKey, PageKey, StringComparison.OrdinalIgnoreCase))
        .ToList();
}

<MudPaper Elevation="2" Class="pa-4">
    <div class="d-flex align-center justify-space-between mb-3">
        <MudText Typo="Typo.h6">Control Permissions — @PageKey</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="SaveAsync">Save</MudButton>
    </div>

    @if (controls.Count == 0)
    {
        <MudText Class="pa-4">No controls registered for page "@PageKey". Register controls via options.RegisterControls() at startup.</MudText>
    }
    else if (_roles.Count == 0)
    {
        <MudText Class="pa-4">No roles defined. Add roles in Role Management first.</MudText>
    }
    else
    {
        <div style="overflow-x:auto;">
            <MudSimpleTable Dense="true" Hover="true" Style="background:transparent;"
                            aria-label="@($"Control permissions for {PageKey}")">
                <thead>
                    <tr>
                        <th style="min-width:160px;">Control</th>
                        @foreach (var role in _roles)
                        {
                            <th style="text-align:center;min-width:130px;">@role</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var control in controls)
                    {
                        <tr>
                            <td>
                                <MudText Typo="Typo.subtitle2">@control.DisplayName</MudText>
                                <MudText Typo="Typo.caption">@control.Key</MudText>
                            </td>
                            @foreach (var role in _roles)
                            {
                                <td style="text-align:center;">
                                    <MudSelect T="ControlState"
                                               Value="@GetState(role, control.Key)"
                                               ValueChanged="@(v => SetState(role, control.Key, v))"
                                               aria-label="@($"{control.DisplayName} permission for {role}")"
                                               Margin="Margin.Dense"
                                               Variant="Variant.Outlined">
                                        <MudSelectItem Value="ControlState.Enabled">
                                            <span class="d-inline-flex align-center gap-2">
                                                <img src="_content/Dabbler.Security.Blazor/enabled.svg"
                                                     alt=""
                                                     aria-hidden="true"
                                                     style="width:18px;height:18px;" />
                                                <span>Enabled</span>
                                            </span>
                                        </MudSelectItem>
                                        <MudSelectItem Value="ControlState.Disabled">
                                            <span class="d-inline-flex align-center gap-2">
                                                <img src="_content/Dabbler.Security.Blazor/disabled.svg"
                                                     alt=""
                                                     aria-hidden="true"
                                                     style="width:18px;height:18px;" />
                                                <span>Disabled</span>
                                            </span>
                                        </MudSelectItem>
                                        <MudSelectItem Value="ControlState.Hidden">
                                            <span class="d-inline-flex align-center gap-2">
                                                <img src="_content/Dabbler.Security.Blazor/hidden.svg"
                                                     alt=""
                                                     aria-hidden="true"
                                                     style="width:18px;height:18px;" />
                                                <span>Hidden</span>
                                            </span>
                                        </MudSelectItem>
                                    </MudSelect>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </div>
    }
</MudPaper>

@code {
    /// <summary>
    /// A user interface for editing UI control permissions for a single page across all defined roles.
    /// It displays a matrix of registered controls for the specified <see cref="PageKey"/> against roles,
    /// allowing the selection of <see cref="ControlState.Enabled"/>, <see cref="ControlState.Disabled"/>,
    /// or <see cref="ControlState.Hidden"/>.
    /// </summary>

    /// <summary>
    /// Gets or sets the unique key for the page whose control permissions are to be edited.
    /// This parameter is required.
    /// </summary>
    [Parameter, EditorRequired] public string PageKey { get; set; } = string.Empty;

    private List<string> _roles = [];

    // (roleName, controlKey) → ControlState
    private readonly Dictionary<(string role, string control), ControlState> _states = new();

    protected override void OnInitialized()
    {
        Notifier.Subscribe(OnConfigChangedAsync);
    }

    protected override async Task OnParametersSetAsync()
    {
        await ConfigManager.EnsureLoadedAsync();
        LoadFromConfig();
    }

    private void LoadFromConfig()
    {
        var config = ConfigManager.Current;
        _roles = config.Roles.Select(r => r.RoleName).ToList();
        _states.Clear();

        foreach (var cp in config.ControlPermissions.Where(c =>
            string.Equals(c.PageKey, PageKey, StringComparison.OrdinalIgnoreCase)))
        {
            foreach (var rp in cp.RolePermissions)
                _states[(rp.RoleName, cp.ControlKey)] = rp.State;
        }
    }

    private async Task OnConfigChangedAsync(AuthorizationConfigurationChanged _)
    {
        LoadFromConfig();
        await InvokeAsync(StateHasChanged);
    }

    private ControlState GetState(string role, string controlKey)
    {
        var key = (role, controlKey);
        return _states.TryGetValue(key, out var state) ? state : ControlState.Enabled;
    }

    private void SetState(string role, string controlKey, ControlState state)
        => _states[(role, controlKey)] = state;

    private async Task SaveAsync()
    {
        var config = ConfigManager.Current;
        var controls = Registry.Controls
            .Where(c => string.Equals(c.PageKey, PageKey, StringComparison.OrdinalIgnoreCase))
            .ToList();

        // Keep control permissions for other pages; rebuild this page's entries
        var otherPages = config.ControlPermissions
            .Where(c => !string.Equals(c.PageKey, PageKey, StringComparison.OrdinalIgnoreCase))
            .ToList();

        var thisPagePerms = controls.Select(control => new ControlPermission
        {
            PageKey = PageKey,
            ControlKey = control.Key,
            RolePermissions = _roles.Select(role => new ControlRolePermission
            {
                RoleName = role,
                State = GetState(role, control.Key)
            }).ToList()
        }).ToList();

        var updated = new SecurityConfiguration
        {
            Roles = config.Roles,
            PagePermissions = config.PagePermissions,
            EntityPermissions = config.EntityPermissions,
            FieldPermissions = config.FieldPermissions,
            EndpointPermissions = config.EndpointPermissions,
            ControlPermissions = [.. otherPages, .. thisPagePerms],
            RowFilters = config.RowFilters,
            RoleSwitching = config.RoleSwitching
        };

        await ConfigManager.SaveAsync(updated);
        Snackbar.Add($"Control permissions for '{PageKey}' saved.", Severity.Success);
    }

    public void Dispose() => Notifier.Unsubscribe(OnConfigChangedAsync);
}
