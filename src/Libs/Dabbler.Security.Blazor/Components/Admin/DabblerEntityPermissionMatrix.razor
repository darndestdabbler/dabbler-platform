@using Dabbler.Security.Abstractions
@using Dabbler.Security.Authorization
@using Dabbler.Security.Configuration
@using Dabbler.Security.Registration
@using Dabbler.Security.Services
@using MudBlazor
@inject SecurityConfigurationManager ConfigManager
@inject ResourceRegistry Registry
@inject AuthorizationStateNotifier Notifier
@inject ISnackbar Snackbar
@implements IDisposable

<MudPaper Elevation="3" Class="pa-4">
    <div class="d-flex align-center justify-space-between mb-4">
        <MudText Typo="Typo.h6">Entity Permissions</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="SaveAsync">Save All</MudButton>
    </div>

    @if (_roles.Count == 0)
    {
        <MudText Class="pa-4">No roles defined. Add roles in Role Management first.</MudText>
    }
    else if (Registry.Entities.Count == 0)
    {
        <MudText Class="pa-4">No entities registered. Register entities via options.RegisterEntities() at startup.</MudText>
    }
    else
    {
        <InheritedLegend />

        <MudTextField @bind-Value="_filter"
                      Placeholder="Filter entities…"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Clearable="true"
                      Variant="Variant.Outlined"
                      Immediate="true"
                      Class="mb-4" />

        <div style="display:flex; flex-wrap:wrap; gap:16px; align-items:flex-start;">
        @foreach (var entity in Registry.Entities.Where(e => MatchesFilter(e.Key, e.DisplayName)))
        {
            <MudCard Elevation="1" Style="min-width:340px; flex:1 1 340px; max-width:600px;">
                <MudCardHeader>
                    <CardHeaderContent>
                        <div class="d-flex align-center gap-2">
                            <MudText Typo="Typo.subtitle1"><b>@entity.DisplayName</b></MudText>
                            @if (entity.Fields.Count > 0)
                            {
                                <MudTooltip Text="@($"Field permissions for {entity.DisplayName}")">
                                    <MudIconButton Icon="@Icons.Material.Filled.TableChart"
                                                   Size="Size.Small"
                                                   Color="@(_drillDownEntity == entity.Key ? Color.Primary : Color.Default)"
                                                   OnClick="@(() => ShowFieldEditor(entity.Key))"
                                                   title="@($"Edit field permissions for {entity.DisplayName}")"
                                                   aria-label="@($"Edit field permissions for {entity.DisplayName}")" />
                                </MudTooltip>
                            }
                        </div>
                        <MudText Typo="Typo.caption">@entity.Key</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent Class="pt-0">
                    <MudSimpleTable Dense="true" Hover="true" Style="background:transparent; width:100%;"
                                    aria-label="@($"Entity permissions for {entity.DisplayName}")">
                        <thead>
                            <tr>
                                <th style="min-width:140px;">Role</th>
                                @foreach (var op in _crudOps)
                                {
                                    <th style="text-align:center; width:1%; white-space:nowrap; padding-left:2px; padding-right:2px;">
                                        <img src="@($"_content/Dabbler.Security.Blazor/{op.ToLowerInvariant()}-header.svg")"
                                             alt="@op"
                                             title="@op"
                                             aria-label="@op"
                                             style="height:48px; display:inline-block;" />
                                    </th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var role in _roles)
                            {
                                <tr>
                                    <td>
                                        <MudText Typo="Typo.body2">@role</MudText>
                                    </td>
                                    @foreach (var op in _crudOps)
                                    {
                                        var resolution = ResolveCell(role, entity.Key, op);
                                        var isInherited = resolution.InheritedFromRole is not null;
                                        var cellClass = isInherited ? "permission-cell inherited" : "permission-cell";
                                        var tooltipText = isInherited ? $"inherited from {resolution.InheritedFromRole}" : string.Empty;
                                        <td style="text-align:center; padding-left:2px; padding-right:2px;">
                                            @if (isInherited)
                                            {
                                                <MudTooltip Text="@tooltipText">
                                                    <div class="@cellClass">
                                                        <MudCheckBox T="bool"
                                                                     Value="@resolution.HasOp"
                                                                     ValueChanged="@(v => SetOp(role, entity.Key, op, v))"
                                                                     aria-label="@($"{op} permission for {role} on {entity.DisplayName} ({tooltipText})")"
                                                                     Color="@OpColor(op)"
                                                                     Size="Size.Small"
                                                                     Class="ma-0 pa-0 d-inline-flex" />
                                                    </div>
                                                </MudTooltip>
                                            }
                                            else
                                            {
                                                <div class="@cellClass">
                                                    <MudCheckBox T="bool"
                                                                 Value="@resolution.HasOp"
                                                                 ValueChanged="@(v => SetOp(role, entity.Key, op, v))"
                                                                 aria-label="@($"{op} permission for {role} on {entity.DisplayName}")"
                                                                 Color="@OpColor(op)"
                                                                 Size="Size.Small"
                                                                 Class="ma-0 pa-0 d-inline-flex" />
                                                </div>
                                            }
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>

                    @if (_drillDownEntity == entity.Key)
                    {
                        <MudDivider Class="mt-3 mb-3" />
                        <DabblerFieldPermissionEditor EntityKey="@entity.Key" />
                    }
                </MudCardContent>
            </MudCard>
        }
        </div>

        <MudText Typo="Typo.caption" Class="mt-2">
            Column icons: <b>Create</b>, <b>Read</b>, <b>Update</b>, <b>Delete</b>. Hover or use assistive tech to read each header label.
        </MudText>
    }
</MudPaper>

<style>
    .permission-cell.inherited {
        font-style: italic;
        opacity: 0.6;
    }
</style>

@code {
    /// <summary>
    /// A user interface for managing entity-level CRUD (Create, Read, Update, Delete) permissions
    /// for all registered entities across all defined roles.
    /// It displays a filterable list of cards, each representing an entity with a permission matrix.
    /// It also provides a drill-down to edit field-level permissions using the <see cref="DabblerFieldPermissionEditor"/> component.
    /// Cells whose effective op comes from a parent role are rendered italic/dim with an
    /// "inherited from &lt;parent&gt;" tooltip.
    /// </summary>

    private static readonly string[] _crudOps = ["Create", "Read", "Update", "Delete"];

    private List<string> _roles = [];
    private List<RoleDefinition> _roleDefs = [];
    private string _filter = string.Empty;

    // (roleName, entityKey) → set of allowed operations
    private readonly Dictionary<(string role, string entity), HashSet<string>> _ops = new();

    private string? _drillDownEntity;

    protected override async Task OnInitializedAsync()
    {
        await ConfigManager.EnsureLoadedAsync();
        LoadFromConfig();
        Notifier.Subscribe(OnConfigChangedAsync);
    }

    private void LoadFromConfig()
    {
        var config = ConfigManager.Current;
        _roleDefs = config.Roles.ToList();
        _roles = _roleDefs.Select(r => r.RoleName).ToList();

        _ops.Clear();
        foreach (var ep in config.EntityPermissions)
        {
            foreach (var rp in ep.RolePermissions)
            {
                var key = (rp.RoleName, ep.EntityKey);
                _ops[key] = new HashSet<string>(rp.AllowedOperations, StringComparer.OrdinalIgnoreCase);
            }
        }
    }

    private async Task OnConfigChangedAsync(AuthorizationConfigurationChanged _)
    {
        LoadFromConfig();
        await InvokeAsync(StateHasChanged);
    }

    private bool MatchesFilter(string key, string displayName) =>
        string.IsNullOrEmpty(_filter) ||
        key.Contains(_filter, StringComparison.OrdinalIgnoreCase) ||
        displayName.Contains(_filter, StringComparison.OrdinalIgnoreCase);

    private readonly record struct CellResolution(bool HasOp, string? InheritedFromRole);

    private CellResolution ResolveCell(string role, string entityKey, string op)
    {
        var chain = PermissionResolver.ResolveRoleChain(
            role,
            r => _ops.TryGetValue((r, entityKey), out var ops) && ops.Contains(op),
            _roleDefs);

        return new CellResolution(chain.Found, chain.InheritedFromRole);
    }

    private void SetOp(string role, string entity, string op, bool value)
    {
        var key = (role, entity);
        if (!_ops.ContainsKey(key)) _ops[key] = [];
        if (value) _ops[key].Add(op);
        else _ops[key].Remove(op);
    }

    private void ShowFieldEditor(string entityKey) =>
        _drillDownEntity = _drillDownEntity == entityKey ? null : entityKey;

    private async Task SaveAsync()
    {
        var config = ConfigManager.Current;
        var entityKeys = Registry.Entities.Select(e => e.Key).ToList();

        var entityPerms = entityKeys.Select(entityKey => new EntityPermission
        {
            EntityKey = entityKey,
            RolePermissions = _roles
                .Where(role => _ops.TryGetValue((role, entityKey), out var ops) && ops.Count > 0)
                .Select(role => new EntityRolePermission
                {
                    RoleName = role,
                    AllowedOperations = _ops[(role, entityKey)].ToList()
                })
                .ToList()
        }).ToList();

        var updated = new SecurityConfiguration
        {
            Roles = config.Roles,
            PagePermissions = config.PagePermissions,
            EntityPermissions = entityPerms,
            FieldPermissions = config.FieldPermissions,
            EndpointPermissions = config.EndpointPermissions,
            ControlPermissions = config.ControlPermissions,
            RowFilters = config.RowFilters,
            RoleSwitching = config.RoleSwitching
        };

        await ConfigManager.SaveAsync(updated);
        Snackbar.Add("Entity permissions saved.", Severity.Success);
    }

    public void Dispose() => Notifier.Unsubscribe(OnConfigChangedAsync);

    private static Color OpColor(string op) => op switch
    {
        "Create" => Color.Success,
        "Read" => Color.Info,
        "Update" => Color.Warning,
        "Delete" => Color.Error,
        _ => Color.Default
    };

    private static Color OpMudColor(string op) => OpColor(op);
}
