@using Dabbler.Security.Configuration
@using Dabbler.Security.Registration
@using Dabbler.Security.Services
@using MudBlazor
@inject SecurityConfigurationManager ConfigManager
@inject ResourceRegistry Registry
@inject AuthorizationStateNotifier Notifier
@inject ISnackbar Snackbar
@implements IDisposable

<MudPaper Elevation="3" Class="pa-4">
    <div class="d-flex align-center justify-space-between mb-4">
        <MudText Typo="Typo.h6">Endpoint Permissions</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="SaveAsync">Save All</MudButton>
    </div>

    @if (_roles.Count == 0)
    {
        <MudText Class="pa-4">No roles defined. Add roles in Role Management first.</MudText>
    }
    else if (Registry.Endpoints.Count == 0)
    {
        <MudText Class="pa-4">No endpoints registered. Register endpoints via options.RegisterEndpoints() at startup.</MudText>
    }
    else
    {
        <MudTextField @bind-Value="_filter"
                      Placeholder="Filter endpoints…"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Clearable="true"
                      Variant="Variant.Outlined"
                      Immediate="true"
                      Class="mb-4" />

        <div style="display:flex; flex-wrap:wrap; gap:16px; align-items:flex-start;">
        @foreach (var ep in Registry.Endpoints.Where(e => MatchesFilter(e.Key, e.DisplayName)))
        {
            <MudCard Elevation="1" Style="min-width:340px; flex:1 1 340px; max-width:600px;">
                <MudCardHeader>
                    <CardHeaderContent>
                        <div class="d-flex align-center gap-2">
                            <MudText Typo="Typo.subtitle1"><b>@ep.DisplayName</b></MudText>
                            @if (!string.IsNullOrEmpty(ep.HttpMethod))
                            {
                                <MudChip T="string" Size="Size.Small"
                                         Color="@HttpMethodColor(ep.HttpMethod)">
                                    @ep.HttpMethod
                                </MudChip>
                            }
                        </div>
                        <MudText Typo="Typo.caption">@ep.Key</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent Class="pt-0">
                    <MudSimpleTable Dense="true" Hover="true" Style="background:transparent; width:100%;"
                                    aria-label="@($"Endpoint permissions for {ep.DisplayName}")">
                        <thead>
                            <tr>
                                <th style="min-width:160px;">Role</th>
                                <th style="text-align:center; width:1%; white-space:nowrap;">
                                    <img src="_content/Dabbler.Security.Blazor/deny-allow-header.svg"
                                         alt="Deny or Allow"
                                         title="Deny or Allow"
                                         style="height:48px; display:inline-block;" />
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var role in _roles)
                            {
                                <tr>
                                    <td>
                                        <MudText Typo="Typo.body2">@role</MudText>
                                    </td>
                                    <td style="text-align:center;">
                                        <DenyAllowSwitch Value="@GetState(role, ep.Key)"
                                                         ValueChanged="@(v => SetState(role, ep.Key, v))"
                                                         AriaLabel="@($"Permission for {role} to call {ep.DisplayName}")" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </MudCardContent>
            </MudCard>
        }
        </div>

        <MudText Typo="Typo.caption" Class="mt-2">
            <b>Allow</b> = role may call this endpoint. <b>Deny</b> = role is explicitly denied (takes precedence over Allow). <b>—</b> = role has no opinion for this endpoint.
        </MudText>
    }
</MudPaper>

@code {
    /// <summary>
    /// A user interface for managing access permissions for all registered API endpoints across all defined roles.
    /// Each role × endpoint cell uses a single three-state switch (Deny / Unset / Allow); mutual exclusion
    /// is enforced at the data-model level so a role cannot be both allowed and denied on the same endpoint.
    /// </summary>

    private List<string> _roles = [];
    private string _filter = string.Empty;

    // roleName → (endpointKey → PermissionState). Unset is represented as the absence of a key entry.
    private readonly Dictionary<string, Dictionary<string, PermissionState>> _state =
        new(StringComparer.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        await ConfigManager.EnsureLoadedAsync();
        LoadFromConfig();
        Notifier.Subscribe(OnConfigChangedAsync);
    }

    private void LoadFromConfig()
    {
        var config = ConfigManager.Current;
        _roles = config.Roles.Select(r => r.RoleName).ToList();

        _state.Clear();
        foreach (var role in _roles)
        {
            _state[role] = new Dictionary<string, PermissionState>(StringComparer.OrdinalIgnoreCase);
        }

        foreach (var ep in config.EndpointPermissions)
        {
            foreach (var role in ep.AllowedRoles)
            {
                if (_state.TryGetValue(role, out var s)) s[ep.EndpointKey] = PermissionState.Allow;
            }
            // Deny overwrites Allow if both were stored for the same role (defensive — pre-fix data).
            foreach (var role in ep.DeniedRoles)
            {
                if (_state.TryGetValue(role, out var s)) s[ep.EndpointKey] = PermissionState.Deny;
            }
        }
    }

    private async Task OnConfigChangedAsync(AuthorizationConfigurationChanged _)
    {
        LoadFromConfig();
        await InvokeAsync(StateHasChanged);
    }

    private bool MatchesFilter(string key, string displayName) =>
        string.IsNullOrEmpty(_filter) ||
        key.Contains(_filter, StringComparison.OrdinalIgnoreCase) ||
        displayName.Contains(_filter, StringComparison.OrdinalIgnoreCase);

    private PermissionState GetState(string role, string endpointKey) =>
        _state.TryGetValue(role, out var s) && s.TryGetValue(endpointKey, out var st)
            ? st
            : PermissionState.Unset;

    private void SetState(string role, string endpointKey, PermissionState newState)
    {
        if (!_state.TryGetValue(role, out var s))
        {
            s = new Dictionary<string, PermissionState>(StringComparer.OrdinalIgnoreCase);
            _state[role] = s;
        }

        if (newState == PermissionState.Unset)
        {
            s.Remove(endpointKey);
        }
        else
        {
            s[endpointKey] = newState;
        }
    }

    private async Task SaveAsync()
    {
        var config = ConfigManager.Current;
        var endpointKeys = Registry.Endpoints.Select(e => e.Key).ToList();

        var endpointPerms = endpointKeys.Select(epKey => new EndpointPermission
        {
            EndpointKey = epKey,
            AllowedRoles = _roles.Where(r => GetState(r, epKey) == PermissionState.Allow).ToList(),
            DeniedRoles = _roles.Where(r => GetState(r, epKey) == PermissionState.Deny).ToList()
        }).ToList();

        var updated = new SecurityConfiguration
        {
            Roles = config.Roles,
            PagePermissions = config.PagePermissions,
            EntityPermissions = config.EntityPermissions,
            FieldPermissions = config.FieldPermissions,
            EndpointPermissions = endpointPerms,
            ControlPermissions = config.ControlPermissions,
            RowFilters = config.RowFilters,
            RoleSwitching = config.RoleSwitching
        };

        await ConfigManager.SaveAsync(updated);
        Snackbar.Add("Endpoint permissions saved.", Severity.Success);
    }

    /// <inheritdoc />
    public void Dispose() => Notifier.Unsubscribe(OnConfigChangedAsync);

    private static Color HttpMethodColor(string method) => method.ToUpperInvariant() switch
    {
        "GET" => Color.Info,
        "POST" => Color.Success,
        "PUT" or "PATCH" => Color.Warning,
        "DELETE" => Color.Error,
        _ => Color.Default
    };
}
