@using Dabbler.Security.Registration
@using MudBlazor
@inject ResourceRegistry Registry

@if (Registry.Entities.Count == 0)
{
    <MudText Class="pa-4">No entities registered. Call <code>options.RegisterEntities()</code> at startup to use this feature.</MudText>
}
else
{
    <div class="d-flex align-center mb-4" style="gap:16px;">
        <MudText Typo="Typo.subtitle1" Style="white-space:nowrap;">Entity:</MudText>
        <MudSelect T="string"
                   Value="@_selectedEntity"
                   ValueChanged="OnEntitySelected"
                   aria-label="Select entity for row filters"
                   Margin="Margin.Dense"
                   Variant="Variant.Outlined"
                   Style="max-width:360px;">
            @foreach (var entity in Registry.Entities)
            {
                <MudSelectItem Value="@entity.Key">@entity.DisplayName</MudSelectItem>
            }
        </MudSelect>
    </div>

    @if (!string.IsNullOrEmpty(_selectedEntity))
    {
        <DabblerRowFilterEditor EntityKey="@_selectedEntity" />
    }
}

@code {
    /// <summary>
    /// A component that provides a tabbed view for managing row-level security filters.
    /// It displays a dropdown to select a registered entity and then renders the
    /// <see cref="DabblerRowFilterEditor"/> for the selected entity.
    /// </summary>
    private string _selectedEntity = string.Empty;

    protected override void OnInitialized()
    {
        _selectedEntity = Registry.Entities.FirstOrDefault()?.Key ?? string.Empty;
    }

    private void OnEntitySelected(string entity) => _selectedEntity = entity;
}
