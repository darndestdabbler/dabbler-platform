@using Dabbler.Security.Configuration
@using MudBlazor

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(IsEdit ? "Edit Role" : "Add Role")</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField T="string"
                      @ref="_roleNameField"
                      @bind-Value="RoleName"
                      Label="Role Name"
                      Required="true"
                      RequiredError="Role name is required."
                      Error="@(!string.IsNullOrEmpty(RoleNameError))"
                      ErrorText="@RoleNameError"
                      Disabled="@IsEdit"
                      HelperText="@(IsEdit ? "Role name cannot be changed after creation." : "")"
                      Class="mt-4" />
        <MudTextField T="string" @bind-Value="Description" Label="Description" Class="mt-3" />
        <MudSelect T="string" @bind-Value="InheritsFrom" Label="Inherits From (optional)"
                   Clearable="true" Class="mt-3">
            @foreach (var role in AvailableRoles)
            {
                <MudSelectItem Value="@role">@role</MudSelectItem>
            }
        </MudSelect>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public string RoleName { get; set; } = string.Empty;
    [Parameter] public string? Description { get; set; }
    [Parameter] public string? InheritsFrom { get; set; }
    [Parameter] public bool IsEdit { get; set; }
    [Parameter] public List<string> AvailableRoles { get; set; } = [];
    [Parameter] public string RoleNameError { get; set; } = string.Empty;

    private MudTextField<string>? _roleNameField;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _roleNameField is not null && !IsEdit)
        {
            try { await _roleNameField.FocusAsync(); }
            catch { /* element not yet ready */ }
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private void Save() => MudDialog.Close(DialogResult.Ok(new RoleFormResult
    {
        RoleName = RoleName,
        Description = Description,
        InheritsFrom = string.IsNullOrWhiteSpace(InheritsFrom) ? null : InheritsFrom
    }));

    public sealed class RoleFormResult
    {
        public string RoleName { get; set; } = string.Empty;
        public string? Description { get; set; }
        public string? InheritsFrom { get; set; }
    }
}
