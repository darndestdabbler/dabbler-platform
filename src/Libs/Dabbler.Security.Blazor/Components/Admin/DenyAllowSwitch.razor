@using Dabbler.Security.Configuration
@using MudBlazor

<MudToggleGroup T="PermissionState"
                Value="@Value"
                ValueChanged="@OnValueChanged"
                SelectionMode="SelectionMode.SingleSelection"
                CheckMark="false"
                Dense="true"
                Size="Size.Small"
                Color="@GetColor()"
                aria-label="@AriaLabel">
    <MudToggleItem Value="@PermissionState.Deny" Text="Deny" />
    <MudToggleItem Value="@PermissionState.Unset" Text="—" />
    <MudToggleItem Value="@PermissionState.Allow" Text="Allow" />
</MudToggleGroup>

@code {
    /// <summary>Current permission decision for this cell.</summary>
    [Parameter, EditorRequired] public PermissionState Value { get; set; }

    /// <summary>Fires when the user selects a different state.</summary>
    [Parameter] public EventCallback<PermissionState> ValueChanged { get; set; }

    /// <summary>Accessible label for screen readers (e.g. "Permission for Admin to access Reports").</summary>
    [Parameter] public string? AriaLabel { get; set; }

    private Color GetColor() => Value switch
    {
        PermissionState.Allow => Color.Success,
        PermissionState.Deny => Color.Error,
        _ => Color.Default,
    };

    private Task OnValueChanged(PermissionState newValue)
        => ValueChanged.InvokeAsync(newValue);
}
