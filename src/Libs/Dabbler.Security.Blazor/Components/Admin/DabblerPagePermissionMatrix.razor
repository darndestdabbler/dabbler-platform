@using Dabbler.Security.Configuration
@using Dabbler.Security.Registration
@using Dabbler.Security.Services
@using MudBlazor
@inject SecurityConfigurationManager ConfigManager
@inject ResourceRegistry Registry
@inject AuthorizationStateNotifier Notifier
@inject ISnackbar Snackbar
@implements IDisposable

<MudPaper Elevation="3" Class="pa-4">
    <div class="d-flex align-center justify-space-between mb-4">
        <MudText Typo="Typo.h6">Page Permissions</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="SaveAsync">Save All</MudButton>
    </div>

    @if (_roles.Count == 0)
    {
        <MudText Class="pa-4">No roles defined. Add roles in Role Management first.</MudText>
    }
    else if (Registry.Pages.Count == 0)
    {
        <MudText Class="pa-4">No pages registered. Register pages via options.RegisterPages() at startup.</MudText>
    }
    else
    {
        <MudTextField @bind-Value="_filter"
                      Placeholder="Filter pages…"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Clearable="true"
                      Variant="Variant.Outlined"
                      Immediate="true"
                      Class="mb-4" />

        <div style="display:flex; flex-wrap:wrap; gap:16px; align-items:flex-start;">
        @foreach (var pg in Registry.Pages.Where(p => MatchesFilter(p.Key, p.DisplayName)))
        {
                <MudCard Elevation="1" Style="min-width:340px; flex:1 1 340px; max-width:600px;">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.subtitle1"><b>@pg.DisplayName</b></MudText>
                            <MudText Typo="Typo.caption">@pg.Key</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                <MudCardContent Class="pt-0">
                    <MudSimpleTable Dense="true" Hover="true" Style="background:transparent; width:100%;"
                                    aria-label="@($"Page permissions for {pg.DisplayName}")">
                        <thead>
                            <tr>
                                <th style="min-width:160px;">Role</th>
                                <th style="text-align:center; width:1%; white-space:nowrap;">
                                    <img src="_content/Dabbler.Security.Blazor/deny-allow-header.svg"
                                         alt="Deny or Allow"
                                         title="Deny or Allow"
                                         style="height:48px; display:inline-block;" />
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var role in _roles)
                            {
                                <tr>
                                    <td>
                                        <MudText Typo="Typo.body2">@role</MudText>
                                    </td>
                                    <td style="text-align:center;">
                                        <DenyAllowSwitch Value="@GetState(role, pg.Key)"
                                                         ValueChanged="@(v => SetState(role, pg.Key, v))"
                                                         AriaLabel="@($"Permission for {role} to access {pg.DisplayName}")" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </MudCardContent>
            </MudCard>
        }
        </div>

        <MudText Typo="Typo.caption" Class="mt-2">
            <b>Allow</b> = role may access this page. <b>Deny</b> = role is explicitly denied (takes precedence over Allow). <b>—</b> = role has no opinion for this page.
        </MudText>
    }
</MudPaper>

@code {
    /// <summary>
    /// A component for managing page access permissions.
    /// It displays a matrix of registered pages and defined roles, allowing administrators
    /// to grant or deny access for each role-page combination via a single three-state switch
    /// (Deny / Unset / Allow). Mutual exclusion is enforced at the data-model level.
    /// </summary>
    private List<string> _roles = [];
    private string _filter = string.Empty;

    // roleName → (pageKey → PermissionState). Unset is represented as the absence of a pageKey entry.
    private readonly Dictionary<string, Dictionary<string, PermissionState>> _state =
        new(StringComparer.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        await ConfigManager.EnsureLoadedAsync();
        LoadFromConfig();
        Notifier.Subscribe(OnConfigChangedAsync);
    }

    private void LoadFromConfig()
    {
        var config = ConfigManager.Current;
        _roles = config.Roles.Select(r => r.RoleName).ToList();

        _state.Clear();
        foreach (var role in _roles)
        {
            _state[role] = new Dictionary<string, PermissionState>(StringComparer.OrdinalIgnoreCase);
        }

        foreach (var pp in config.PagePermissions)
        {
            foreach (var role in pp.AllowedRoles)
            {
                if (_state.TryGetValue(role, out var s)) s[pp.PageKey] = PermissionState.Allow;
            }
            // Deny overwrites Allow if both were stored for the same role (defensive — pre-fix data).
            foreach (var role in pp.DeniedRoles)
            {
                if (_state.TryGetValue(role, out var s)) s[pp.PageKey] = PermissionState.Deny;
            }
        }
    }

    private async Task OnConfigChangedAsync(AuthorizationConfigurationChanged _)
    {
        LoadFromConfig();
        await InvokeAsync(StateHasChanged);
    }

    private bool MatchesFilter(string key, string displayName) =>
        string.IsNullOrEmpty(_filter) ||
        key.Contains(_filter, StringComparison.OrdinalIgnoreCase) ||
        displayName.Contains(_filter, StringComparison.OrdinalIgnoreCase);

    private PermissionState GetState(string role, string pageKey) =>
        _state.TryGetValue(role, out var s) && s.TryGetValue(pageKey, out var st)
            ? st
            : PermissionState.Unset;

    private void SetState(string role, string pageKey, PermissionState newState)
    {
        if (!_state.TryGetValue(role, out var s))
        {
            s = new Dictionary<string, PermissionState>(StringComparer.OrdinalIgnoreCase);
            _state[role] = s;
        }

        if (newState == PermissionState.Unset)
        {
            s.Remove(pageKey);
        }
        else
        {
            s[pageKey] = newState;
        }
    }

    private async Task SaveAsync()
    {
        var config = ConfigManager.Current;

        var pageKeys = Registry.Pages.Select(p => p.Key).ToList();
        var pagePerms = pageKeys.Select(pageKey => new PagePermission
        {
            PageKey = pageKey,
            AllowedRoles = _roles.Where(r => GetState(r, pageKey) == PermissionState.Allow).ToList(),
            DeniedRoles = _roles.Where(r => GetState(r, pageKey) == PermissionState.Deny).ToList(),
        }).ToList();

        var updated = new SecurityConfiguration
        {
            Roles = config.Roles,
            PagePermissions = pagePerms,
            EntityPermissions = config.EntityPermissions,
            FieldPermissions = config.FieldPermissions,
            EndpointPermissions = config.EndpointPermissions,
            ControlPermissions = config.ControlPermissions,
            RowFilters = config.RowFilters,
            RoleSwitching = config.RoleSwitching,
        };

        await ConfigManager.SaveAsync(updated);
        Snackbar.Add("Page permissions saved.", Severity.Success);
    }

    /// <inheritdoc />
    public void Dispose() => Notifier.Unsubscribe(OnConfigChangedAsync);
}
