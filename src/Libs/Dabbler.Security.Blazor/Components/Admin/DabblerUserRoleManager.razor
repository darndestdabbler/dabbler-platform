@using Dabbler.Security.Configuration
@using Dabbler.Security.Services
@using MudBlazor
@inject IUserListProvider UserListProvider
@inject IUserRoleStore UserRoleStore
@inject SecurityConfigurationManager ConfigManager
@inject AuthorizationStateNotifier Notifier
@inject ISnackbar Snackbar
@implements IDisposable

<MudPaper Elevation="3" Class="pa-4">
    <div class="d-flex align-center justify-space-between mb-4">
        <MudText Typo="Typo.h6">User Role Assignments</MudText>
        <MudTextField @bind-Value="_search" Placeholder="Search users..."
                      aria-label="Search users"
                      Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                      Immediate="true" DebounceInterval="200"
                      Class="ml-4" Style="max-width:280px" />
    </div>
    <div class="d-flex align-center mb-4">
        <MudSwitch T="bool" @bind-Value="_showUnassigned"
                   Label="Show unassigned users"
                   Color="Color.Primary"
                   data-testid="show-unassigned-toggle" />
    </div>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (!_userRows.Any())
    {
        <MudText Class="pa-4">No users found.</MudText>
    }
    else
    {
        <MudTable Items="@FilteredRows" Dense="true" Hover="true" Striped="true">
            <HeaderContent>
                <MudTh>User</MudTh>
                <MudTh>Email</MudTh>
                <MudTh>Current Roles</MudTh>
                <MudTh>Assign Role</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="User">
                    <MudText Typo="Typo.subtitle2">@context.User.DisplayName</MudText>
                </MudTd>
                <MudTd DataLabel="Email">@context.User.Email</MudTd>
                <MudTd DataLabel="Current Roles">
                    <div class="d-flex flex-wrap gap-1">
                        @foreach (var role in context.Roles)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary"
                                     OnClose="@(() => RemoveRoleAsync(context, role))">
                                @role
                            </MudChip>
                        }
                        @if (!context.Roles.Any())
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">No roles assigned</MudText>
                        }
                    </div>
                </MudTd>
                <MudTd DataLabel="Assign Role">
                    <div class="d-flex align-center gap-2">
                        <MudText Typo="Typo.caption" Style="color:#495057;">Add role</MudText>
                        <MudSelect T="string" @bind-Value="context.PendingRole"
                                   aria-label="@($"Select a role to add to {context.User.DisplayName}")"
                                   Margin="Margin.Dense"
                                   Style="min-width:160px">
                            @foreach (var role in _availableRoles.Where(r => !context.Roles.Contains(r)))
                            {
                                <MudSelectItem Value="@role">@role</MudSelectItem>
                            }
                        </MudSelect>
                        <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small"
                                       Color="Color.Primary"
                                       Disabled="@string.IsNullOrEmpty(context.PendingRole)"
                                       OnClick="@(() => AddRoleAsync(context))"
                                       title="@($"Add selected role to {context.User.DisplayName}")"
                                       aria-label="@($"Add selected role to {context.User.DisplayName}")" />
                    </div>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudPaper>

@code {
    /// <summary>
    /// Provides a UI for managing user role assignments.
    /// Displays a searchable list of users and allows administrators to add or remove roles for each user.
    /// </summary>
    private List<UserRow> _userRows = [];
    private List<string> _availableRoles = [];
    private bool _loading = true;
    private string _search = string.Empty;
    private bool _showUnassigned;

    private IEnumerable<UserRow> FilteredRows
    {
        get
        {
            IEnumerable<UserRow> rows = _userRows;
            if (!_showUnassigned)
            {
                rows = rows.Where(r => r.Roles.Count > 0);
            }
            if (!string.IsNullOrWhiteSpace(_search))
            {
                rows = rows.Where(r =>
                    r.User.DisplayName.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                    r.User.Email.Contains(_search, StringComparison.OrdinalIgnoreCase));
            }
            return rows;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await ConfigManager.EnsureLoadedAsync();
        _availableRoles = ConfigManager.Current.Roles.Select(r => r.RoleName).ToList();
        await LoadUsersAsync();
        Notifier.Subscribe(OnConfigChangedAsync);
    }

    private async Task OnConfigChangedAsync(AuthorizationConfigurationChanged _)
    {
        _availableRoles = ConfigManager.Current.Roles.Select(r => r.RoleName).ToList();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadUsersAsync()
    {
        _loading = true;
        try
        {
            var users = await UserListProvider.GetUsersAsync();
            var allAssignments = await UserRoleStore.GetAllAsync();

            _userRows = users.Select(u =>
            {
                var roles = allAssignments.TryGetValue(u.UserId, out var r) ? r.ToList() : [];
                return new UserRow(u, roles);
            }).ToList();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task AddRoleAsync(UserRow row)
    {
        if (string.IsNullOrEmpty(row.PendingRole)) return;
        await UserRoleStore.AddRoleAsync(row.User.UserId, row.PendingRole);
        row.Roles.Add(row.PendingRole);
        row.PendingRole = null;
        Snackbar.Add($"Role assigned.", Severity.Success);
        StateHasChanged();
    }

    private async Task RemoveRoleAsync(UserRow row, string role)
    {
        await UserRoleStore.RemoveRoleAsync(row.User.UserId, role);
        row.Roles.Remove(role);
        Snackbar.Add($"Role removed.", Severity.Info);
        StateHasChanged();
    }

    /// <inheritdoc />
    public void Dispose() => Notifier.Unsubscribe(OnConfigChangedAsync);

    private sealed class UserRow(UserSummary user, List<string> roles)
    {
        public UserSummary User { get; } = user;
        public List<string> Roles { get; } = roles;
        public string? PendingRole { get; set; }
    }
}
