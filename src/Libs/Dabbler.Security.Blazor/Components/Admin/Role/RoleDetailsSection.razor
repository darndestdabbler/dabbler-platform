@using Dabbler.Security.Authorization
@using Dabbler.Security.Configuration
@using Dabbler.Security.Services
@using MudBlazor
@namespace Dabbler.Security.Blazor.Components.Admin.Role

<MudPaper Class="pa-4 mt-4" Elevation="1" data-testid="role-details-section">
    <div class="d-flex align-center mb-3 gap-2">
        <MudText Typo="Typo.h6">@Title</MudText>
        @if (Selection.IsBakedIn)
        {
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary">
                baked-in
            </MudChip>
        }
    </div>

    @if (Selection.IsBakedIn && Selection.BakedInRole is { } bakedInRole)
    {
        <MudTabs Elevation="0" Rounded="false" TabPanelsClass="pa-3" Position="Position.Top"
                 @bind-ActivePanelIndex="_activeBakedInTabIndex">
            <MudTabPanel Text="Mask Exemptions">
                <MaskExemptionsSubTab TargetRoleName="@bakedInRole.Name"
                                      OnPersisted="OnSubTabPersisted" />
            </MudTabPanel>
            <MudTabPanel Text="Compiled Privileges">
                <BakedInPrivilegesPanel Role="bakedInRole"
                                        AliasOverride="@Selection.AliasOverride" />
            </MudTabPanel>
        </MudTabs>
    }
    else if (Selection.UserTypeRole is { } userTypeRole)
    {
        <MudTabs Elevation="0" Rounded="false" TabPanelsClass="pa-3" Position="Position.Top"
                 @bind-ActivePanelIndex="_activeUserTypeTabIndex">
            <MudTabPanel Text="Data Column Restrictions">
                <ColumnRestrictionsSubTab Role="userTypeRole"
                                          OnPersisted="OnSubTabPersisted" />
            </MudTabPanel>
            <MudTabPanel Text="Data Row Restrictions">
                <RowRestrictionsSubTab Role="userTypeRole"
                                       OnPersisted="OnSubTabPersisted" />
            </MudTabPanel>
            <MudTabPanel Text="Other UI Restrictions">
                <UiRestrictionsSubTab Role="userTypeRole"
                                      OnPersisted="OnSubTabPersisted" />
            </MudTabPanel>
            <MudTabPanel Text="Mask Exemptions">
                <MaskExemptionsSubTab TargetRoleName="@userTypeRole.RoleName"
                                      OnPersisted="OnSubTabPersisted" />
            </MudTabPanel>
        </MudTabs>
    }
</MudPaper>

@code {
    /// <summary>
    /// Dispatcher rendered below the Role Master grid when a row is selected.
    /// Renders the four user-type sub-tabs when a user-type role is selected,
    /// or the Mask Exemptions sub-tab plus the compiled-privileges panel when a
    /// baked-in role is selected. Applications cannot alter baked-in privileges,
    /// so the edit affordances are suppressed in that case (per the
    /// architecture doc's baked-in immutability contract).
    /// </summary>

    /// <summary>The selection to render. Required.</summary>
    [Parameter, EditorRequired]
    public RoleSelection Selection { get; set; } = default!;

    /// <summary>
    /// Fired whenever a sub-tab persists a change, so the parent can refresh
    /// the Role Master grid.
    /// </summary>
    [Parameter]
    public EventCallback OnPersisted { get; set; }

    private int _activeUserTypeTabIndex;
    private int _activeBakedInTabIndex;

    private string Title => Selection.IsBakedIn
        ? Selection.BakedInRole!.Name
        : Selection.UserTypeRole!.RoleName;

    private async Task OnSubTabPersisted()
    {
        if (OnPersisted.HasDelegate)
            await OnPersisted.InvokeAsync();
    }

    /// <summary>
    /// Describes the currently-selected Role Master row so the details section
    /// knows which sub-tabs to render. Use the static <c>ForUserType</c> /
    /// <c>ForBakedIn</c> factories to construct a selection.
    /// </summary>
    public sealed record RoleSelection(
        RoleDefinition? UserTypeRole,
        BakedInRoleDefinition? BakedInRole,
        string? AliasOverride)
    {
        /// <summary>Gets a value indicating whether this is a baked-in role selection.</summary>
        public bool IsBakedIn => BakedInRole is not null;

        /// <summary>Factory for a user-type role selection.</summary>
        public static RoleSelection ForUserType(RoleDefinition role) =>
            new(role, null, null);

        /// <summary>Factory for a baked-in role selection.</summary>
        public static RoleSelection ForBakedIn(BakedInRoleDefinition role, string? aliasOverride) =>
            new(null, role, aliasOverride);
    }
}
