@using Dabbler.Security.Configuration
@using Dabbler.Security.Registration
@using Dabbler.Security.Services
@using MudBlazor
@namespace Dabbler.Security.Blazor.Components.Admin.Role
@inject SecurityConfigurationManager ConfigManager
@inject MetadataRegistry Metadata
@inject ISnackbar Snackbar

<div data-testid="row-restrictions-subtab">
    <MudText Typo="Typo.subtitle1" Class="mb-2">Data Row Restrictions</MudText>
    <MudText Typo="Typo.caption" Class="mb-3">
        Narrow the records this role can see on a table via a filter expression.
        Only SystemAdmin configures these; expressions are parsed at runtime and
        fall back to deny-all on parse failure.
    </MudText>

    <MudPaper Class="pa-3 mb-3" Elevation="0" Outlined="true">
        <div class="d-flex flex-wrap align-center gap-2">
            <MudSelect T="string" Label="Table" @bind-Value="_newTableKey"
                       Variant="Variant.Outlined" Margin="Margin.Dense"
                       data-testid="row-restriction-new-table"
                       Style="min-width:180px;">
                @foreach (var table in Metadata.Tables)
                {
                    <MudSelectItem T="string" Value="@table.Key">@table.DisplayName</MudSelectItem>
                }
            </MudSelect>

            <MudTextField T="string" Label="Filter expression"
                          @bind-Value="_newExpression"
                          Variant="Variant.Outlined" Margin="Margin.Dense"
                          Placeholder="@ExpressionPlaceholder"
                          data-testid="row-restriction-new-expression"
                          Style="min-width:280px;" />

            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="AddAsync"
                       Disabled="@(!CanAdd)"
                       data-testid="row-restriction-add-button">
                Add
            </MudButton>
        </div>
    </MudPaper>

    @if (Role.RowRestrictions.Count == 0)
    {
        <MudText Typo="Typo.body2" Class="pa-3" data-testid="row-restriction-empty">
            No row restrictions configured. This role can see every record on
            every table (modulo the global organization filter).
        </MudText>
    }
    else
    {
        <MudTable Items="@Role.RowRestrictions" Dense="true" Hover="true"
                  Bordered="true" Striped="true"
                  data-testid="row-restriction-grid">
            <HeaderContent>
                <MudTh>Table</MudTh>
                <MudTh>Filter expression</MudTh>
                <MudTh Style="width:48px;text-align:center;">Remove</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Table">@ResolveTableDisplay(context.EntityKey)</MudTd>
                <MudTd DataLabel="Filter expression">
                    <MudTextField T="string"
                                  Value="@context.FilterExpression"
                                  ValueChanged="@(v => OnExpressionChangedAsync(context, v))"
                                  Variant="Variant.Text"
                                  Margin="Margin.Dense"
                                  Immediate="false"
                                  DebounceInterval="400"
                                  data-testid="@($"row-restriction-expression-{context.EntityKey}")" />
                </MudTd>
                <MudTd Style="text-align:center;">
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Size="Size.Small"
                                   Color="Color.Error"
                                   OnClick="@(() => RemoveAsync(context))"
                                   title="Remove restriction"
                                   aria-label="@($"Remove restriction on {context.EntityKey}")"
                                   data-testid="@($"row-restriction-remove-{context.EntityKey}")" />
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</div>

@code {
    /// <summary>
    /// Inline-editable grid of <see cref="RowRestriction"/> rows for the given
    /// user-type role. The filter expression uses the expression grammar honoured
    /// by <c>RowRestrictionBroker</c>; a debounced text edit persists on change.
    /// </summary>

    /// <summary>
    /// The user-type role being edited. Required.
    /// </summary>
    [Parameter, EditorRequired]
    public RoleDefinition Role { get; set; } = default!;

    /// <summary>
    /// Raised after the role's <see cref="RoleDefinition.RowRestrictions"/>
    /// list changes and the configuration has been persisted.
    /// </summary>
    [Parameter]
    public EventCallback OnPersisted { get; set; }

    private const string ExpressionPlaceholder = "e.g. CustomerId == @CurrentUserId";

    private string? _newTableKey;
    private string _newExpression = string.Empty;

    private bool CanAdd =>
        !string.IsNullOrEmpty(_newTableKey)
        && !string.IsNullOrWhiteSpace(_newExpression)
        && !Role.RowRestrictions.Any(r =>
            string.Equals(r.EntityKey, _newTableKey, StringComparison.OrdinalIgnoreCase));

    private async Task AddAsync()
    {
        if (!CanAdd) return;

        Role.RowRestrictions.Add(new RowRestriction
        {
            EntityKey = _newTableKey!,
            FilterExpression = _newExpression.Trim(),
        });

        await PersistAsync("Row restriction added.");

        _newTableKey = null;
        _newExpression = string.Empty;
    }

    private async Task RemoveAsync(RowRestriction row)
    {
        Role.RowRestrictions.Remove(row);
        await PersistAsync("Row restriction removed.");
    }

    private async Task OnExpressionChangedAsync(RowRestriction row, string newValue)
    {
        if (string.Equals(row.FilterExpression, newValue, StringComparison.Ordinal)) return;
        row.FilterExpression = newValue;
        await PersistAsync("Row restriction updated.");
    }

    private async Task PersistAsync(string successMessage)
    {
        await ConfigManager.SaveAsync(ConfigManager.Current);
        Snackbar.Add(successMessage, Severity.Success);
        if (OnPersisted.HasDelegate)
            await OnPersisted.InvokeAsync();
    }

    private string ResolveTableDisplay(string key) =>
        Metadata.GetTable(key)?.DisplayName ?? key;
}
