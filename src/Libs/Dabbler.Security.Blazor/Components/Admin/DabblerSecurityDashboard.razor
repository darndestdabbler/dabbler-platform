@using Dabbler.Security.Blazor.Components.Admin
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@page "/admin/security"
@attribute [Dabbler.Security.Authorization.DabblerPageAuthorize("/admin/security")]

<PageTitle>Security Administration</PageTitle>

<div data-testid="security-dashboard-tabstrip"
     @onkeydown="HandleTabKeyDown">
    <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4"
             @bind-ActivePanelIndex="_activePanelIndex">
        <MudTabPanel Text="Roles">
            <DabblerRoleManager />
        </MudTabPanel>
        <MudTabPanel Text="Page Access">
            <DabblerPagePermissionMatrix />
        </MudTabPanel>
        <MudTabPanel Text="Entity Access">
            <DabblerEntityPermissionMatrix />
        </MudTabPanel>
        <MudTabPanel Text="Endpoint Access">
            <DabblerEndpointPermissionMatrix />
        </MudTabPanel>
        <MudTabPanel Text="Control Permissions">
            <DabblerControlPermissionTab />
        </MudTabPanel>
        <MudTabPanel Text="Row Filters">
            <DabblerRowFilterTab />
        </MudTabPanel>
        <MudTabPanel Text="User Assignments">
            <DabblerUserRoleManager />
        </MudTabPanel>
    </MudTabs>
</div>

@code {
    internal const int TabCount = 7;

    private int _activePanelIndex;

    internal int ActivePanelIndex => _activePanelIndex;

    private void HandleTabKeyDown(KeyboardEventArgs args)
    {
        if (NextPanelIndex(_activePanelIndex, args.Key, TabCount) is { } index)
        {
            _activePanelIndex = index;
        }
    }

    internal static int? NextPanelIndex(int current, string key, int count)
    {
        if (count <= 0)
        {
            return null;
        }

        return key switch
        {
            "ArrowRight" => (current + 1) % count,
            "ArrowLeft" => (current - 1 + count) % count,
            "Home" => 0,
            "End" => count - 1,
            _ => null
        };
    }
}
