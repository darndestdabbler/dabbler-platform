@using Dabbler.Security.Blazor.Components.Admin
@using MudBlazor
@page "/admin/security"
@attribute [Dabbler.Security.Authorization.DabblerPageAuthorize("/admin/security")]

<PageTitle>Security Administration</PageTitle>

<MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4">
    <MudTabPanel Text="Roles">
        <DabblerRoleManager />
    </MudTabPanel>
    <MudTabPanel Text="Page Access">
        <DabblerPagePermissionMatrix />
    </MudTabPanel>
    <MudTabPanel Text="Entity Access">
        <DabblerEntityPermissionMatrix />
    </MudTabPanel>
    <MudTabPanel Text="Endpoint Access">
        <DabblerEndpointPermissionMatrix />
    </MudTabPanel>
    <MudTabPanel Text="Control Permissions">
        <DabblerControlPermissionTab />
    </MudTabPanel>
    <MudTabPanel Text="Row Filters">
        <DabblerRowFilterTab />
    </MudTabPanel>
    <MudTabPanel Text="User Assignments">
        <DabblerUserRoleManager />
    </MudTabPanel>
</MudTabs>
