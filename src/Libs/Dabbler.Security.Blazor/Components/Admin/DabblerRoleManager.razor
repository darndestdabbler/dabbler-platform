@using Dabbler.Security.Configuration
@using Dabbler.Security.Services
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@inject SecurityConfigurationManager ConfigManager
@inject AuthorizationStateNotifier Notifier
@inject ISnackbar Snackbar
@implements IDisposable

<MudPaper Elevation="3" Class="pa-4">
    <div class="d-flex align-center justify-space-between mb-4">
        <MudText Typo="Typo.h6">Role Management</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="OpenAddDialogAsync"
                   @ref="_addRoleButton">Add Role</MudButton>
    </div>

    <MudTable Items="@_roles" Dense="true" Hover="true" Striped="true">
        <HeaderContent>
            <MudTh>Role Name</MudTh>
            <MudTh>Description</MudTh>
            <MudTh>Inherits From</MudTh>
            <MudTh>Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Role Name">
                <MudText Typo="Typo.subtitle2">@context.RoleName</MudText>
            </MudTd>
            <MudTd DataLabel="Description">@context.Description</MudTd>
            <MudTd DataLabel="Inherits From">
                @if (!string.IsNullOrEmpty(context.InheritsFrom))
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Info">@context.InheritsFrom</MudChip>
                }
            </MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                               OnClick="@(() => OpenEditDialogAsync(context))"
                               title="@($"Edit role {context.RoleName}")"
                               aria-label="@($"Edit role {context.RoleName}")" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                               Color="Color.Error"
                               OnClick="@(() => DeleteRole(context))"
                               title="@($"Delete role {context.RoleName}")"
                               aria-label="@($"Delete role {context.RoleName}")" />
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Class="pa-4">No roles defined. Add a role to get started.</MudText>
        </NoRecordsContent>
    </MudTable>
</MudPaper>

@if (_dialogVisible)
{
    <div style="position:fixed;inset:0;background:rgba(0,0,0,0.45);z-index:1300;"></div>
    <div style="position:fixed;inset:0;display:flex;align-items:center;justify-content:center;z-index:1400;padding:1rem;">
        <div class="mud-paper mud-elevation-24 pa-6"
             style="width:min(100%, 520px);background:var(--mud-palette-surface);"
             role="dialog"
             aria-modal="true"
             aria-labelledby="role-manager-dialog-title"
             tabindex="-1"
             @onkeydown="HandleDialogKeyDownAsync">
            <MudText Typo="Typo.h6" id="role-manager-dialog-title">@(_editingRole == null ? "Add Role" : "Edit Role")</MudText>

            <MudTextField T="string"
                          @ref="_roleNameField"
                          @bind-Value="_form.RoleName"
                          Label="Role Name"
                          Required="true"
                          RequiredError="Role name is required."
                          Error="@(!string.IsNullOrEmpty(_roleNameError))"
                          ErrorText="@_roleNameError"
                          Disabled="@(_editingRole != null)"
                          HelperText="@(_editingRole != null ? "Role name cannot be changed after creation." : "")"
                          Class="mt-4" />
            <MudTextField T="string" @bind-Value="_form.Description" Label="Description" Class="mt-3" />
            <MudSelect T="string" @bind-Value="_form.InheritsFrom" Label="Inherits From (optional)"
                       Clearable="true" Class="mt-3">
                @foreach (var role in _roles.Where(r => r.RoleName != _form.RoleName))
                {
                    <MudSelectItem Value="@role.RoleName">@role.RoleName</MudSelectItem>
                }
            </MudSelect>

            <div class="d-flex justify-end gap-2 mt-6">
                <MudButton OnClick="CloseDialog">Cancel</MudButton>
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveRole">Save</MudButton>
            </div>
        </div>
    </div>
}

@code {
    /// <summary>
    /// A component for managing security role definitions.
    /// It provides a UI to create, edit, and delete roles, including setting descriptions and inheritance.
    /// </summary>
    private List<RoleDefinition> _roles = [];
    private bool _dialogVisible;
    private RoleDefinition? _editingRole;
    private RoleFormModel _form = new();
    private string _roleNameError = string.Empty;
    private MudButton? _addRoleButton;
    private MudTextField<string>? _roleNameField;
    private bool _focusDialogInput;
    private int _focusDialogRetriesRemaining;
    private bool _returnFocusToAddRole;

    protected override async Task OnInitializedAsync()
    {
        await ConfigManager.EnsureLoadedAsync();
        LoadRoles();
        Notifier.Subscribe(OnConfigChangedAsync);
    }

    private void LoadRoles() => _roles = [.. ConfigManager.Current.Roles];

    private async Task OnConfigChangedAsync(AuthorizationConfigurationChanged _)
    {
        LoadRoles();
        await InvokeAsync(StateHasChanged);
    }

    private async Task OpenAddDialogAsync()
    {
        _editingRole = null;
        _form = new RoleFormModel();
        _roleNameError = string.Empty;
        _dialogVisible = true;
        _focusDialogInput = true;
        _focusDialogRetriesRemaining = 2;
        await InvokeAsync(StateHasChanged);
    }

    private async Task OpenEditDialogAsync(RoleDefinition role)
    {
        _editingRole = role;
        _form = new RoleFormModel
        {
            RoleName = role.RoleName,
            Description = role.Description,
            InheritsFrom = role.InheritsFrom
        };
        _roleNameError = string.Empty;
        _dialogVisible = true;
        _focusDialogInput = true;
        _focusDialogRetriesRemaining = 2;
        await InvokeAsync(StateHasChanged);
    }

    private void CloseDialog()
    {
        _roleNameError = string.Empty;
        _dialogVisible = false;
        _returnFocusToAddRole = true;
    }

    private async Task SaveRole()
    {
        _roleNameError = string.Empty;

        if (string.IsNullOrWhiteSpace(_form.RoleName))
        {
            _roleNameError = "Role name is required.";
            return;
        }

        var config = ConfigManager.Current;
        var updatedRoles = config.Roles.Select(r => new RoleDefinition
        {
            RoleName = r.RoleName,
            Description = r.Description,
            InheritsFrom = r.InheritsFrom
        }).ToList();

        if (_editingRole is null)
        {
            if (updatedRoles.Any(r => r.RoleName == _form.RoleName))
            {
                _roleNameError = "A role with that name already exists. Please choose a different name.";
                return;
            }
            updatedRoles.Add(new RoleDefinition
            {
                RoleName = _form.RoleName,
                Description = _form.Description ?? string.Empty,
                InheritsFrom = NullIfBlank(_form.InheritsFrom)
            });
        }
        else
        {
            var existing = updatedRoles.First(r => r.RoleName == _editingRole.RoleName);
            existing.Description = _form.Description ?? string.Empty;
            existing.InheritsFrom = NullIfBlank(_form.InheritsFrom);
        }

        var updated = CloneWith(config, roles: updatedRoles);
        await ConfigManager.SaveAsync(updated);
        Snackbar.Add("Role saved.", Severity.Success);
        CloseDialog();
    }

    private async Task DeleteRole(RoleDefinition role)
    {
        var config = ConfigManager.Current;

        var orphanReasons = new List<string>();
        if (config.PagePermissions.Any(p => p.AllowedRoles.Contains(role.RoleName) || p.DeniedRoles.Contains(role.RoleName)))
            orphanReasons.Add("page permissions");
        if (config.EntityPermissions.Any(e => e.RolePermissions.Any(r => r.RoleName == role.RoleName)))
            orphanReasons.Add("entity permissions");
        if (config.FieldPermissions.Any(f => f.RolePermissions.Any(r => r.RoleName == role.RoleName)))
            orphanReasons.Add("field permissions");
        if (config.EndpointPermissions.Any(e => e.AllowedRoles.Contains(role.RoleName)))
            orphanReasons.Add("endpoint permissions");
        if (config.ControlPermissions.Any(c => c.RolePermissions.Any(r => r.RoleName == role.RoleName)))
            orphanReasons.Add("control permissions");
        if (config.Roles.Any(r => r.InheritsFrom == role.RoleName))
            orphanReasons.Add("inherited by another role");

        if (orphanReasons.Count > 0)
        {
            Snackbar.Add(
                $"Cannot delete '{role.RoleName}': it still has {string.Join(", ", orphanReasons)}. Remove all references first.",
                Severity.Warning);
            return;
        }

        var updated = CloneWith(config,
            roles: config.Roles.Where(r => r.RoleName != role.RoleName).ToList());
        await ConfigManager.SaveAsync(updated);
        Snackbar.Add($"Role '{role.RoleName}' deleted.", Severity.Success);
    }

    /// <inheritdoc />
    public void Dispose() => Notifier.Unsubscribe(OnConfigChangedAsync);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusDialogInput && _roleNameField is not null)
        {
            try
            {
                _focusDialogInput = false;
                _focusDialogRetriesRemaining = 0;
                await _roleNameField.FocusAsync();
            }
            catch when (_focusDialogRetriesRemaining > 0)
            {
                _focusDialogRetriesRemaining--;
                await InvokeAsync(StateHasChanged);
                return;
            }
        }

        if (_returnFocusToAddRole && _addRoleButton is not null)
        {
            try
            {
                _returnFocusToAddRole = false;
                await _addRoleButton.FocusAsync();
            }
            catch
            {
                _returnFocusToAddRole = true;
                await InvokeAsync(StateHasChanged);
                return;
            }
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    private Task HandleDialogKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            CloseDialog();
        }

        return Task.CompletedTask;
    }

    private static string? NullIfBlank(string? s) =>
        string.IsNullOrWhiteSpace(s) ? null : s;

    private static SecurityConfiguration CloneWith(
        SecurityConfiguration src,
        List<RoleDefinition>? roles = null) => new()
        {
            Roles = roles ?? src.Roles,
            PagePermissions = src.PagePermissions,
            EntityPermissions = src.EntityPermissions,
            FieldPermissions = src.FieldPermissions,
            EndpointPermissions = src.EndpointPermissions,
            ControlPermissions = src.ControlPermissions,
            RowFilters = src.RowFilters,
            RoleSwitching = src.RoleSwitching
        };

    private sealed class RoleFormModel
    {
        public string RoleName { get; set; } = string.Empty;
        public string? Description { get; set; }
        public string? InheritsFrom { get; set; }
    }
}
