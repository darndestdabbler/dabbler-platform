@using Dabbler.Security.Configuration
@using Dabbler.Security.Registration
@using Dabbler.Security.Services
@using MudBlazor
@using FieldAccessLevel = Dabbler.Security.Configuration.FieldAccessLevel
@inject SecurityConfigurationManager ConfigManager
@inject ResourceRegistry Registry
@inject AuthorizationStateNotifier Notifier
@inject ISnackbar Snackbar
@implements IDisposable

@if (_entity is null)
{
    <MudText Class="pa-4">Entity "@EntityKey" is not registered.</MudText>
}
else
{
    <MudPaper Elevation="2" Class="pa-4">
        <div class="d-flex align-center justify-space-between mb-3">
            <MudText Typo="Typo.h6">Field Permissions — @_entity.DisplayName</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       OnClick="SaveAsync">Save</MudButton>
        </div>

        @if (_entity.Fields.Count == 0)
        {
            <MudText Class="pa-4">No fields registered for this entity.</MudText>
        }
        else if (_roles.Count == 0)
        {
            <MudText Class="pa-4">No roles defined. Add roles in Role Management first.</MudText>
        }
        else
        {
            <div style="overflow-x:auto;">
                <MudSimpleTable Dense="true" Hover="true" Style="background:transparent;"
                                aria-label="@($"Field permissions for {_entity.DisplayName}")">
                    <thead>
                        <tr>
                            <th style="min-width:140px;">Field</th>
                            @foreach (var role in _roles)
                            {
                                <th style="text-align:center;min-width:130px;">@role</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var field in _entity.Fields)
                        {
                            <tr>
                                <td>
                                    <MudText Typo="Typo.subtitle2">@field.DisplayName</MudText>
                                    <MudText Typo="Typo.caption">@field.Key</MudText>
                                </td>
                                @foreach (var role in _roles)
                                {
                                    <td style="text-align:center;">
                                        <MudSelect T="FieldAccessLevel"
                                                   Value="@GetLevel(role, field.Key)"
                                                   ValueChanged="@(v => SetLevel(role, field.Key, v))"
                                                   aria-label="@($"{field.DisplayName} access for {role}")"
                                                   Margin="Margin.Dense"
                                                   Variant="Variant.Outlined">
                                            <MudSelectItem Value="FieldAccessLevel.Editable">Editable</MudSelectItem>
                                            <MudSelectItem Value="FieldAccessLevel.ReadOnly">Read Only</MudSelectItem>
                                            <MudSelectItem Value="FieldAccessLevel.Hidden">Hidden</MudSelectItem>
                                        </MudSelect>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </div>
        }
    </MudPaper>
}

@code {
    /// <summary>
    /// A user interface for editing field-level permissions for a single entity across all defined roles.
    /// It displays a matrix of registered fields against roles, allowing the selection of
    /// <see cref="FieldAccessLevel.Editable"/>, <see cref="FieldAccessLevel.ReadOnly"/>, or <see cref="FieldAccessLevel.Hidden"/>.
    /// </summary>

    /// <summary>
    /// Gets or sets the unique key for the entity whose field permissions are to be edited.
    /// This parameter is required.
    /// </summary>
    [Parameter, EditorRequired] public string EntityKey { get; set; } = string.Empty;

    private RegisteredEntity? _entity;
    private List<string> _roles = [];

    // (roleName, fieldKey) → FieldAccessLevel
    private readonly Dictionary<(string role, string field), FieldAccessLevel> _levels = new();

    protected override void OnInitialized()
    {
        Notifier.Subscribe(OnConfigChangedAsync);
    }

    protected override async Task OnParametersSetAsync()
    {
        await ConfigManager.EnsureLoadedAsync();
        LoadFromConfig();
    }



    private void LoadFromConfig()
    {
        _entity = Registry.Entities.FirstOrDefault(e =>
            string.Equals(e.Key, EntityKey, StringComparison.OrdinalIgnoreCase));

        var config = ConfigManager.Current;
        _roles = config.Roles.Select(r => r.RoleName).ToList();
        _levels.Clear();

        foreach (var fp in config.FieldPermissions.Where(f =>
            string.Equals(f.EntityKey, EntityKey, StringComparison.OrdinalIgnoreCase)))
        {
            foreach (var rp in fp.RolePermissions)
                _levels[(rp.RoleName, fp.FieldKey)] = rp.AccessLevel;
        }
    }

    private async Task OnConfigChangedAsync(AuthorizationConfigurationChanged _)
    {
        LoadFromConfig();
        await InvokeAsync(StateHasChanged);
    }

    private FieldAccessLevel GetLevel(string role, string fieldKey)
    {
        var key = (role, fieldKey);
        return _levels.TryGetValue(key, out var level) ? level : FieldAccessLevel.Editable;
    }

    private void SetLevel(string role, string fieldKey, FieldAccessLevel level)
        => _levels[(role, fieldKey)] = level;

    private async Task SaveAsync()
    {
        if (_entity is null) return;

        var config = ConfigManager.Current;

        // Rebuild FieldPermissions — keep other entity entries, replace this entity's entries
        var otherEntities = config.FieldPermissions
            .Where(f => !string.Equals(f.EntityKey, EntityKey, StringComparison.OrdinalIgnoreCase))
            .ToList();

        var thisEntityPerms = (_entity.Fields ?? []).Select(field => new FieldPermission
        {
            EntityKey = EntityKey,
            FieldKey = field.Key,
            RolePermissions = _roles.Select(role => new FieldRolePermission
            {
                RoleName = role,
                AccessLevel = GetLevel(role, field.Key)
            }).ToList()
        }).ToList();

        var updated = new SecurityConfiguration
        {
            Roles = config.Roles,
            PagePermissions = config.PagePermissions,
            EntityPermissions = config.EntityPermissions,
            FieldPermissions = [.. otherEntities, .. thisEntityPerms],
            EndpointPermissions = config.EndpointPermissions,
            ControlPermissions = config.ControlPermissions,
            RowFilters = config.RowFilters,
            RoleSwitching = config.RoleSwitching
        };

        await ConfigManager.SaveAsync(updated);
        Snackbar.Add($"Field permissions for '{_entity.DisplayName}' saved.", Severity.Success);
    }

    public void Dispose() => Notifier.Unsubscribe(OnConfigChangedAsync);
}
