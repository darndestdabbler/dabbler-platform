@using System.Text.RegularExpressions
@using Dabbler.Security.Configuration
@using Dabbler.Security.Registration
@using MudBlazor
@namespace Dabbler.Security.Blazor.Components.Admin.Masks
@inject SecurityConfigurationManager ConfigManager
@inject MetadataRegistry Metadata

<div data-testid="sensitive-name-safety-net-container">
    @if (Matches.Count == 0)
    {
        <MudAlert Severity="Severity.Success" Dense="true" Class="mb-2"
                  data-testid="sensitive-name-safety-net-clear">
            Sensitive-name safety net: no undeclared columns match the sensitive-name
            patterns (ssn, taxid, ein, dob, password, ccnum, salary).
        </MudAlert>
    }
    else
    {
        <MudPaper Class="pa-2 mb-2" Elevation="0" Outlined="true"
                  data-testid="sensitive-name-safety-net-panel">
            <div class="d-flex align-center">
                <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" Class="me-2" />
                <MudText Typo="Typo.subtitle2">
                    Sensitive-name safety net — @Matches.Count undeclared sensitive-pattern
                    @(Matches.Count == 1 ? "column" : "columns") found
                </MudText>
                <MudSpacer />
                <MudIconButton Icon="@(_expanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                               Size="Size.Small"
                               OnClick="@(() => _expanded = !_expanded)"
                               aria-label="@(_expanded ? "Collapse safety net" : "Expand safety net")"
                               data-testid="sensitive-name-safety-net-toggle" />
            </div>

            <MudCollapse Expanded="_expanded">
                <MudText Typo="Typo.caption" Class="pa-2">
                    These columns match a sensitive-name pattern but are not yet declared
                    in Default Masks. Add each one to apply platform-level masking; a
                    blank mask format renders as <code>********</code>.
                </MudText>
                <MudTable Items="@Matches" Dense="true" Hover="true" Bordered="true" Striped="true"
                          data-testid="sensitive-name-safety-net-grid">
                    <HeaderContent>
                        <MudTh>Table</MudTh>
                        <MudTh>Column</MudTh>
                        <MudTh>Pattern matched</MudTh>
                        <MudTh Style="width:140px;text-align:center;">Action</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Table">@context.TableDisplayName</MudTd>
                        <MudTd DataLabel="Column">@context.ColumnDisplayName</MudTd>
                        <MudTd DataLabel="Pattern">
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning"
                                     Variant="Variant.Outlined"
                                     data-testid="@($"safety-net-pattern-{context.EntityKey}-{context.ColumnKey}")">
                                @context.Pattern
                            </MudChip>
                        </MudTd>
                        <MudTd Style="text-align:center;">
                            <MudButton Size="Size.Small"
                                       Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Add"
                                       OnClick="@(() => OnAddAsync(context))"
                                       data-testid="@($"safety-net-add-{context.EntityKey}-{context.ColumnKey}")">
                                Add to Default Masks
                            </MudButton>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudCollapse>
        </MudPaper>
    }
</div>

@code {
    /// <summary>
    /// Flags every column in the <see cref="MetadataRegistry"/> whose name
    /// matches a common sensitive-data pattern (<c>ssn</c>, <c>taxid</c>,
    /// <c>ein</c>, <c>dob</c>, <c>password</c>, <c>ccnum</c>, <c>salary</c>)
    /// but is not yet in <see cref="SecurityConfiguration.DefaultMasks"/>.
    /// A one-click affordance adds a matching <see cref="DefaultMaskRule"/>
    /// with a blank mask format (renders <c>********</c>).
    /// </summary>

    /// <summary>
    /// Callback invoked when the user clicks "Add to Default Masks". The
    /// parent tab delegates the actual mutation to the grid so a single code
    /// path governs persistence, snackbar feedback, and the cross-tab
    /// notifier.
    /// </summary>
    [Parameter, EditorRequired]
    public EventCallback<SensitiveMatch> OnAddMatch { get; set; }

    private bool _expanded = true;

    // Anchored token-style pattern: each token matches when it appears as the
    // full column name OR as a word-like fragment (prefix, suffix, or
    // underscore/camelCase boundary). Using simple case-insensitive Contains
    // for clarity; the false-positive surface is small because the column
    // names live in a curated registry.
    private static readonly (string Token, string Label)[] SensitivePatterns =
    {
        ("ssn", "ssn"),
        ("taxid", "taxid"),
        ("ein", "ein"),
        ("dob", "dob"),
        ("password", "password"),
        ("ccnum", "ccnum"),
        ("salary", "salary"),
    };

    private static readonly Regex MatchRegex = new(
        "ssn|taxid|ein|dob|password|ccnum|salary",
        RegexOptions.IgnoreCase | RegexOptions.Compiled);

    internal IReadOnlyList<SensitiveMatch> Matches { get; private set; } = [];

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        Rebuild();
    }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        Rebuild();
    }

    /// <summary>
    /// Rescans the metadata registry against the current Default Masks list.
    /// Callers invoke this after the parent tab persists a change so the
    /// safety-net panel reflects the latest state.
    /// </summary>
    public void Rebuild()
    {
        var declared = new HashSet<(string Entity, string Column)>(
            ConfigManager.Current.DefaultMasks.Select(m => (m.EntityKey, m.ColumnKey)),
            PairComparer.Instance);

        var matches = new List<SensitiveMatch>();
        foreach (var table in Metadata.Tables)
        {
            foreach (var col in table.Fields)
            {
                if (declared.Contains((table.Key, col.Key))) continue;

                var match = MatchRegex.Match(col.Key);
                if (!match.Success)
                {
                    match = MatchRegex.Match(col.DisplayName);
                }
                if (!match.Success) continue;

                matches.Add(new SensitiveMatch(
                    EntityKey: table.Key,
                    TableDisplayName: table.DisplayName,
                    ColumnKey: col.Key,
                    ColumnDisplayName: col.DisplayName,
                    Pattern: match.Value.ToLowerInvariant()));
            }
        }

        Matches = matches
            .OrderBy(m => m.TableDisplayName, StringComparer.OrdinalIgnoreCase)
            .ThenBy(m => m.ColumnDisplayName, StringComparer.OrdinalIgnoreCase)
            .ToList();

        StateHasChanged();
    }

    private async Task OnAddAsync(SensitiveMatch match)
    {
        if (!OnAddMatch.HasDelegate) return;
        await OnAddMatch.InvokeAsync(match);
    }

    /// <summary>
    /// A column that matches a sensitive-name pattern but has no
    /// <see cref="DefaultMaskRule"/> yet.
    /// </summary>
    public sealed record SensitiveMatch(
        string EntityKey,
        string TableDisplayName,
        string ColumnKey,
        string ColumnDisplayName,
        string Pattern);

    private sealed class PairComparer : IEqualityComparer<(string Entity, string Column)>
    {
        public static readonly PairComparer Instance = new();

        public bool Equals((string Entity, string Column) x, (string Entity, string Column) y) =>
            string.Equals(x.Entity, y.Entity, StringComparison.OrdinalIgnoreCase)
            && string.Equals(x.Column, y.Column, StringComparison.OrdinalIgnoreCase);

        public int GetHashCode((string Entity, string Column) obj) =>
            HashCode.Combine(
                StringComparer.OrdinalIgnoreCase.GetHashCode(obj.Entity ?? string.Empty),
                StringComparer.OrdinalIgnoreCase.GetHashCode(obj.Column ?? string.Empty));
    }
}
