@using Dabbler.Security.Configuration
@using Dabbler.Security.Services
@using MudBlazor
@namespace Dabbler.Security.Blazor.Components.Admin.Masks
@inject SecurityConfigurationManager ConfigManager
@inject AuthorizationStateNotifier Notifier
@implements IDisposable

<div data-testid="default-masks-tab">
    <MudText Typo="Typo.h6" Class="mb-1">Default Masks</MudText>
    <MudText Typo="Typo.body2" Class="mb-3">
        Platform-level sensitive-column declarations. Every role sees these
        columns rendered through their mask format unless an active Mask
        Exemption targets the same table + column for the user's active role.
        The mask renders even when the stored value is null — a visibly empty
        sensitive field would itself leak information.
    </MudText>

    <DefaultMasksGrid @ref="_grid" />
</div>

@code {
    /// <summary>
    /// Composer for the Default Masks tab. Business operators populate Default
    /// Masks directly; the internal auditor is the compliance backstop (see
    /// project-guidance.md → Principles → Security And Organization Model).
    /// The tab still subscribes to <see cref="AuthorizationStateNotifier"/> so
    /// the grid re-renders when a sibling tab persists a change that touches
    /// the <c>DefaultMasks</c> list.
    /// </summary>

    private DefaultMasksGrid? _grid;

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        await ConfigManager.EnsureLoadedAsync();
        Notifier.Subscribe(OnConfigChangedAsync);
    }

    private async Task OnConfigChangedAsync(AuthorizationConfigurationChanged _)
    {
        await InvokeAsync(StateHasChanged);
    }

    /// <inheritdoc />
    public void Dispose() => Notifier.Unsubscribe(OnConfigChangedAsync);
}
