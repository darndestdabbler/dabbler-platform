@page
@model Dabbler.Security.DevIdp.Pages.LoginModel
@{
    ViewData["Title"] = "Sign In";
    Layout = "_Layout";
}

<div class="card">
    <h1>DevIdp Sign In</h1>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="error">@Model.ErrorMessage</div>
    }

    <form method="post">
        <div class="form-group">
            <label for="Email">Email</label>
            <input type="email" id="Email" name="Email" value="@Model.Email"
                   required autofocus placeholder="user@contoso.local" />
        </div>
        <div class="form-group">
            <label for="Password">Password</label>
            <input type="password" id="Password" name="Password"
                   required placeholder="Password" />
        </div>
        <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
        <button type="submit" class="btn">Sign In</button>
    </form>

    <div class="dev-badge">Development Identity Provider</div>
</div>
