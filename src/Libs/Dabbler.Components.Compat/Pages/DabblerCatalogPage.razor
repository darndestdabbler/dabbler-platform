@namespace Dabbler.Components.Compat
@inherits DabblerComponentBase
@using Dabbler.Components.Data.Metadata

<div class="dabbler-catalog-page @Class" style="@Style" @attributes="UserAttributes">
    <div class="dabbler-page-header">
        <MudText Typo="Typo.h6">@PageTitle</MudText>
    </div>

    @* ── Search bar ──────────────────────────────────────────────── *@
    <div class="dabbler-catalog-search">
        <MudTextField T="string"
                      @bind-Value="_searchText"
                      Placeholder="Search by name, description, or tag..."
                      Variant="Variant.Outlined"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Immediate="true"
                      DebounceInterval="300"
                      OnDebounceIntervalElapsed="SearchChangedAsync"
                      Margin="Margin.Dense"
                      aria-label="Search artifacts" />
    </div>

    @* ── Status bar ──────────────────────────────────────────────── *@
    <div class="dabbler-page-toolbar">
        <div class="dabbler-page-toolbar-left">
            <MudText Typo="Typo.body2" Class="dabbler-page-toolbar-status">
                @_statusText
            </MudText>
        </div>
        @if (_isLoading)
        {
            <div class="dabbler-page-toolbar-right">
                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
            </div>
        }
    </div>

    @* ── Results grid ────────────────────────────────────────────── *@
    <div class="dabbler-page-content" aria-live="polite" aria-busy="@_isLoading">
        <MudDataGrid T="CatalogGridRow" Items="@_rows" Dense="true" Hover="true"
                     RowClick="HandleRowClickAsync" RowClass="dabbler-catalog-row-clickable"
                     Loading="@_isLoading" Elevation="0">
            <Columns>
                <PropertyColumn Property="x => x.Name" Title="Name" />
                <PropertyColumn Property="x => x.Description" Title="Description" />
                <PropertyColumn Property="x => x.Category" Title="Category" />
                <TemplateColumn Title="Tags" Sortable="false">
                    <CellTemplate>
                        @if (context.Item.Tags.Count > 0)
                        {
                            <div class="dabbler-catalog-tags">
                                @foreach (var tag in context.Item.Tags)
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                                        @tag
                                    </MudChip>
                                }
                            </div>
                        }
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Last Used" Sortable="false">
                    <CellTemplate>
                        @if (context.Item.LastAccessedAt.HasValue)
                        {
                            <span>@context.Item.LastAccessedAt.Value.ToLocalTime().ToString("g")</span>
                        }
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Pinned" Sortable="false">
                    <CellTemplate>
                        <MudIconButton Icon="@(context.Item.IsPinned
                                                ? Icons.Material.Filled.Star
                                                : Icons.Material.Outlined.StarBorder)"
                                       Color="@(context.Item.IsPinned ? Color.Warning : Color.Default)"
                                       Size="Size.Small"
                                       OnClick="() => TogglePinAsync(context.Item)"
                                       aria-label="@(context.Item.IsPinned ? "Unpin" : "Pin")" />
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <NoRecordsContent>
                <div class="dabbler-page-empty-state">
                    <MudText Typo="Typo.body2">No artifacts found.</MudText>
                </div>
            </NoRecordsContent>
        </MudDataGrid>
    </div>
</div>
