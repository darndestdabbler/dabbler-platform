<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!--
      Pre-MudBlazor-native compatibility surfaces for Dabbler.Components.
      Per ledger §3.4, this package holds: DabblerShell, DabblerNavigationPanel,
      DabblerTabbedWorkspace, DabblerTopMenuBar, DabblerCatalogPage.
      Session 7 lands the content move; Session 6 only scaffolds the project.
      Sunset version: 0.4.0.
    -->
    <PackageId>Dabbler.Components.Compat</PackageId>
    <Description>Pre-MudBlazor-native compatibility surfaces for Dabbler.Components (DabblerShell, DabblerNavigationPanel, DabblerTabbedWorkspace, DabblerTopMenuBar, DabblerCatalogPage). DEPRECATED — slated for removal in 0.4.0. New consumers should use MudDataGrid + MudLayout + MudDrawer + MudNavMenu directly via Dabbler.Components.</Description>
    <PackageTags>blazor;mudblazor;dabbler-components;compatibility;deprecated</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="MudBlazor" />
  </ItemGroup>

  <ItemGroup>
    <!-- Compat surface is a value-add overlay, not a replacement (ledger §3.4). -->
    <ProjectReference Include="..\Dabbler.Components\Dabbler.Components.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
