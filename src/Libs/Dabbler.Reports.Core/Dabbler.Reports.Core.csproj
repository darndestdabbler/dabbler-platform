<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- NuGet package metadata -->
    <PackageId>Dabbler.Reports.Core</PackageId>
    <Description>Banded report engine with RDF-based definitions: layout composition, grouping, aggregates, running totals, hide duplicates, subreports, PrintWhen expressions, and CanGrow/CanShrink support.</Description>
    <PackageTags>blazor;reports;rdf;banded-report;layout-engine;aggregates</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591 suppression removed — all public members must have XML docs -->
  </PropertyGroup>

  <!-- No UI references — this project must remain platform-agnostic -->

  <ItemGroup>
    <InternalsVisibleTo Include="Dabbler.Components.Tests" />
    <InternalsVisibleTo Include="Dabbler.Reports.Export" />
  </ItemGroup>

  <!-- Development: use ProjectReference for inner-loop builds -->
  <ItemGroup Condition="'$(PackAsDependency)' != 'true'">
    <ProjectReference Include="..\Dabbler.Components\Dabbler.Components.csproj" />
  </ItemGroup>

  <!-- NuGet pack: use PackageReference so consumers resolve via NuGet -->
  <ItemGroup Condition="'$(PackAsDependency)' == 'true'">
    <PackageReference Include="Dabbler.Components" Version="$(DabblerVersion)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DabblerPdf" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="" />
    <None Include="THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
