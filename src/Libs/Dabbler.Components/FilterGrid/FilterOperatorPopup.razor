@namespace Dabbler.Components

<MudMenu AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" Dense="true">
    <ActivatorContent>
        <MudButton Variant="Variant.Text"
                   Size="Size.Small"
                   Class="dabbler-filter-operator-btn"
                   Disabled="@Disabled"
                   aria-label="@($"Filter operator: {FilterOperatorInfo.GetLabel(CurrentOperator)}")">
            @FilterOperatorInfo.GetAbbreviation(CurrentOperator)
        </MudButton>
    </ActivatorContent>
    <ChildContent>
        @foreach (var op in AvailableOperators)
        {
            <MudMenuItem OnClick="@((MouseEventArgs _) => OnOperatorSelected(op))"
                         Class="@(op == CurrentOperator ? "mud-selected-item" : "")">
                <span class="dabbler-filter-op-abbr">@FilterOperatorInfo.GetAbbreviation(op)</span>
                <span class="dabbler-filter-op-label">@FilterOperatorInfo.GetLabel(op)</span>
            </MudMenuItem>
        }

        @if (ShowDatePresets)
        {
            <MudDivider />
            @foreach (var (preset, label) in DatePresetHelper.All)
            {
                <MudMenuItem OnClick="@((MouseEventArgs _) => OnDatePresetSelected(preset))"
                             Class="@(ActiveDatePreset == preset ? "mud-selected-item" : "")">
                    <span class="dabbler-filter-op-abbr">↔</span>
                    <span class="dabbler-filter-op-label">@label</span>
                </MudMenuItem>
            }
        }
    </ChildContent>
</MudMenu>
