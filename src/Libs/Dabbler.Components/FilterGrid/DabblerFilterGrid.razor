@namespace Dabbler.Components
@inherits DabblerComponentBase
@typeparam T

<div class="dabbler-filter-grid @Class" style="@Style">
    @if (ShowQuickFilter || ShowColumnToggle)
    {
        <div class="dabbler-filter-grid-header">
            @if (ShowQuickFilter)
            {
                <div class="dabbler-quick-filter">
                    <MudTextField T="string"
                                  Value="@_coordinator.QuickFilterText"
                                  ValueChanged="@OnQuickFilterChanged"
                                  Placeholder="@QuickFilterPlaceholder"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  DebounceInterval="@QuickFilterDebounce"
                                  Clearable="true"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Class="dabbler-quick-filter-input"
                                  aria-label="@(QuickFilterPlaceholder ?? "Quick search")" />
                </div>
            }

            @if (ShowColumnToggle)
            {
                <div class="dabbler-column-toggle">
                    <MudMenu AnchorOrigin="Origin.BottomRight"
                             TransformOrigin="Origin.TopRight"
                             Dense="true"
                             aria-label="Toggle column visibility">
                        <ActivatorContent>
                            <MudIconButton Icon="@Icons.Material.Filled.ViewColumn"
                                           Size="Size.Small"
                                           Color="Color.Default"
                                           aria-label="Show/hide columns" />
                        </ActivatorContent>
                        <ChildContent>
                            @foreach (var col in Columns)
                            {
                                var propName = col.PropertyName;
                                <MudMenuItem OnClick="@(() => ToggleColumnAsync(propName))"
                                             AutoClose="false">
                                    <MudCheckBox T="bool"
                                                 Value="@IsColumnVisible(propName)"
                                                 Dense="true"
                                                 ReadOnly="true"
                                                 Style="pointer-events: none">
                                        @(col.Header ?? propName)
                                    </MudCheckBox>
                                </MudMenuItem>
                            }
                        </ChildContent>
                    </MudMenu>
                </div>
            }
        </div>
    }

    <DabblerFilterRowPanel Columns="@EffectiveColumns"
                           Coordinator="@_coordinator"
                           ShowAddOrRow="@ShowAddOrRow"
                           Layout="@Layout"
                           ShowValidation="@_showValidation" />

    @if (ShowExpressionLine)
    {
        <div class="dabbler-expression-line @(_expressionLineOverride is not null ? "dabbler-expression-line-error" : "")">
            @ExpressionLineText
        </div>
    }

    @if (ShowStatusBar)
    {
        <DabblerFilterStatusBar Coordinator="@_coordinator"
                                Columns="@Columns" />
    }

    @* Screen reader live region for filter state announcements *@
    <div aria-live="polite" aria-atomic="true" class="dabbler-sr-only">
        @_filterAnnouncement
    </div>
</div>
