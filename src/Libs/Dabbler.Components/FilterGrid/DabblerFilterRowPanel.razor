@namespace Dabbler.Components

<div class="dabbler-filter-row-panel">
    @{
        var hasMultipleGroups = Coordinator.Groups.Groups.Count > 1;
    }

    @if (!IsVertical && Columns.Count > 0)
    {
        <div class="dabbler-filter-header-wrapper">
            <div class="dabbler-filter-header-row" style="@HeaderGridStyle">
                @foreach (var column in Columns)
                {
                    <div class="dabbler-filter-header-cell"
                         id="@($"filter-header-{column.PropertyName}")"
                         role="columnheader">
                        @(column.Header ?? column.PropertyName)
                        @if (column.IsRequired)
                        {
                            <span class="dabbler-filter-required" aria-hidden="true">*</span>
                            <span class="dabbler-sr-only">(required)</span>
                        }
                    </div>
                }
            </div>
            @if (hasMultipleGroups)
            {
                <div class="dabbler-filter-action-spacer"></div>
            }
        </div>
    }

    @for (int i = 0; i < Coordinator.Groups.Groups.Count; i++)
    {
        var groupIndex = i;

        <div class="dabbler-filter-group-row">
            <DabblerFilterRow Columns="@Columns"
                              GroupIndex="@groupIndex"
                              Coordinator="@Coordinator"
                              Layout="@Layout"
                              ShowValidation="@ShowValidation" />

            @if (hasMultipleGroups)
            {
                <MudIconButton Icon="@Icons.Material.Filled.Close"
                               Size="Size.Small"
                               Class="dabbler-filter-remove-btn"
                               OnClick="@(() => RemoveGroup(groupIndex))"
                               aria-label="Remove filter group" />
            }
        </div>
    }

    @if (ShowAddOrRow)
    {
        <div class="dabbler-filter-add-or">
            <MudButton Variant="Variant.Text"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="@AddOrGroup"
                       Class="dabbler-filter-add-or-btn">
                Add OR filter row
            </MudButton>
        </div>
    }
</div>
