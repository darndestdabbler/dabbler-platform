@namespace Dabbler.Components
@inherits DabblerComponentBase

<nav class="@GetPanelCssClass() @Class"
     style="@(IsCollapsed ? null : $"width: {Width};") @Style"
     @attributes="UserAttributes"
     aria-label="Navigation panel">

    @* ── Collapse toggle ─────────────────────────────────────── *@
    <div class="dabbler-nav-panel-header">
        @if (!IsCollapsed)
        {
            @if (TitleTemplate is not null)
            {
                @TitleTemplate
            }
            else if (!string.IsNullOrEmpty(Title))
            {
                <MudText Typo="Typo.h6" Class="dabbler-nav-panel-title">@Title</MudText>
            }
        }
        <MudIconButton Icon="@(IsCollapsed ? Icons.Material.Filled.ChevronRight : Icons.Material.Filled.ChevronLeft)"
                       Size="Size.Small"
                       OnClick="ToggleCollapseAsync"
                       aria-expanded="@(!IsCollapsed)"
                       aria-label="@(IsCollapsed ? "Expand navigation" : "Collapse navigation")"
                       Class="dabbler-nav-panel-toggle" />
    </div>

    @* ── Collapsed icon strip ────────────────────────────────── *@
    @if (IsCollapsed)
    {
        <div class="dabbler-nav-panel-icons">
            @foreach (var entity in _navigableEntities)
            {
                <MudTooltip Text="@entity.DisplayName" Placement="Placement.Right">
                    <MudIconButton Icon="@(entity.IconName ?? Icons.Material.Filled.List)"
                                   Size="Size.Small"
                                   OnClick="() => HandleEntityClickAsync(entity.EntityName)"
                                   aria-label="@($"Open {entity.DisplayName}")" />
                </MudTooltip>
            }

            @foreach (var reportItem in ReportItems)
            {
                <MudTooltip Text="@reportItem.DisplayName" Placement="Placement.Right">
                    <MudIconButton Icon="@(reportItem.IconName ?? Icons.Material.Filled.Assessment)"
                                   Size="Size.Small"
                                   OnClick="() => HandleReportClickAsync(reportItem.Name)"
                                   aria-label="@($"Open {reportItem.DisplayName}")" />
                </MudTooltip>
            }
        </div>
    }
    else
    {
        @* ── Dual-section layout: entity list + contextual pills ── *@
        <div class="dabbler-nav-panel-content" @ref="_contentRef">

            @* ── Top section: Entity list ────────────────────── *@
            <div class="dabbler-nav-entity-list"
                 style="flex: 0 0 @(SplitPercent.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%">
                <div class="dabbler-nav-entity-search">
                    <MudTextField T="string"
                                  @bind-Value="_entitySearchFilter"
                                  Placeholder="Search entities..."
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Clearable="true"
                                  Immediate="true"
                                  Class="dabbler-nav-entity-search-field" />
                </div>
                <ul class="dabbler-nav-entity-items" role="list">
                    @foreach (var entity in FilteredEntities)
                    {
                        <li class="dabbler-nav-entity-list-item">
                            <button class="dabbler-nav-entity-item @(IsEntityFocused(entity) ? "dabbler-nav-entity-item-active" : "")"
                                    @onclick="() => HandleEntityClickAsync(entity.EntityName)"
                                    aria-label="@($"Open {entity.DisplayName}")"
                                    aria-current="@(IsEntityFocused(entity) ? "true" : null)">
                                @if (!string.IsNullOrEmpty(entity.IconName))
                                {
                                    <MudIcon Icon="@entity.IconName" Size="Size.Small" Class="dabbler-nav-entity-icon" />
                                }
                                <span class="dabbler-nav-entity-name">@entity.DisplayName</span>
                            </button>
                        </li>
                    }
                </ul>

                @if (ReportItems.Count > 0)
                {
                    <div class="dabbler-nav-section-label">Reports</div>
                    <ul class="dabbler-nav-entity-items" role="list">
                        @foreach (var reportItem in ReportItems)
                        {
                            <li class="dabbler-nav-entity-list-item">
                                <button class="dabbler-nav-entity-item"
                                        @onclick="() => HandleReportClickAsync(reportItem.Name)"
                                        aria-label="@($"Open {reportItem.DisplayName}")">
                                    @if (!string.IsNullOrEmpty(reportItem.IconName))
                                    {
                                        <MudIcon Icon="@reportItem.IconName" Size="Size.Small" Class="dabbler-nav-entity-icon" />
                                    }
                                    <span class="dabbler-nav-entity-name">@reportItem.DisplayName</span>
                                </button>
                            </li>
                        }
                    </ul>
                }
            </div>

            @* ── Draggable divider ───────────────────────────── *@
            <div class="dabbler-nav-divider" @ref="_dividerRef"
                 role="separator"
                 aria-orientation="horizontal"
                 aria-label="Resize entity list and context panel">
                <div class="dabbler-nav-divider-handle"></div>
            </div>

            @* ── Bottom section: Contextual pill area ────────── *@
            <div class="dabbler-nav-pill-tree" aria-live="polite" aria-busy="@_isLoadingFilters">
                @if (FocusedEntity is { } focused)
                {
                    <div class="dabbler-nav-pill-tree-header">
                        @if (!string.IsNullOrEmpty(focused.IconName))
                        {
                            <MudIcon Icon="@focused.IconName" Size="Size.Small" Class="mr-1" />
                        }
                        <MudText Typo="Typo.subtitle2" Class="dabbler-nav-pill-tree-title">
                            @focused.DisplayName
                        </MudText>
                    </div>

                    @if (_isLoadingFilters)
                    {
                        <MudProgressLinear Indeterminate="true" Size="Size.Small" Class="mx-2 mb-2" />
                    }
                    else
                    {
                        <div class="dabbler-nav-pill-tree-body">

                            @* ── Own non-relational filters (temporal, audit, custom) ── *@
                            @foreach (var entry in _ownFilters)
                            {
                                <div class="dabbler-nav-filter-group">
                                    <MudText Typo="Typo.caption" Class="dabbler-nav-filter-label">
                                        @entry.Key:
                                    </MudText>
                                    <div class="dabbler-nav-pill-container">
                                        @foreach (var record in entry.Value.Records)
                                        {
                                            <button class="dabbler-nav-pill"
                                                    @onclick="() => HandleRecordClickAsync(focused.EntityName, record.PrimaryKeyValue)"
                                                    aria-label="@record.RecordLabel">
                                                @record.RecordLabel
                                            </button>
                                        }
                                        @if (entry.Value.TotalCount > entry.Value.Records.Count)
                                        {
                                            <button class="dabbler-nav-all-link"
                                                    @onclick="() => HandleSearchClickAsync(focused.EntityName)"
                                                    aria-label="@($"Show all {entry.Value.TotalCount} {focused.DisplayName}")">
                                                all(@entry.Value.TotalCount)
                                            </button>
                                        }
                                    </div>
                                </div>
                            }

                            @* ── Related entity groups (relational pills) ────────── *@
                            @foreach (var group in _relatedGroups)
                            {
                                <div class="dabbler-nav-related-group">
                                    <div class="dabbler-nav-related-header">
                                        @if (!string.IsNullOrEmpty(group.IconName))
                                        {
                                            <MudIcon Icon="@group.IconName" Size="Size.Small" Class="dabbler-nav-related-icon" />
                                        }
                                        <MudText Typo="Typo.caption" Class="dabbler-nav-related-title">
                                            @group.DisplayName
                                        </MudText>
                                    </div>
                                    @foreach (var filterEntry in group.Filters)
                                    {
                                        <div class="dabbler-nav-filter-group">
                                            <MudText Typo="Typo.caption" Class="dabbler-nav-filter-label">
                                                @filterEntry.Key:
                                            </MudText>
                                            <div class="dabbler-nav-pill-container">
                                                @foreach (var record in filterEntry.Value.Records)
                                                {
                                                    <button class="dabbler-nav-pill"
                                                            @onclick="() => HandleRecordClickAsync(group.EntityName, record.PrimaryKeyValue)"
                                                            aria-label="@record.RecordLabel">
                                                        @record.RecordLabel
                                                    </button>
                                                }
                                                @if (filterEntry.Value.TotalCount > filterEntry.Value.Records.Count)
                                                {
                                                    <button class="dabbler-nav-all-link"
                                                            @onclick="() => HandleSearchClickAsync(group.EntityName)"
                                                            aria-label="@($"Show all {filterEntry.Value.TotalCount} {group.DisplayName}")">
                                                        all(@filterEntry.Value.TotalCount)
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }

                        </div>
                    }
                }
                else
                {
                    <div class="dabbler-nav-pill-tree-empty">
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center">
                            Select an entity to see related records
                        </MudText>
                    </div>
                }
            </div>

        </div>
    }
</nav>
