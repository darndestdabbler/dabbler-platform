@namespace Dabbler.Components
@inherits DabblerComponentBase
@using Dabbler.Components.Data.Metadata

<nav class="dabbler-top-menu-bar @Class" style="@Style" @attributes="UserAttributes"
     role="menubar" aria-label="Application menu">

    @* ── App title / logo ─────────────────────────────────────────── *@
    <div class="dabbler-menu-bar-brand">
        @if (AppTitleTemplate is not null)
        {
            @AppTitleTemplate
        }
        else if (!string.IsNullOrEmpty(AppTitle))
        {
            <span class="dabbler-menu-bar-title">@AppTitle</span>
        }
    </div>

    @* ── Desktop menu items ───────────────────────────────────────── *@
    <div class="dabbler-menu-bar-items"
         @onkeydown="HandleMenuBarKeyDownAsync"
         @onkeydown:preventDefault="_preventMenuBarDefault">
        @foreach (var item in MenuItems)
        {
            var type = item.Type;
            var isOpen = _openDropdown == type;
            var menuIndex = Array.IndexOf(MenuItems, item);

            <div class="dabbler-menu-bar-item-wrapper">
                <button class="dabbler-menu-bar-item @(isOpen ? "dabbler-menu-bar-item-open" : "")"
                        id="@($"menu-item-{menuIndex}")"
                        role="menuitem"
                        aria-haspopup="true"
                        aria-expanded="@isOpen"
                        tabindex="@(menuIndex == 0 ? 0 : -1)"
                        @onclick="() => ToggleDropdownAsync(type)">
                    <MudIcon Icon="@item.Icon" Size="Size.Small" />
                    <span>@item.Label</span>
                    <MudIcon Icon="@Icons.Material.Filled.ArrowDropDown" Size="Size.Small"
                             Class="dabbler-menu-bar-chevron" />
                </button>

                @if (isOpen)
                {
                    @* Overlay to capture outside clicks *@
                    <div class="dabbler-menu-bar-overlay" @onclick="CloseDropdown"></div>

                    <div class="dabbler-menu-dropdown" role="menu"
                         aria-label="@item.Label menu">
                        @if (_isDropdownLoading)
                        {
                            <div class="dabbler-menu-dropdown-loading">
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                            </div>
                        }
                        else
                        {
                            @* ── Pinned section ─────────────── *@
                            @if (_pinnedItems.Count > 0)
                            {
                                <div class="dabbler-menu-dropdown-section" role="group"
                                     aria-label="Pinned items">
                                    @foreach (var record in _pinnedItems)
                                    {
                                        var id = record.ArtifactId;
                                        var name = GetDisplayName(record);
                                        <button class="dabbler-menu-dropdown-item dabbler-menu-item-pinned"
                                                role="menuitem"
                                                @onclick="() => HandleArtifactClickAsync(type, id, name)">
                                            <MudIcon Icon="@Icons.Material.Filled.Star"
                                                     Size="Size.Small"
                                                     Class="dabbler-menu-item-icon" />
                                            <span class="dabbler-menu-item-label">@name</span>
                                        </button>
                                    }
                                </div>
                            }

                            @* ── Recent/frequent section ────── *@
                            @if (_recentItems.Count > 0)
                            {
                                @if (_pinnedItems.Count > 0)
                                {
                                    <div class="dabbler-menu-dropdown-divider" role="separator"></div>
                                }
                                <div class="dabbler-menu-dropdown-section" role="group"
                                     aria-label="Recently used items">
                                    @foreach (var record in _recentItems)
                                    {
                                        var id = record.ArtifactId;
                                        var name = GetDisplayName(record);
                                        <button class="dabbler-menu-dropdown-item dabbler-menu-item-recent"
                                                role="menuitem"
                                                @onclick="() => HandleArtifactClickAsync(type, id, name)">
                                            <MudIcon Icon="@Icons.Material.Outlined.History"
                                                     Size="Size.Small"
                                                     Class="dabbler-menu-item-icon" />
                                            <span class="dabbler-menu-item-label">@name</span>
                                        </button>
                                    }
                                </div>
                            }

                            @* ── Empty state: all items alphabetically *@
                            @if (!HasUsageData && _allItems.Count > 0)
                            {
                                <div class="dabbler-menu-dropdown-section" role="group"
                                     aria-label="All items">
                                    @foreach (var entry in _allItems.Take(10))
                                    {
                                        var id = entry.ArtifactId;
                                        var name = entry.Name;
                                        <button class="dabbler-menu-dropdown-item"
                                                role="menuitem"
                                                @onclick="() => HandleArtifactClickAsync(type, id, name)">
                                            <span class="dabbler-menu-item-label">@name</span>
                                        </button>
                                    }
                                </div>
                            }

                            @* ── "All [Type]" link ─────────── *@
                            <div class="dabbler-menu-dropdown-divider" role="separator"></div>
                            <button class="dabbler-menu-dropdown-item dabbler-menu-item-catalog"
                                    role="menuitem"
                                    @onclick="() => HandleCatalogClickAsync(type)">
                                <span class="dabbler-menu-item-label">All @item.Label</span>
                                <MudIcon Icon="@Icons.Material.Filled.ArrowForward"
                                         Size="Size.Small"
                                         Class="dabbler-menu-item-icon" />
                            </button>
                        }
                    </div>
                }
            </div>
        }
    </div>

    @* ── Hamburger menu (narrow screens) ──────────────────────────── *@
    <div class="dabbler-menu-bar-hamburger">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Size="Size.Small"
                       OnClick="ToggleHamburger"
                       aria-label="Open menu"
                       aria-expanded="@_isHamburgerOpen" />

        @if (_isHamburgerOpen)
        {
            <div class="dabbler-menu-bar-overlay" @onclick="CloseDropdown"></div>

            <div class="dabbler-menu-hamburger-panel" role="menu">
                @foreach (var item in MenuItems)
                {
                    var type = item.Type;
                    <button class="dabbler-menu-hamburger-item"
                            role="menuitem"
                            @onclick="() => ToggleDropdownAsync(type)">
                        <MudIcon Icon="@item.Icon" Size="Size.Small" />
                        <span>@item.Label</span>
                    </button>
                }
            </div>
        }
    </div>

    @* ── Right-side placeholder (user profile, settings, etc.) ──── *@
    <div class="dabbler-menu-bar-trailing">
        @if (TrailingContent is not null)
        {
            @TrailingContent
        }
    </div>

</nav>
