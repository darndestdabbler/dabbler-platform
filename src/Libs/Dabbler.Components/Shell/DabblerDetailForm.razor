@namespace Dabbler.Components
@inherits DabblerComponentBase
@typeparam T where T : class, new()
@using Dabbler.Components.Data.Metadata

<div class="@GetFormCssClass()" style="@Style" @attributes="UserAttributes">

    @* ── Toolbar ──────────────────────────────────────────────── *@
    <DabblerPageToolbar StatusText="@(IsNew ? "New record" : null)"
                        IsLoading="false">
        <ActionButtons>
            <MudButton StartIcon="@Icons.Material.Filled.Save"
                       Color="Color.Primary"
                       Variant="Variant.Filled"
                       Size="Size.Small"
                       Disabled="@(IsReadOnly || !_isDirty)"
                       OnClick="HandleSaveClickAsync"
                       aria-label="Save">
                Save
            </MudButton>
            <MudButton StartIcon="@Icons.Material.Filled.Undo"
                       Color="Color.Default"
                       Variant="Variant.Text"
                       Size="Size.Small"
                       Disabled="@(IsReadOnly || !_isDirty)"
                       OnClick="HandleUndoClick"
                       aria-label="Undo all changes">
                Undo
            </MudButton>
            @if (!IsNew)
            {
                <MudButton StartIcon="@Icons.Material.Filled.Delete"
                           Color="Color.Error"
                           Variant="Variant.Text"
                           Size="Size.Small"
                           Disabled="@IsReadOnly"
                           OnClick="HandleDeleteClickAsync"
                           aria-label="Delete record">
                    Delete
                </MudButton>
            }
            @if (ToolbarTemplate is not null)
            {
                @ToolbarTemplate
            }
        </ActionButtons>
    </DabblerPageToolbar>

    @* ── Parent fields ────────────────────────────────────────── *@
    <fieldset class="dabbler-detail-form-fieldset">
        <legend class="dabbler-sr-only">@(EntityMetadata?.DisplayNameSingular ?? "Record") fields</legend>
        <div class="dabbler-detail-form-fields"
             style="--dabbler-form-columns: @FormColumns;">
            @{
                var fields = GetDetailFieldMetadata();
            }
            @foreach (var field in fields)
            {
                <div class="dabbler-detail-form-field"
                     style="@(field.DetailFormColumn.HasValue ? $"grid-column: {field.DetailFormColumn.Value + 1}" : null)">

                    @if (FieldTemplate is not null)
                    {
                        @FieldTemplate(field)
                    }
                    else
                    {
                        @RenderFieldEditor(field)
                    }
                    @if (GetFieldValidationError(field.FieldName) is { } errorMsg)
                    {
                        <span id="@($"field-error-{field.FieldName}")"
                              class="dabbler-sr-only"
                              role="alert">@errorMsg</span>
                    }
                </div>
            }
        </div>
    </fieldset>

    @* ── Child relationship tabs ──────────────────────────────── *@
    @{
        var childRelationships = GetVisibleChildRelationships();
    }
    @if (childRelationships.Count > 0 && !IsNew)
    {
        <div class="dabbler-detail-form-children" role="region" aria-label="Child relationships">
            <MudTabs ActivePanelIndexChanged="async (index) => { if (index >= 0 && index < childRelationships.Count) await HandleChildTabChangedAsync(childRelationships[index].RelationshipName); }"
                     Elevation="0"
                     Rounded="true"
                     ApplyEffectsToContainer="true"
                     PanelClass="dabbler-detail-form-child-panel">
                @foreach (var rel in childRelationships)
                {
                    <MudTabPanel Text="@rel.RelationshipName"
                                 ID="@rel.RelationshipName"
                                 aria-label="@($"Child tab: {rel.RelationshipName}")">
                        @if (IsChildTabLoaded(rel.RelationshipName) || rel.RelationshipName == _activeChildTabId)
                        {
                            <div class="dabbler-detail-form-child-toolbar">
                                @if (rel.IsJunctionEntity)
                                {
                                    <MudButton StartIcon="@Icons.Material.Filled.Add"
                                               Size="Size.Small"
                                               Variant="Variant.Text"
                                               Color="Color.Primary"
                                               Disabled="@IsReadOnly"
                                               OnClick="() => HandleM2MAddClickAsync(rel)"
                                               aria-label="@($"Add {rel.RelationshipName}")">
                                        Add
                                    </MudButton>
                                    <MudButton StartIcon="@Icons.Material.Filled.Delete"
                                               Size="Size.Small"
                                               Variant="Variant.Text"
                                               Color="Color.Error"
                                               Disabled="@(IsReadOnly || !_selectedChildRowIndex.ContainsKey(rel.RelationshipName))"
                                               OnClick="() => HandleM2MDeleteClickAsync(rel)"
                                               aria-label="@($"Delete selected {rel.RelationshipName}")">
                                        Delete
                                    </MudButton>
                                }
                                else
                                {
                                    <MudButton StartIcon="@Icons.Material.Filled.Add"
                                               Size="Size.Small"
                                               Variant="Variant.Text"
                                               Color="Color.Primary"
                                               Disabled="@IsReadOnly"
                                               OnClick="() => HandleChildAddClickAsync(rel)"
                                               aria-label="@($"Add {rel.RelationshipName}")">
                                        Add
                                    </MudButton>
                                    <MudButton StartIcon="@Icons.Material.Filled.Delete"
                                               Size="Size.Small"
                                               Variant="Variant.Text"
                                               Color="Color.Error"
                                               Disabled="@(IsReadOnly || !_selectedChildRowIndex.ContainsKey(rel.RelationshipName))"
                                               OnClick="() => HandleChildDeleteClickAsync(rel)"
                                               aria-label="@($"Delete selected {rel.RelationshipName}")">
                                        Delete
                                    </MudButton>
                                }
                            </div>
                            <div class="dabbler-detail-form-child-grid"
                                 aria-live="polite"
                                 aria-busy="@(_childGridLoading.TryGetValue(rel.RelationshipName, out var isBusy) && isBusy)">
                                @if (_childGridLoading.TryGetValue(rel.RelationshipName, out var isLoading) && isLoading)
                                {
                                    <MudProgressLinear Indeterminate="true" Size="Size.Small" />
                                }
                                else if (rel.IsJunctionEntity)
                                {
                                    @RenderMergedViewGrid(rel)
                                }
                                else
                                {
                                    @RenderStandardChildGrid(rel)
                                }
                            </div>
                        }
                        else
                        {
                            <div class="dabbler-detail-form-child-loading">
                                <MudProgressLinear Indeterminate="true" Size="Size.Small" />
                            </div>
                        }
                    </MudTabPanel>
                }
            </MudTabs>
        </div>
    }

    @* ── M:M Add dialog ──────────────────────────────────────── *@
    <MudDialog @bind-Visible="_showM2MAddDialog" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true })">
        <TitleContent>
            <MudText Typo="Typo.h6">Add @(_m2mAddRelationship?.RelationshipName)</MudText>
        </TitleContent>
        <DialogContent>
            @if (_m2mAddRelationship is not null && _m2mFarSideItems is not null)
            {
                <div class="dabbler-m2m-add-form">
                    <MudSelect T="NavigationRecord"
                               @bind-Value="_m2mSelectedFarSideRecord"
                               Label="@(_m2mAddRelationship.FarSideEntityName ?? "Select")"
                               ToStringFunc="@(r => r?.RecordLabel ?? "")"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Required="true"
                               AnchorOrigin="Origin.BottomCenter"
                               TransformOrigin="Origin.TopCenter">
                        @foreach (var item in _m2mFarSideItems)
                        {
                            <MudSelectItem Value="@item">@item.RecordLabel</MudSelectItem>
                        }
                    </MudSelect>

                    @{
                        var junctionFields = GetJunctionEditableFields(_m2mAddRelationship);
                    }
                    @foreach (var field in junctionFields)
                    {
                        var fieldName = field.FieldName;
                        <MudTextField T="string"
                                      Label="@field.DisplayLabel"
                                      Value="@GetM2MJunctionFieldValue(fieldName)"
                                      ValueChanged="@((string val) => SetM2MJunctionFieldValue(fieldName, val))"
                                      Required="@field.IsRequired"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense" />
                    }
                </div>
            }
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="HandleM2MAddCancel">Cancel</MudButton>
            <MudButton Color="Color.Primary"
                       Variant="Variant.Filled"
                       Disabled="@(_m2mSelectedFarSideRecord is null)"
                       OnClick="HandleM2MAddConfirmAsync">
                Add
            </MudButton>
        </DialogActions>
    </MudDialog>
</div>

@code {
    private RenderFragment RenderMergedViewGrid(ChildRelationshipMetadata rel) => __builder =>
    {
        var columns = GetMergedViewColumns(rel);
        var rows = _childGridData.TryGetValue(rel.RelationshipName, out var data)
            ? data
            : Array.Empty<Dictionary<string, object?>>();

        if (rows.Count == 0)
        {
            <MudText Typo="Typo.body2" Color="Color.Tertiary" Class="pa-4">
                No records found.
            </MudText>
        }
        else
        {
            <MudSimpleTable Dense="true" Hover="true" Striped="true" Class="dabbler-m2m-grid">
                <thead>
                    <tr>
                        @foreach (var col in columns)
                        {
                            <th>@col.DisplayLabel</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < rows.Count; i++)
                    {
                        var rowIndex = i;
                        var row = rows[rowIndex];
                        <tr class="@(IsChildRowSelected(rel.RelationshipName, rowIndex) ? "mud-selected-item" : "")"
                            @onclick="() => HandleChildRowClick(rel.RelationshipName, rowIndex)"
                            style="cursor: pointer;">
                            @foreach (var col in columns)
                            {
                                <td>@FormatCellValue(row.GetValueOrDefault(col.FieldName))</td>
                            }
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
    };

    private RenderFragment RenderStandardChildGrid(ChildRelationshipMetadata rel) => __builder =>
    {
        var rows = _childGridData.TryGetValue(rel.RelationshipName, out var data) ? data : null;

        if (rows is null && ChildDataFactory is null)
        {
            <MudText Typo="Typo.body2" Color="Color.Tertiary" Class="pa-4">
                1:M grid for @rel.RelationshipName filtered by @rel.ForeignKeyField
            </MudText>
        }
        else if (rows is null || rows.Count == 0)
        {
            <MudText Typo="Typo.body2" Color="Color.Tertiary" Class="pa-4">
                No records found.
            </MudText>
        }
        else
        {
            var childColumns = GetChildEntityColumns(rel);
            <MudSimpleTable Dense="true" Hover="true" Striped="true">
                <thead>
                    <tr>
                        @foreach (var col in childColumns)
                        {
                            <th>@col.DisplayLabel</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < rows.Count; i++)
                    {
                        var rowIndex = i;
                        var row = rows[rowIndex];
                        <tr class="@(IsChildRowSelected(rel.RelationshipName, rowIndex) ? "mud-selected-item" : "")"
                            @onclick="() => HandleChildRowClick(rel.RelationshipName, rowIndex)"
                            style="cursor: pointer;">
                            @foreach (var col in childColumns)
                            {
                                <td>@FormatCellValue(row.GetValueOrDefault(col.FieldName))</td>
                            }
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
    };

    private RenderFragment RenderFieldEditor(FieldMetadata field) => __builder =>
    {
        var editorType = ResolveEditorType(field);
        var readOnly = IsFieldReadOnly(field);

        var hasError = GetFieldValidationError(field.FieldName) is not null;
        var errorId = hasError ? $"field-error-{field.FieldName}" : null;

        switch (editorType)
        {
            case "text":
                <MudTextField T="string"
                              Label="@field.DisplayLabel"
                              Value="@GetFieldStringValue(field.FieldName)"
                              ValueChanged="(v) => HandleFieldChangedAsync(field.FieldName, v)"
                              ReadOnly="@readOnly"
                              Required="@field.IsRequired"
                              RequiredError="@($"{field.DisplayLabel} is required")"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              aria-required="@(field.IsRequired ? "true" : null)"
                              aria-readonly="@(readOnly ? "true" : null)"
                              aria-invalid="@(hasError ? "true" : null)"
                              aria-describedby="@errorId" />
                break;

            case "numeric":
                <MudTextField T="string"
                              Label="@field.DisplayLabel"
                              Value="@GetFieldStringValue(field.FieldName)"
                              ValueChanged="(v) => HandleNumericFieldChangedAsync(field, v)"
                              ReadOnly="@readOnly"
                              Required="@field.IsRequired"
                              RequiredError="@($"{field.DisplayLabel} is required")"
                              InputType="InputType.Number"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              aria-required="@(field.IsRequired ? "true" : null)"
                              aria-readonly="@(readOnly ? "true" : null)"
                              aria-invalid="@(hasError ? "true" : null)"
                              aria-describedby="@errorId" />
                break;

            case "date":
                <MudDatePicker Label="@field.DisplayLabel"
                               Date="@GetDateValue(field.FieldName)"
                               DateChanged="(v) => HandleFieldChangedAsync(field.FieldName, v)"
                               ReadOnly="@readOnly"
                               Required="@field.IsRequired"
                               RequiredError="@($"{field.DisplayLabel} is required")"
                               DateFormat="@(field.FormatString ?? "yyyy-MM-dd")"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               aria-required="@(field.IsRequired ? "true" : null)" />
                break;

            case "checkbox":
                <MudCheckBox T="bool"
                             Label="@field.DisplayLabel"
                             Value="@GetBoolValue(field.FieldName)"
                             ValueChanged="(v) => HandleFieldChangedAsync(field.FieldName, v)"
                             ReadOnly="@readOnly"
                             Color="Color.Primary" />
                break;

            case "combobox":
                @* FK fields render as text fields for now; DabblerComboBox wiring deferred to shell integration *@
                <MudTextField T="string"
                              Label="@($"{field.DisplayLabel} (FK: {field.ForeignKeyEntity})")"
                              Value="@GetFieldStringValue(field.FieldName)"
                              ValueChanged="(v) => HandleFieldChangedAsync(field.FieldName, v)"
                              ReadOnly="@readOnly"
                              Required="@field.IsRequired"
                              RequiredError="@($"{field.DisplayLabel} is required")"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Adornment="Adornment.End"
                              AdornmentIcon="@Icons.Material.Filled.ArrowDropDown"
                              aria-required="@(field.IsRequired ? "true" : null)" />
                break;

            default:
                <MudTextField T="string"
                              Label="@field.DisplayLabel"
                              Value="@GetFieldStringValue(field.FieldName)"
                              ValueChanged="(v) => HandleFieldChangedAsync(field.FieldName, v)"
                              ReadOnly="@readOnly"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />
                break;
        }
    };

    private DateTime? GetDateValue(string fieldName)
    {
        var value = GetFieldValue(fieldName);
        return value is DateTime dt ? dt : null;
    }

    private bool GetBoolValue(string fieldName)
    {
        var value = GetFieldValue(fieldName);
        return value is bool b && b;
    }

    private async Task HandleNumericFieldChangedAsync(FieldMetadata field, string? textValue)
    {
        if (string.IsNullOrWhiteSpace(textValue))
        {
            await HandleFieldChangedAsync(field.FieldName, null);
            return;
        }

        object? converted = field.DataType.ToLowerInvariant() switch
        {
            "int" or "int32" => int.TryParse(textValue, out var i) ? i : null,
            "int64" or "long" => long.TryParse(textValue, out var l) ? l : null,
            "decimal" => decimal.TryParse(textValue, out var d) ? d : null,
            "double" => double.TryParse(textValue, out var dbl) ? dbl : null,
            "float" or "single" => float.TryParse(textValue, out var f) ? f : null,
            _ => null
        };

        if (converted is not null)
        {
            await HandleFieldChangedAsync(field.FieldName, converted);
        }
    }
}
