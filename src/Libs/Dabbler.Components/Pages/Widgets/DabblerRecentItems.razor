@namespace Dabbler.Components
@inherits DabblerComponentBase
@using Dabbler.Components.Data.Metadata

<div class="dabbler-widget-recent @Class" style="@Style" @attributes="UserAttributes">
    <MudText Typo="Typo.subtitle2" Class="dabbler-widget-recent-title">Recent Items</MudText>

    @if (_isLoading)
    {
        <div class="dabbler-widget-loading">
            <MudProgressCircular Size="Size.Small" Indeterminate="true" />
        </div>
    }
    else if (_items.Count == 0)
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="dabbler-widget-recent-empty">
            No recent items.
        </MudText>
    }
    else
    {
        <div class="dabbler-widget-recent-list">
            @foreach (var item in _items)
            {
                <button class="dabbler-widget-recent-item"
                        @onclick="() => OnItemClick.InvokeAsync(item)"
                        aria-label="@item.ArtifactId">
                    <MudIcon Icon="@GetArtifactIcon(item.ArtifactType)"
                             Size="Size.Small"
                             Class="dabbler-widget-recent-icon" />
                    <span class="dabbler-widget-recent-label">@item.ArtifactId</span>
                    <span class="dabbler-widget-recent-type">@item.ArtifactType</span>
                </button>
            }
        </div>
    }
</div>
