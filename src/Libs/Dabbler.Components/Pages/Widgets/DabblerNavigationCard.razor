@namespace Dabbler.Components
@inherits DabblerComponentBase

<button class="dabbler-widget-card @Class"
        style="@CardStyle"
        @onclick="OnClick"
        @attributes="UserAttributes"
        role="link"
        aria-label="@Label">
    @if (!string.IsNullOrEmpty(Icon))
    {
        <MudIcon Icon="@Icon" Size="Size.Large" Class="dabbler-widget-card-icon" />
    }
    <span class="dabbler-widget-card-label">@Label</span>
    @if (!string.IsNullOrWhiteSpace(Subtitle))
    {
        <span class="dabbler-widget-card-subtitle">@Subtitle</span>
    }
    @if (!string.IsNullOrWhiteSpace(BadgeText))
    {
        <span class="dabbler-widget-card-badge">@BadgeText</span>
    }
</button>
