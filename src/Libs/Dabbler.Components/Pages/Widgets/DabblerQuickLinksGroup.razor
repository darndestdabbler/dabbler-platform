@namespace Dabbler.Components
@inherits DabblerComponentBase

<div class="dabbler-widget-links @Class" style="@Style" @attributes="UserAttributes">
    @if (!string.IsNullOrWhiteSpace(Title))
    {
        <MudText Typo="Typo.subtitle2" Class="dabbler-widget-links-title">@Title</MudText>
    }

    <div class="dabbler-widget-links-list">
        @foreach (var link in Links)
        {
            <button class="dabbler-widget-links-item"
                    @onclick="() => OnLinkClick.InvokeAsync(link)"
                    aria-label="@link.Label">
                <MudIcon Icon="@Icons.Material.Filled.ChevronRight"
                         Size="Size.Small"
                         Class="dabbler-widget-links-icon" />
                <span>@link.Label</span>
            </button>
        }
    </div>

    @if (Links.Count == 0)
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="dabbler-widget-links-empty">
            No links configured.
        </MudText>
    }
</div>
