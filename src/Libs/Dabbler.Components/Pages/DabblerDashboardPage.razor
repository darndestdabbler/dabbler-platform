@namespace Dabbler.Components
@inherits DabblerComponentBase
@using Dabbler.Components.Data.Metadata

<div class="dabbler-dashboard-page @Class" style="@Style" @attributes="UserAttributes"
     role="region" aria-label="@(Configuration?.Name ?? "Dashboard")">

    @if (Configuration is null)
    {
        <div class="dabbler-dashboard-empty">
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                No dashboard configured.
            </MudText>
        </div>
    }
    else
    {
        <div class="dabbler-dashboard-header">
            <MudText Typo="Typo.h6">@Configuration.Name</MudText>
            @if (!string.IsNullOrWhiteSpace(Configuration.Description))
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    @Configuration.Description
                </MudText>
            }
        </div>

        <div class="dabbler-dashboard-grid"
             style="grid-template-columns: repeat(@Configuration.ColumnCount, 1fr);">
            @foreach (var widget in Configuration.Widgets.OrderBy(w => w.GridRow).ThenBy(w => w.GridColumn).ThenBy(w => w.SortOrder))
            {
                <div class="dabbler-dashboard-cell"
                     style="grid-row: @widget.GridRow / span @widget.RowSpan; grid-column: @widget.GridColumn / span @widget.ColSpan;">
                    @RenderWidget(widget)
                </div>
            }
        </div>
    }
</div>
