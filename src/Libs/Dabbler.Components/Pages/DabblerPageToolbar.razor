@namespace Dabbler.Components
@inherits DabblerComponentBase

<div class="dabbler-page-toolbar @Class" style="@Style" @attributes="UserAttributes">
    <div class="dabbler-page-toolbar-left">
        @if (IsLoading)
        {
            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
        }
        @if (!string.IsNullOrEmpty(StatusText))
        {
            <MudText Typo="Typo.body2" Class="dabbler-page-toolbar-status"
                     aria-live="polite" aria-busy="@IsLoading">
                @StatusText
            </MudText>
        }
    </div>

    @if (ChildContent is not null)
    {
        <div class="dabbler-page-toolbar-center">
            @ChildContent
        </div>
    }

    @if (ActionButtons is not null)
    {
        <div class="dabbler-page-toolbar-right">
            @ActionButtons
        </div>
    }
</div>
