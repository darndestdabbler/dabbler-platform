@namespace Dabbler.Components
@inherits DabblerComponentBase
@typeparam T
@using Dabbler.Components.Data
@using Dabbler.Reports.Core.Rdf
@using Dabbler.Reports.Blazor
@using MudBlazor

@* Compatibility stub — pending Session 5 rebuild on MudBlazor-native patterns. *@
<div class="@Class" style="@Style" @attributes="UserAttributes"
     role="region" aria-label="@(Title ?? "Query and report")">
    @if (!string.IsNullOrEmpty(Title))
    {
        <MudText Typo="Typo.h6" Class="mb-2">@Title</MudText>
    }

    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error"
                  Variant="Variant.Filled"
                  ShowCloseIcon="true"
                  CloseIconClicked="@(() => { _error = null; StateHasChanged(); })"
                  Class="mb-2">
            @_error.Message
        </MudAlert>
    }

    @if (_currentView == PageViewMode.Grid)
    {
        <MudDataGrid T="T" @ref="_mudDataGrid"
                     ServerData="@ServerDataFuncAsync"
                     Dense="@Dense"
                     Hover="true"
                     RowsPerPage="@PageSize"
                     ReadOnly="@(!Editable)"
                     Loading="@_isLoading">
            <Columns>
                @GridColumns
            </Columns>
            <PagerContent>
                <MudDataGridPager T="T" />
            </PagerContent>
        </MudDataGrid>
    }
    else
    {
        @if (_isLoading && !_reportHasRun)
        {
            <MudProgressCircular Indeterminate="true" />
        }
        else if (!_reportHasRun)
        {
            <MudText Typo="Typo.body1">
                Switch to Report view to generate a report.
            </MudText>
        }
        else if (_reportPages is not null)
        {
            <ReportViewer @ref="_viewer"
                          Pages="@_reportPages"
                          Report="@_reportDefinition"
                          Scale="@_scale" />
        }
    }
</div>
