@namespace Dabbler.Components
@using Dabbler.Reports.Core.Rdf
@using Dabbler.Reports.Blazor
@using MudBlazor

<div role="region" aria-label="@(Title ?? _reportDefinition?.Metadata?.Name ?? "Report")">
    @if (HeaderTemplate is not null)
    {
        @HeaderTemplate
    }
    else if (!string.IsNullOrEmpty(Title ?? _reportDefinition?.Metadata?.Name))
    {
        <MudText Typo="Typo.h6" Class="mb-2">@(Title ?? _reportDefinition?.Metadata?.Name)</MudText>
    }

    @if (_rdfErrors is not null)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-2">
            <MudText Typo="Typo.subtitle2" Class="mb-2">Report definition errors:</MudText>
            @foreach (var err in _rdfErrors)
            {
                <div>@err</div>
            }
        </MudAlert>
    }
    else if (_reportDefinition is not null)
    {
        @if (_reportDefinition.Parameters.Count > 0)
        {
            @if (_parametersCollapsed)
            {
                <MudPaper Class="pa-3 mb-2" Elevation="1">
                    <div class="d-flex align-center gap-2">
                        <MudText Typo="Typo.body2">
                            @_parameterSummary
                        </MudText>
                        <MudLink OnClick="@ExpandParametersAsync" Typo="Typo.body2">
                            Change Parameters
                        </MudLink>
                    </div>
                </MudPaper>
            }
            else
            {
                <ParameterPromptForm @ref="_parameterForm"
                                     Parameters="@_reportDefinition.Parameters"
                                     DataProvider="@DataProvider"
                                     InitialValues="@InitialParameterValues"
                                     IsLoading="@_isLoading"
                                     OnRunReport="@OnRunReportAsync" />
            }
        }
        else if (!_hasRun && !AutoRunOnLoad)
        {
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Disabled="@_isLoading"
                       OnClick="@RunReportAsync">
                @if (_isLoading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                Run Report
            </MudButton>
        }

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error"
                      Variant="Variant.Filled"
                      ShowCloseIcon="true"
                      CloseIconClicked="@DismissErrorAsync"
                      Class="mb-2"
                      role="alert">
                @_error.Message
            </MudAlert>
        }

        <div class="d-flex align-center gap-2 my-2">
            @if (_isLoading)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            @if (!string.IsNullOrEmpty(_statusText))
            {
                <MudText Typo="Typo.body2"
                         data-testid="report-page-count"
                         data-page-count="@_pages?.Count"
                         aria-live="polite"
                         aria-busy="@_isLoading">
                    @_statusText
                </MudText>
            }
            @if (ToolbarTemplate is not null)
            {
                @ToolbarTemplate
            }
            <MudSpacer />
            @if (ShowZoom)
            {
                <MudIconButton Icon="@Icons.Material.Filled.ZoomOut"
                               Size="Size.Small"
                               OnClick="@ZoomOutAsync"
                               Disabled="@(_scale <= 0.25)"
                               aria-label="Zoom out" />
                <MudText Typo="Typo.body2" Class="mx-1"
                         style="min-width:40px;text-align:center;user-select:none;"
                         aria-live="polite"
                         aria-label="@($"Zoom level: {ZoomPercentText}")">
                    @ZoomPercentText
                </MudText>
                <MudIconButton Icon="@Icons.Material.Filled.ZoomIn"
                               Size="Size.Small"
                               OnClick="@ZoomInAsync"
                               Disabled="@(_scale >= 3.0)"
                               aria-label="Zoom in" />
            }
            @if (ShowPdfExport)
            {
                <MudIconButton Icon="@Icons.Material.Filled.PictureAsPdf"
                               Size="Size.Small"
                               OnClick="@ExportToPdfAsync"
                               Disabled="@(!_hasRun || _isLoading)"
                               aria-label="Export to PDF" />
            }
            @if (ShowPrint)
            {
                <MudIconButton Icon="@Icons.Material.Filled.Print"
                               Size="Size.Small"
                               OnClick="@PrintAsync"
                               Disabled="@(!_hasRun || _isLoading)"
                               aria-label="Print" />
            }
        </div>

        <div aria-live="polite" aria-busy="@_isLoading">
            @if (_isLoading && !_hasRun)
            {
                <div class="d-flex justify-center pa-8">
                    <MudProgressCircular Indeterminate="true" />
                </div>
            }
            else if (!_hasRun)
            {
                @if (EmptyStateTemplate is not null)
                {
                    @EmptyStateTemplate
                }
                else
                {
                    <MudText Typo="Typo.body1" Class="pa-4" Align="Align.Center">
                        Set parameters and click "Run Report" to generate the report.
                    </MudText>
                }
            }
            else if (_pages is not null)
            {
                <ReportViewer @ref="_viewer"
                              Pages="@_pages"
                              Report="@_reportDefinition"
                              Scale="@_scale" />
            }
        </div>
    }

    @if (FooterTemplate is not null)
    {
        @FooterTemplate
    }
</div>
