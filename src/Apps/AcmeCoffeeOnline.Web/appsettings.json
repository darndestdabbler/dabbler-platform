{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ApiBaseUrl": "https://localhost:7001",
  "DabblerAssets": {
    "Styles": [
      {
        "AssetId": "dabbler-shell.css",
        "Href": "_content/Dabbler.Components/dabbler-shell.css"
      },
      {
        "AssetId": "dabbler-pages.css",
        "Href": "_content/Dabbler.Components/dabbler-pages.css"
      }
    ]
  },
  "Authentication": {
    "DeliveryMode": "MagicLink",
    "SeededSession": {
      "Enabled": false,
      "SharedSecret": "",
      "AllowedRoles": []
    }
  },
  "DabblerSecurity": {
    "InternalApiKey": "dev-internal-key-acme"
  }
}
