{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "DabblerAssets": {
    "RequiredStyleAssets": [
      "css/dabbler-foundation.css"
    ]
  },
  "Authentication": {
    "DeliveryMode": "MagicLink",
    "SeededSession": {
      "Enabled": false,
      "SharedSecret": "",
      "AllowedRoles": [
        "OperationsViewer",
        "CoffeeAdmin",
        "SystemAdministrator"
      ]
    }
  },
  "Services": {
    "ApiBaseUrl": "http://localhost:5011"
  },
  "AllowedHosts": "*"
}
