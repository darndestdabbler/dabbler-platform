@using AcmeCoffeeOnline.Web.StubMode
@using Dabbler.Components.Data
@using Dabbler.Platform.Stubs
@using System.Linq.Expressions
@inject StubGridDataProvider<StubCustomerRow> DataProvider

<DabblerQueryPage T="StubCustomerRow"
                  Title="Stub Retail Businesses"
                  FilterColumns="@FilterColumns"
                  GridColumns="@BuildGridColumns()"
                  DataProvider="DataProvider"
                  AutoLoadOnFilterChange="false" />

@code {
    private static IReadOnlyList<FilterColumnDefinition> FilterColumns =>
    [
        new()
        {
            Header = "Name",
            PropertyName = nameof(StubCustomerRow.Name),
            EditorType = FilterEditorType.Text,
            DefaultOperator = FilterOperators.Contains,
            ShowOperator = false
        },
        new()
        {
            Header = "City",
            PropertyName = nameof(StubCustomerRow.City),
            EditorType = FilterEditorType.Text,
            DefaultOperator = FilterOperators.Contains,
            ShowOperator = false
        }
    ];

    private static RenderFragment BuildGridColumns() => builder =>
    {
        builder.OpenComponent<PropertyColumn<StubCustomerRow, string>>(0);
        builder.AddAttribute(1, "Property", NameProperty);
        builder.AddAttribute(2, "Title", "Retail Business");
        builder.CloseComponent();

        builder.OpenComponent<PropertyColumn<StubCustomerRow, string>>(3);
        builder.AddAttribute(4, "Property", CityProperty);
        builder.AddAttribute(5, "Title", "City");
        builder.CloseComponent();

        builder.OpenComponent<PropertyColumn<StubCustomerRow, string>>(6);
        builder.AddAttribute(7, "Property", TierProperty);
        builder.AddAttribute(8, "Title", "Tier");
        builder.CloseComponent();
    };

    private static readonly Expression<Func<StubCustomerRow, string>> NameProperty = row => row.Name;
    private static readonly Expression<Func<StubCustomerRow, string>> CityProperty = row => row.City;
    private static readonly Expression<Func<StubCustomerRow, string>> TierProperty = row => row.Tier;
}
