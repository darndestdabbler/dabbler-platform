@page "/admin/users"
@attribute [DabblerPageAuthorize("/admin/users")]
@using Dabbler.Security.Data
@using Dabbler.Security.Services
@using Microsoft.EntityFrameworkCore
@inject DabblerSecurityDbContext SecurityDb
@inject IUserRoleStore UserRoleStore
@inject ISnackbar Snackbar

<PageTitle>User Administration — AcmeCoffeeOnline</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">User Administration</MudText>

<MudTabs Elevation="1" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4" @bind-ActivePanelIndex="_activeTab">
    <MudTabPanel Text="Users" Icon="@Icons.Material.Filled.People">
        @if (_loadingUsers)
        {
            <MudProgressCircular Indeterminate="true" Size="Size.Large" Class="d-flex mx-auto my-8" />
        }
        else
        {
            <MudDataGrid T="UserRow" Items="_users" Filterable="true" SortMode="SortMode.Single"
                         Dense="true" Hover="true" Striped="true">
                <Columns>
                    <PropertyColumn Property="x => x.DisplayName" Title="Name" />
                    <PropertyColumn Property="x => x.Email" Title="Email" />
                    <PropertyColumn Property="x => x.Roles" Title="Roles" />
                    <PropertyColumn Property="x => x.IsActive" Title="Active">
                        <CellTemplate>
                            <MudIcon Icon="@(context.Item.IsActive ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Cancel)"
                                     Color="@(context.Item.IsActive ? Color.Success : Color.Error)"
                                     Size="Size.Small" />
                        </CellTemplate>
                    </PropertyColumn>
                    <PropertyColumn Property="x => x.CreatedAt" Title="Created" Format="yyyy-MM-dd" />
                </Columns>
            </MudDataGrid>
        }
    </MudTabPanel>

    <MudTabPanel Text="Roles" Icon="@Icons.Material.Filled.AdminPanelSettings">
        @if (_loadingRoles)
        {
            <MudProgressCircular Indeterminate="true" Size="Size.Large" Class="d-flex mx-auto my-8" />
        }
        else
        {
            <MudDataGrid T="RoleRow" Items="_roles" Dense="true" Hover="true" Striped="true">
                <Columns>
                    <PropertyColumn Property="x => x.Name" Title="Role Name" />
                    <PropertyColumn Property="x => x.Description" Title="Description" />
                    <PropertyColumn Property="x => x.InheritsFrom" Title="Inherits From" />
                    <PropertyColumn Property="x => x.IsSystemRole" Title="System Role">
                        <CellTemplate>
                            <MudIcon Icon="@(context.Item.IsSystemRole ? Icons.Material.Filled.Lock : Icons.Material.Filled.LockOpen)"
                                     Size="Size.Small" />
                        </CellTemplate>
                    </PropertyColumn>
                    <PropertyColumn Property="x => x.UserCount" Title="Users" />
                </Columns>
            </MudDataGrid>
        }
    </MudTabPanel>

    <MudTabPanel Text="Audit Log" Icon="@Icons.Material.Filled.History">
        <MudText Typo="Typo.body1" Class="mb-4">
            The audit log tracks security-related events including login attempts,
            role changes, and permission modifications.
        </MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/admin/audit"
                   StartIcon="@Icons.Material.Filled.History" Class="mr-3">
            Open Audit Log
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Href="/admin/security"
                   StartIcon="@Icons.Material.Filled.Shield">
            Full Security Dashboard
        </MudButton>
    </MudTabPanel>
</MudTabs>

@code {
    private int _activeTab;
    private bool _loadingUsers = true;
    private bool _loadingRoles = true;
    private List<UserRow> _users = new();
    private List<RoleRow> _roles = new();

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadUsersAsync(), LoadRolesAsync());
    }

    private async Task LoadUsersAsync()
    {
        try
        {
            var roleAssignments = await UserRoleStore.GetAllAsync();
            var users = await SecurityDb.AppUsers
                .OrderBy(u => u.DisplayName)
                .Select(u => new { u.Id, u.Email, u.DisplayName, u.IsActive, u.CreatedAt })
                .ToListAsync();

            _users = users.Select(u =>
            {
                var userIdStr = u.Id.ToString();
                var roles = roleAssignments.TryGetValue(userIdStr, out var r) ? r : [];
                return new UserRow(u.DisplayName, u.Email, string.Join(", ", roles), u.IsActive, u.CreatedAt);
            }).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load users: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loadingUsers = false;
        }
    }

    private async Task LoadRolesAsync()
    {
        try
        {
            var roleAssignments = await UserRoleStore.GetAllAsync();
            var roles = await SecurityDb.AppRoles
                .OrderBy(r => r.Name)
                .Select(r => new { r.Name, r.Description, r.InheritsFromRoleName, r.IsSystemRole })
                .ToListAsync();

            _roles = roles.Select(r => new RoleRow(
                r.Name,
                r.Description ?? "",
                r.InheritsFromRoleName ?? "—",
                r.IsSystemRole,
                roleAssignments.Count(kvp => kvp.Value.Contains(r.Name))
            )).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load roles: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loadingRoles = false;
        }
    }

    private sealed record UserRow(string DisplayName, string Email, string Roles, bool IsActive, DateTime CreatedAt);
    private sealed record RoleRow(string Name, string Description, string InheritsFrom, bool IsSystemRole, int UserCount);
}
