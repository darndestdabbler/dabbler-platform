@using AcmeCoffeeOnline.Shared.DTOs
@using AcmeCoffeeOnline.Web.Services
@using Dabbler.Components
@using Dabbler.Components.Data.Metadata
@using MudBlazor
@inject CustomerApiClient CustomerClient

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" Color="Color.Primary" Class="ma-4" />
}
else if (_record is not null)
{
    <DabblerDetailForm T="CustomerDto"
                       @ref="_detailForm"
                       EntityMetadata="EntityMetadata"
                       Record="_record"
                       RecordChanged="OnRecordChanged"
                       IsNew="IsNew"
                       IsReadOnly="IsReadOnly"
                       MetadataProvider="MetadataProvider"
                       OnSave="HandleSaveAsync"
                       OnDelete="HandleDeleteAsync"
                       OnDirtyChanged="OnDirtyChanged"
                       ChildDataFactory="ChildDataFactory"
                       FormColumns="3" />
}
else
{
    <MudAlert Severity="Severity.Warning" Class="ma-4">Retail business record not found.</MudAlert>
}

@code {
    [Parameter]
    public EntityMetadata EntityMetadata { get; set; } = default!;

    [Parameter]
    public object? PrimaryKey { get; set; }

    [Parameter]
    public bool IsNew { get; set; }

    [Parameter]
    public bool IsReadOnly { get; set; }

    [Parameter]
    public IEntityMetadataProvider? MetadataProvider { get; set; }

    [Parameter]
    public EventCallback<bool> OnDirtyChanged { get; set; }

    [Parameter]
    public EventCallback OnSaved { get; set; }

    [Parameter]
    public EventCallback OnDeleted { get; set; }

    [Parameter]
    public Func<ChildRelationshipMetadata, object?, Task<IReadOnlyList<Dictionary<string, object?>>>>? ChildDataFactory { get; set; }

    private DabblerDetailForm<CustomerDto>? _detailForm;
    private CustomerDto? _record;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        if (IsNew)
        {
            _record = new CustomerDto
            {
                IsActive = true,
                CreatedDate = DateTime.UtcNow,
                ModifiedDate = DateTime.UtcNow
            };
            _loading = false;
        }
        else if (PrimaryKey is not null)
        {
            var id = Convert.ToInt32(PrimaryKey);
            _record = await CustomerClient.GetByIdAsync(id);
            _loading = false;
        }
        else
        {
            _loading = false;
        }
    }

    private void OnRecordChanged(CustomerDto record)
    {
        _record = record;
    }

    private async Task HandleSaveAsync(CustomerDto record)
    {
        if (IsNew)
        {
            var created = await CustomerClient.CreateAsync(record);
            if (created is not null)
            {
                _record = created;
                IsNew = false;
            }
        }
        else
        {
            var updated = await CustomerClient.UpdateAsync(record.Id, record);
            if (updated is not null)
                _record = updated;
        }

        await OnSaved.InvokeAsync();
    }

    private async Task HandleDeleteAsync(CustomerDto record)
    {
        // Soft-delete: toggle IsActive rather than hard-delete
        record.IsActive = false;
        var updated = await CustomerClient.UpdateAsync(record.Id, record);
        if (updated is not null)
            _record = updated;

        await OnDeleted.InvokeAsync();
    }
}
