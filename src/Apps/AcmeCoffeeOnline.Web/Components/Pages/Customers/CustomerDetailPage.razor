@page "/customers/{CustomerId:int}"
@attribute [DabblerPageAuthorize("/customers")]

<PageTitle>Retail Business Details — AcmeCoffeeDistributors</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-4">
    <MudStack Spacing="1" Class="mb-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                           OnClick="@(() => NavigationManager.NavigateTo("/customers"))"
                           aria-label="Back to retail businesses" />
            <MudText Typo="Typo.h4" data-testid="customer-detail-title">
                Retail Business #@CustomerId
            </MudText>
        </MudStack>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            View and edit retail business contact details and related orders.
        </MudText>
    </MudStack>

    <CustomerDetail CustomerId="CustomerId"
                    IsReadOnly="false" />
</MudContainer>

@code {
    [Parameter]
    public int CustomerId { get; set; }

    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;
}
