@using AcmeCoffeeOnline.Shared.DTOs
@using AcmeCoffeeOnline.Shared.Enums
@using AcmeCoffeeOnline.Web.Components.Pages.Products
@using AcmeCoffeeOnline.Web.Services
@using Dabbler.Components
@using Dabbler.Components.Data
@using Dabbler.Components.Data.Metadata
@using MudBlazor
@inject OrderApiClient OrderClient

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" Color="Color.Primary" Class="ma-4" />
}
else if (_record is not null)
{
    @* ── Status Workflow ─────────────────────────────────────────── *@
    @if (!IsNew)
    {
        <MudPaper Class="pa-3 mb-4" Elevation="0" Outlined="true">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                <MudText Typo="Typo.subtitle2">Status:</MudText>
                <MudChip T="string"
                         Size="Size.Medium"
                         Color="@GetStatusColor(_record.Status)"
                         Variant="Variant.Filled">
                    @_record.Status
                </MudChip>
                <MudSpacer />
                @if (!IsReadOnly)
                {
                    @foreach (var transition in GetAvailableTransitions(_record.Status))
                    {
                        <MudButton Variant="Variant.Outlined"
                                   Color="@GetStatusColor(transition)"
                                   Size="Size.Small"
                                   StartIcon="@GetTransitionIcon(transition)"
                                   OnClick="@(() => UpdateStatusAsync(transition))"
                                   Disabled="_statusUpdating">
                            @transition
                        </MudButton>
                    }
                }
            </MudStack>
        </MudPaper>
    }

    @* ── Detail Form ─────────────────────────────────────────────── *@
    <DabblerDetailForm T="OrderDto"
                       @ref="_detailForm"
                       EntityMetadata="EntityMetadata"
                       Record="_record"
                       RecordChanged="OnRecordChanged"
                       IsNew="IsNew"
                       IsReadOnly="IsReadOnly"
                       MetadataProvider="MetadataProvider"
                       OnSave="HandleSaveAsync"
                       OnDelete="HandleDeleteAsync"
                       OnDirtyChanged="OnDirtyChanged"
                       ChildDataFactory="ChildDataFactory"
                       FormColumns="3" />

    @* ── Order Items (M:M with Products) ─────────────────────────── *@
    @if (!IsNew)
    {
        <MudPaper Class="pa-3 mb-4" Elevation="0" Outlined="true">
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
                <MudText Typo="Typo.subtitle1">Order Items</MudText>
                <MudSpacer />
                @if (!IsReadOnly)
                {
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="@(() => _showProductPicker = true)">
                        Add Product
                    </MudButton>
                }
            </MudStack>

            @if (_showProductPicker)
            {
                <MudPaper Class="pa-3 mb-3" Elevation="1">
                    <MudStack Row="true" AlignItems="AlignItems.End" Spacing="2">
                        <ProductComboBox @bind-Value="_selectedProduct"
                                         Label="Select Product"
                                         Required="true" />
                        <MudNumericField T="int"
                                         @bind-Value="_newItemQuantity"
                                         Label="Qty"
                                         Min="1"
                                         Style="width: 80px;" />
                        <MudNumericField T="decimal"
                                         @bind-Value="_newItemDiscount"
                                         Label="Discount %"
                                         Min="0"
                                         Max="100"
                                         Style="width: 100px;" />
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   OnClick="AddItemAsync"
                                   Disabled="@(_selectedProduct is null || _addingItem)">
                            Add
                        </MudButton>
                        <MudIconButton Icon="@Icons.Material.Filled.Close"
                                       Size="Size.Small"
                                       OnClick="@(() => _showProductPicker = false)" />
                    </MudStack>
                </MudPaper>
            }

            <MudDataGrid T="OrderItemDto"
                         Items="_record.OrderItems"
                         Dense="true"
                         Hover="true"
                         ReadOnly="true">
                <Columns>
                    <PropertyColumn Property="i => i.ProductName" Title="Product" />
                    <PropertyColumn Property="i => i.Quantity" Title="Qty" />
                    <PropertyColumn Property="i => i.UnitPrice" Title="Unit Price" Format="C2" />
                    <PropertyColumn Property="i => i.Discount" Title="Discount %" Format="N0" />
                    <TemplateColumn Title="Line Total" Sortable="false">
                        <CellTemplate>
                            @{
                                var lineTotal = context.Item.Quantity * context.Item.UnitPrice
                                    * (1 - context.Item.Discount / 100m);
                            }
                            @lineTotal.ToString("C2")
                        </CellTemplate>
                    </TemplateColumn>
                    @if (!IsReadOnly)
                    {
                        <TemplateColumn Sortable="false" CellStyle="width: 50px;">
                            <CellTemplate>
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Size="Size.Small"
                                               Color="Color.Error"
                                               OnClick="@(() => RemoveItemAsync(context.Item))" />
                            </CellTemplate>
                        </TemplateColumn>
                    }
                </Columns>
            </MudDataGrid>
        </MudPaper>

        @* ── Order Notes ────────────────────────────────────────────── *@
        <MudPaper Class="pa-3 mb-4" Elevation="0" Outlined="true">
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
                <MudText Typo="Typo.subtitle1">Notes</MudText>
                <MudSpacer />
                @if (!IsReadOnly)
                {
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.NoteAdd"
                               OnClick="ShowAddNotePopup">
                        Add Note
                    </MudButton>
                }
            </MudStack>

            <MudDataGrid T="OrderNoteDto"
                         Items="_notes"
                         Dense="true"
                         Hover="true"
                         ReadOnly="true">
                <Columns>
                    <PropertyColumn Property="n => n.NoteDate" Title="Date" Format="g" />
                    <PropertyColumn Property="n => n.Author" Title="Author" />
                    <PropertyColumn Property="n => n.NoteText" Title="Note" />
                    @if (!IsReadOnly)
                    {
                        <TemplateColumn Sortable="false" CellStyle="width: 80px;">
                            <CellTemplate>
                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                               Size="Size.Small"
                                               Color="Color.Primary"
                                               OnClick="@(() => ShowEditNotePopup(context.Item))" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Size="Size.Small"
                                               Color="Color.Error"
                                               OnClick="@(() => DeleteNoteAsync(context.Item))" />
                            </CellTemplate>
                        </TemplateColumn>
                    }
                </Columns>
            </MudDataGrid>
        </MudPaper>

        @* ── Note Popup ─────────────────────────────────────────────── *@
        <OrderNotePopup @ref="_notePopup"
                        OrderId="_record.Id"
                        OnSaved="OnNoteSavedAsync" />
    }
}
else
{
    <MudAlert Severity="Severity.Warning" Class="ma-4">Order not found.</MudAlert>
}

@code {
    [Parameter]
    public EntityMetadata EntityMetadata { get; set; } = default!;

    [Parameter]
    public object? PrimaryKey { get; set; }

    [Parameter]
    public bool IsNew { get; set; }

    [Parameter]
    public bool IsReadOnly { get; set; }

    [Parameter]
    public IEntityMetadataProvider? MetadataProvider { get; set; }

    [Parameter]
    public EventCallback<bool> OnDirtyChanged { get; set; }

    [Parameter]
    public EventCallback OnSaved { get; set; }

    [Parameter]
    public EventCallback OnDeleted { get; set; }

    [Parameter]
    public Func<ChildRelationshipMetadata, object?, Task<IReadOnlyList<Dictionary<string, object?>>>>? ChildDataFactory { get; set; }

    private DabblerDetailForm<OrderDto>? _detailForm;
    private OrderDto? _record;
    private List<OrderNoteDto> _notes = new();
    private bool _loading = true;
    private bool _statusUpdating;

    // M:M product picker state
    private bool _showProductPicker;
    private ProductDto? _selectedProduct;
    private int _newItemQuantity = 1;
    private decimal _newItemDiscount;
    private bool _addingItem;

    // Note popup
    private OrderNotePopup? _notePopup;

    protected override async Task OnInitializedAsync()
    {
        if (IsNew)
        {
            _record = new OrderDto
            {
                OrderDate = DateTime.UtcNow,
                Status = OrderStatus.Pending,
                CreatedDate = DateTime.UtcNow,
                ModifiedDate = DateTime.UtcNow
            };
            _loading = false;
        }
        else if (PrimaryKey is not null)
        {
            var id = Convert.ToInt32(PrimaryKey);
            _record = await OrderClient.GetByIdAsync(id);
            if (_record is not null)
            {
                _notes = await OrderClient.GetNotesByOrderIdAsync(_record.Id);
            }
            _loading = false;
        }
        else
        {
            _loading = false;
        }
    }

    private void OnRecordChanged(OrderDto record)
    {
        _record = record;
    }

    // ── Save / Delete ───────────────────────────────────────────────

    private async Task HandleSaveAsync(OrderDto record)
    {
        if (IsNew)
        {
            var created = await OrderClient.CreateAsync(record);
            if (created is not null)
            {
                _record = created;
                IsNew = false;
            }
        }

        await OnSaved.InvokeAsync();
    }

    private async Task HandleDeleteAsync(OrderDto record)
    {
        await OrderClient.UpdateStatusAsync(record.Id, OrderStatus.Cancelled);
        record.Status = OrderStatus.Cancelled;
        _record = record;
        await OnDeleted.InvokeAsync();
    }

    // ── Status Workflow ─────────────────────────────────────────────

    private static Color GetStatusColor(OrderStatus status) => status switch
    {
        OrderStatus.Pending => Color.Default,
        OrderStatus.Confirmed => Color.Info,
        OrderStatus.Shipped => Color.Warning,
        OrderStatus.Delivered => Color.Success,
        OrderStatus.Cancelled => Color.Error,
        _ => Color.Default
    };

    private static string GetTransitionIcon(OrderStatus target) => target switch
    {
        OrderStatus.Confirmed => Icons.Material.Filled.CheckCircle,
        OrderStatus.Shipped => Icons.Material.Filled.LocalShipping,
        OrderStatus.Delivered => Icons.Material.Filled.DoneAll,
        OrderStatus.Cancelled => Icons.Material.Filled.Cancel,
        _ => Icons.Material.Filled.ArrowForward
    };

    private static IReadOnlyList<OrderStatus> GetAvailableTransitions(OrderStatus current) => current switch
    {
        OrderStatus.Pending => [OrderStatus.Confirmed, OrderStatus.Cancelled],
        OrderStatus.Confirmed => [OrderStatus.Shipped, OrderStatus.Cancelled],
        OrderStatus.Shipped => [OrderStatus.Delivered, OrderStatus.Cancelled],
        _ => []
    };

    private async Task UpdateStatusAsync(OrderStatus newStatus)
    {
        if (_record is null) return;

        _statusUpdating = true;
        try
        {
            await OrderClient.UpdateStatusAsync(_record.Id, newStatus);
            _record.Status = newStatus;
        }
        finally
        {
            _statusUpdating = false;
        }
    }

    // ── M:M Order Items ─────────────────────────────────────────────

    private async Task AddItemAsync()
    {
        if (_record is null || _selectedProduct is null) return;

        _addingItem = true;
        try
        {
            var newItem = new OrderItemDto
            {
                OrderId = _record.Id,
                ProductId = _selectedProduct.Id,
                ProductName = _selectedProduct.Name,
                Quantity = _newItemQuantity,
                UnitPrice = _selectedProduct.UnitPrice,
                Discount = _newItemDiscount
            };

            var created = await OrderClient.AddItemAsync(_record.Id, newItem);
            if (created is not null)
            {
                _record.OrderItems.Add(created);
                RecalculateTotal();
            }

            _selectedProduct = null;
            _newItemQuantity = 1;
            _newItemDiscount = 0;
            _showProductPicker = false;
        }
        finally
        {
            _addingItem = false;
        }
    }

    private async Task RemoveItemAsync(OrderItemDto item)
    {
        if (_record is null) return;

        await OrderClient.RemoveItemAsync(_record.Id, item.Id);
        _record.OrderItems.Remove(item);
        RecalculateTotal();
    }

    private void RecalculateTotal()
    {
        if (_record is null) return;
        _record.Total = _record.OrderItems.Sum(i =>
            i.Quantity * i.UnitPrice * (1 - i.Discount / 100m));
    }

    // ── Order Notes ─────────────────────────────────────────────────

    private void ShowAddNotePopup()
    {
        _notePopup?.ShowNew();
    }

    private void ShowEditNotePopup(OrderNoteDto note)
    {
        _notePopup?.ShowEdit(note);
    }

    private async Task DeleteNoteAsync(OrderNoteDto note)
    {
        if (_record is null) return;

        await OrderClient.DeleteNoteAsync(_record.Id, note.Id);
        _notes.Remove(note);
    }

    private async Task OnNoteSavedAsync()
    {
        if (_record is null) return;
        _notes = await OrderClient.GetNotesByOrderIdAsync(_record.Id);
    }
}
