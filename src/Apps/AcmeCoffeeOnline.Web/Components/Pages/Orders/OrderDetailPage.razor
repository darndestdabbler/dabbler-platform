@page "/orders/{OrderId:int}"
@attribute [DabblerPageAuthorize("/orders")]

<PageTitle>Order Details — AcmeCoffeeDistributors</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-4">
    <MudStack Spacing="1" Class="mb-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                           OnClick="@(() => NavigationManager.NavigateTo("/orders"))"
                           aria-label="Back to orders" />
            <MudText Typo="Typo.h4" data-testid="order-detail-title">Order #@OrderId</MudText>
        </MudStack>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Review the selected order in a focused detail view.
        </MudText>
    </MudStack>

    <OrderDetail OrderId="OrderId"
                 IsReadOnly="true" />
</MudContainer>

@code {
    [Parameter]
    public int OrderId { get; set; }

    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;
}
