@page "/suppliers/new"
@attribute [DabblerPageAuthorize("/suppliers")]
@using AcmeCoffeeOnline.Shared.DTOs
@using Dabbler.Security.Authorization
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor

<PageTitle>New Supplier</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-4">
    <MudStack Spacing="1" Class="mb-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                           OnClick="@(() => NavigationManager.NavigateTo("/suppliers"))"
                           aria-label="Back to Suppliers" />
            <MudText Typo="Typo.h4" data-testid="t1entity-new-title">New Supplier</MudText>
        </MudStack>
    </MudStack>

    <SupplierDetail IsNew="true" OnSaved="@HandleSavedAsync" />
</MudContainer>

@code {
    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;

    private Task HandleSavedAsync()
    {
        NavigationManager.NavigateTo("/suppliers");
        return Task.CompletedTask;
    }
}
