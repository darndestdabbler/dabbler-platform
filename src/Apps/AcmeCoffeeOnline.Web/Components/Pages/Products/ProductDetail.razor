@using AcmeCoffeeOnline.Shared.DTOs
@using AcmeCoffeeOnline.Web.Services
@using Dabbler.Components
@using Dabbler.Components.Data.Metadata
@using MudBlazor
@inject ProductApiClient ProductClient

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" Color="Color.Primary" Class="ma-4" />
}
else if (_record is not null)
{
    <DabblerDetailForm T="ProductDto"
                       @ref="_detailForm"
                       EntityMetadata="EntityMetadata"
                       Record="_record"
                       RecordChanged="OnRecordChanged"
                       IsNew="IsNew"
                       IsReadOnly="IsReadOnly"
                       MetadataProvider="MetadataProvider"
                       OnSave="HandleSaveAsync"
                       OnDelete="HandleDeleteAsync"
                       OnDirtyChanged="OnDirtyChanged"
                       FormColumns="2" />
}
else
{
    <MudAlert Severity="Severity.Warning" Class="ma-4">Product not found.</MudAlert>
}

@code {
    [Parameter]
    public EntityMetadata EntityMetadata { get; set; } = default!;

    [Parameter]
    public object? PrimaryKey { get; set; }

    [Parameter]
    public bool IsNew { get; set; }

    [Parameter]
    public bool IsReadOnly { get; set; }

    [Parameter]
    public IEntityMetadataProvider? MetadataProvider { get; set; }

    [Parameter]
    public EventCallback<bool> OnDirtyChanged { get; set; }

    [Parameter]
    public EventCallback OnSaved { get; set; }

    [Parameter]
    public EventCallback OnDeleted { get; set; }

    private DabblerDetailForm<ProductDto>? _detailForm;
    private ProductDto? _record;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        if (IsNew)
        {
            _record = new ProductDto
            {
                IsAvailable = true,
                CreatedDate = DateTime.UtcNow,
                ModifiedDate = DateTime.UtcNow
            };
            _loading = false;
        }
        else if (PrimaryKey is not null)
        {
            var id = Convert.ToInt32(PrimaryKey);
            _record = await ProductClient.GetByIdAsync(id);
            _loading = false;
        }
        else
        {
            _loading = false;
        }
    }

    private void OnRecordChanged(ProductDto record)
    {
        _record = record;
    }

    private async Task HandleSaveAsync(ProductDto record)
    {
        if (IsNew)
        {
            var created = await ProductClient.CreateAsync(record);
            if (created is not null)
            {
                _record = created;
                IsNew = false;
            }
        }
        else
        {
            var updated = await ProductClient.UpdateAsync(record.Id, record);
            if (updated is not null)
                _record = updated;
        }

        await OnSaved.InvokeAsync();
    }

    // Products use soft-delete: toggle IsAvailable rather than hard-delete
    private async Task HandleDeleteAsync(ProductDto record)
    {
        await ProductClient.ToggleAvailabilityAsync(record.Id);
        await OnDeleted.InvokeAsync();
    }
}
