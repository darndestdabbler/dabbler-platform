@using AcmeCoffeeOnline.Shared.DTOs
@using AcmeCoffeeOnline.Shared.Enums
@using AcmeCoffeeOnline.Web.Services
@using MudBlazor
@inject ProductApiClient ProductClient

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" Color="Color.Primary" Class="ma-4" />
}
else if (_record is not null)
{
    @* ── Toolbar ──────────────────────────────────────────────────── *@
    <MudStack Row="true" Spacing="2" Class="mb-4">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Save"
                   OnClick="HandleSaveAsync"
                   Disabled="@(!_isDirty || _saving)"
                   data-testid="save-button">
            Save
        </MudButton>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Default"
                   StartIcon="@Icons.Material.Filled.Undo"
                   OnClick="HandleUndo"
                   Disabled="@(!_isDirty)"
                   data-testid="undo-button">
            Undo
        </MudButton>
        @if (!IsNew)
        {
            <MudSpacer />
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Error"
                       StartIcon="@(_record.IsAvailable ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                       OnClick="HandleToggleAvailabilityAsync"
                       Disabled="_saving"
                       data-testid="toggle-availability-button">
                @(_record.IsAvailable ? "Deactivate" : "Activate")
            </MudButton>
        }
    </MudStack>

    @* ── Form ─────────────────────────────────────────────────────── *@
    <MudForm @ref="_form" Model="_record">
        <MudGrid>
            @* Column 1 *@
            <MudItem xs="12" md="6">
                <MudTextField T="string"
                              @bind-Value="_record.Name"
                              Label="Name"
                              Required="true"
                              RequiredError="Product name is required"
                              Variant="Variant.Outlined"
                              Immediate="true"
                              TextChanged="OnFieldChanged"
                              data-testid="field-name" />
            </MudItem>

            <MudItem xs="12" md="6">
                <MudNumericField T="decimal"
                                 Value="_record.UnitPrice"
                                 ValueChanged="@((decimal v) => { _record.UnitPrice = v; OnFieldChanged(string.Empty); })"
                                 Label="Unit Price"
                                 Min="0.01m"
                                 Max="9999.99m"
                                 Format="N2"
                                 Adornment="Adornment.Start"
                                 AdornmentText="$"
                                 Variant="Variant.Outlined"
                                 Immediate="true"
                                 data-testid="field-unit-price" />
            </MudItem>

            <MudItem xs="12" md="6">
                <MudSelect T="RoastLevel"
                           Value="_record.RoastLevel"
                           ValueChanged="@((RoastLevel v) => { _record.RoastLevel = v; OnFieldChanged(string.Empty); })"
                           Label="Roast Level"
                           Variant="Variant.Outlined"
                           data-testid="field-roast-level">
                    @foreach (var level in Enum.GetValues<RoastLevel>())
                    {
                        <MudSelectItem T="RoastLevel" Value="level">@level</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudSelect T="CaffeineContent"
                           Value="_record.CaffeineContent"
                           ValueChanged="@((CaffeineContent v) => { _record.CaffeineContent = v; OnFieldChanged(string.Empty); })"
                           Label="Caffeine Content"
                           Variant="Variant.Outlined"
                           data-testid="field-caffeine-content">
                    @foreach (var content in Enum.GetValues<CaffeineContent>())
                    {
                        <MudSelectItem T="CaffeineContent" Value="content">@content</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudSelect T="GrindType"
                           Value="_record.GrindType"
                           ValueChanged="@((GrindType v) => { _record.GrindType = v; OnFieldChanged(string.Empty); })"
                           Label="Grind Type"
                           Variant="Variant.Outlined"
                           data-testid="field-grind-type">
                    @foreach (var grind in Enum.GetValues<GrindType>())
                    {
                        <MudSelectItem T="GrindType" Value="grind">@grind</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudCheckBox T="bool"
                             Value="_record.IsAvailable"
                             ValueChanged="@((bool v) => { _record.IsAvailable = v; OnFieldChanged(string.Empty); })"
                             Label="Available"
                             Color="Color.Primary"
                             data-testid="field-is-available" />
            </MudItem>

            @* Full-width fields *@
            <MudItem xs="12">
                <MudTextField T="string"
                              @bind-Value="_record.Description"
                              Label="Description"
                              Lines="3"
                              Variant="Variant.Outlined"
                              Immediate="true"
                              TextChanged="OnFieldChanged"
                              data-testid="field-description" />
            </MudItem>

            <MudItem xs="12" md="6">
                <MudTextField T="string"
                              @bind-Value="_record.ImageUrl"
                              Label="Image URL"
                              Variant="Variant.Outlined"
                              Immediate="true"
                              TextChanged="OnFieldChanged"
                              data-testid="field-image-url" />
            </MudItem>
        </MudGrid>
    </MudForm>

    @* ── Timestamps ───────────────────────────────────────────────── *@
    @if (!IsNew)
    {
        <MudStack Row="true" Spacing="4" Class="mt-4">
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                Created: @_record.CreatedDate.ToString("g")
            </MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                Modified: @_record.ModifiedDate.ToString("g")
            </MudText>
        </MudStack>
    }
}
else
{
    <MudAlert Severity="Severity.Warning" Class="ma-4" data-testid="product-not-found">
        Product not found.
    </MudAlert>
}

@code {
    [Parameter]
    public int? ProductId { get; set; }

    [Parameter]
    public bool IsNew { get; set; }

    [Parameter]
    public bool IsReadOnly { get; set; }

    [Parameter]
    public EventCallback OnSaved { get; set; }

    [Parameter]
    public EventCallback OnDeleted { get; set; }

    private MudForm? _form;
    private ProductDto? _record;
    private ProductDto? _snapshot;
    private bool _loading = true;
    private bool _saving;
    private bool _isDirty;

    protected override async Task OnInitializedAsync()
    {
        if (IsNew)
        {
            _record = new ProductDto
            {
                IsAvailable = true,
                CreatedDate = DateTime.UtcNow,
                ModifiedDate = DateTime.UtcNow
            };
            TakeSnapshot();
            _loading = false;
        }
        else if (ProductId is not null)
        {
            _record = await ProductClient.GetByIdAsync(ProductId.Value);
            TakeSnapshot();
            _loading = false;
        }
        else
        {
            _loading = false;
        }
    }

    private void OnFieldChanged(string _) => UpdateDirtyState();

    private async Task HandleSaveAsync()
    {
        if (_form is not null)
        {
            await _form.Validate();
            if (!_form.IsValid) return;
        }

        if (_record is null) return;

        _saving = true;
        try
        {
            if (IsNew)
            {
                var created = await ProductClient.CreateAsync(_record);
                if (created is not null)
                {
                    _record = created;
                    IsNew = false;
                }
            }
            else
            {
                var updated = await ProductClient.UpdateAsync(_record.Id, _record);
                if (updated is not null)
                    _record = updated;
            }

            TakeSnapshot();
            UpdateDirtyState();
            await OnSaved.InvokeAsync();
        }
        finally
        {
            _saving = false;
        }
    }

    private void HandleUndo()
    {
        if (_record is null || _snapshot is null) return;

        _record.Name = _snapshot.Name;
        _record.RoastLevel = _snapshot.RoastLevel;
        _record.CaffeineContent = _snapshot.CaffeineContent;
        _record.GrindType = _snapshot.GrindType;
        _record.UnitPrice = _snapshot.UnitPrice;
        _record.IsAvailable = _snapshot.IsAvailable;
        _record.Description = _snapshot.Description;
        _record.ImageUrl = _snapshot.ImageUrl;
        UpdateDirtyState();
    }

    private async Task HandleToggleAvailabilityAsync()
    {
        if (_record is null) return;

        _saving = true;
        try
        {
            await ProductClient.ToggleAvailabilityAsync(_record.Id);
            _record.IsAvailable = !_record.IsAvailable;
            TakeSnapshot();
            UpdateDirtyState();
            await OnDeleted.InvokeAsync();
        }
        finally
        {
            _saving = false;
        }
    }

    private void TakeSnapshot()
    {
        if (_record is null) return;

        _snapshot = new ProductDto
        {
            Id = _record.Id,
            Name = _record.Name,
            RoastLevel = _record.RoastLevel,
            CaffeineContent = _record.CaffeineContent,
            GrindType = _record.GrindType,
            UnitPrice = _record.UnitPrice,
            IsAvailable = _record.IsAvailable,
            Description = _record.Description,
            ImageUrl = _record.ImageUrl,
            CreatedDate = _record.CreatedDate,
            ModifiedDate = _record.ModifiedDate
        };
    }

    private void UpdateDirtyState()
    {
        if (_record is null || _snapshot is null)
        {
            _isDirty = false;
            return;
        }

        _isDirty = _record.Name != _snapshot.Name
            || _record.RoastLevel != _snapshot.RoastLevel
            || _record.CaffeineContent != _snapshot.CaffeineContent
            || _record.GrindType != _snapshot.GrindType
            || _record.UnitPrice != _snapshot.UnitPrice
            || _record.IsAvailable != _snapshot.IsAvailable
            || _record.Description != _snapshot.Description
            || _record.ImageUrl != _snapshot.ImageUrl;
    }
}
