@using AcmeCoffeeOnline.Shared.DTOs
@using AcmeCoffeeOnline.Shared.Enums
@using Dabbler.Components
@using Dabbler.Components.Data
@using MudBlazor

@* ── Title ──────────────────────────────────────────────────────────── *@
<MudText Typo="Typo.h6" Class="mb-2">@Title</MudText>

@* ── Filter panel ───────────────────────────────────────────────────── *@
<FilterPanel T="ProductDto"
             @ref="_filterPanel"
             Columns="_filterColumns"
             FilterChanged="@OnFilterChangedAsync"
             ShowAddGroup="false"
             ShowFilterChips="true" />

@* ── Toolbar ────────────────────────────────────────────────────────── *@
<div class="d-flex align-center gap-2 my-2">
    @if (!string.IsNullOrEmpty(_statusText))
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary">@_statusText</MudText>
    }
    <MudSpacer />
    @if (!AutoLoadOnFilterChange)
    {
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Search"
                   OnClick="@SearchAsync"
                   Disabled="@_isLoading">
            Search
        </MudButton>
    }
    <MudButton Variant="Variant.Outlined"
               Color="Color.Primary"
               Size="Size.Small"
               StartIcon="@Icons.Material.Filled.Add"
               Href="/admin/products"
               data-testid="add-product-button">
        Add Product
    </MudButton>
</div>

@* ── Error banner ───────────────────────────────────────────────────── *@
@if (_error is not null)
{
    <MudAlert Severity="Severity.Error"
              Variant="Variant.Filled"
              ShowCloseIcon="true"
              CloseIconClicked="@(() => { _error = null; StateHasChanged(); })"
              Class="mb-2">
        @_error.Message
    </MudAlert>
}

@* ── Data grid ──────────────────────────────────────────────────────── *@
<MudDataGrid T="ProductDto"
             @ref="_mudDataGrid"
             ServerData="@ServerDataFuncAsync"
             Dense="true"
             Hover="true"
             RowsPerPage="25"
             ReadOnly="true"
             Loading="@_isLoading"
             RowClick="@OnRowClick">
    <Columns>
        <PropertyColumn Property="e => e.Name" Title="Name" />
        <PropertyColumn Property="e => e.RoastLevel" Title="Roast Level" />
        <PropertyColumn Property="e => e.CaffeineContent" Title="Caffeine" />
        <PropertyColumn Property="e => e.GrindType" Title="Grind Type" />
        <PropertyColumn Property="e => e.UnitPrice" Title="Unit Price" Format="C2" />
        <TemplateColumn Title="Available" Sortable="true">
            <CellTemplate>
                <MudIcon Icon="@(context.Item.IsAvailable ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Cancel)"
                         Color="@(context.Item.IsAvailable ? Color.Success : Color.Error)"
                         Size="Size.Small" />
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <PagerContent>
        <MudDataGridPager T="ProductDto" />
    </PagerContent>
</MudDataGrid>

@code {
    private FilterPanel<ProductDto>? _filterPanel;
    private MudDataGrid<ProductDto>? _mudDataGrid;
    private bool _isLoading;
    private Exception? _error;
    private int _currentTotal;
    private int? _unfilteredTotal;
    private CompositeFilterDescriptor? _currentFilter;
    private CancellationTokenSource? _debounceCts;
    private string? _statusText;

    [Parameter]
    public IGridDataProvider<ProductDto> DataProvider { get; set; } = default!;

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public bool AutoLoadOnFilterChange { get; set; } = true;

    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;

    private readonly IReadOnlyList<FilterColumnDefinition> _filterColumns = new List<FilterColumnDefinition>
    {
        new()
        {
            Header = "Roast Level",
            PropertyName = "RoastLevel",
            EditorType = FilterEditorType.ComboBox,
            ItemsSource = Enum.GetValues<RoastLevel>().Cast<object>(),
            DefaultOperator = "eq",
            ShowOperator = false,
        },
        new()
        {
            Header = "Caffeine",
            PropertyName = "CaffeineContent",
            EditorType = FilterEditorType.ComboBox,
            ItemsSource = Enum.GetValues<CaffeineContent>().Cast<object>(),
            DefaultOperator = "eq",
            ShowOperator = false,
        },
        new()
        {
            Header = "Grind Type",
            PropertyName = "GrindType",
            EditorType = FilterEditorType.ComboBox,
            ItemsSource = Enum.GetValues<GrindType>().Cast<object>(),
            DefaultOperator = "eq",
            ShowOperator = false,
        },
        new()
        {
            Header = "Available",
            PropertyName = "IsAvailable",
            EditorType = FilterEditorType.CheckBox,
            DefaultOperator = "eq",
            ShowOperator = false,
        },
        new()
        {
            Header = "Min Price",
            PropertyName = "UnitPrice",
            EditorType = FilterEditorType.NumericText,
            DefaultOperator = "gte",
            ShowOperator = false,
            Placeholder = "Min $",
        },
        new()
        {
            Header = "Max Price",
            PropertyName = "UnitPrice",
            EditorType = FilterEditorType.NumericText,
            DefaultOperator = "lte",
            ShowOperator = false,
            Placeholder = "Max $",
        }
    };

    private async Task<GridData<ProductDto>> ServerDataFuncAsync(GridState<ProductDto> state)
    {
        _isLoading = true;
        _error = null;
        StateHasChanged();

        try
        {
            var request = new GridDataRequest
            {
                PageIndex = state.Page,
                PageSize = state.PageSize,
                CompositeFilter = _currentFilter,
                Sorts = state.SortDefinitions
                    .Select(s => new SortDescriptor(s.SortBy, s.Descending))
                    .ToList(),
            };

            var response = await DataProvider.FetchAsync(request);

            _currentTotal = response.TotalCount;
            if (_currentFilter is null || !HasActiveFilters(_currentFilter))
            {
                _unfilteredTotal = response.TotalCount;
            }
            UpdateStatusText();

            return new GridData<ProductDto>
            {
                Items = response.Items,
                TotalItems = response.TotalCount,
            };
        }
        catch (Exception ex)
        {
            _error = ex;
            _currentTotal = 0;
            UpdateStatusText();
            return new GridData<ProductDto> { Items = [], TotalItems = 0 };
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task OnFilterChangedAsync(CompositeFilterDescriptor? filter)
    {
        _currentFilter = filter;

        if (!AutoLoadOnFilterChange)
            return;

        _debounceCts?.Cancel();
        _debounceCts = new CancellationTokenSource();

        try
        {
            await Task.Delay(200, _debounceCts.Token);
            if (_mudDataGrid is not null)
                await _mudDataGrid.ReloadServerData();
        }
        catch (TaskCanceledException) { }
    }

    private async Task SearchAsync()
    {
        if (_mudDataGrid is not null)
            await _mudDataGrid.ReloadServerData();
    }

    private void OnRowClick(DataGridRowClickEventArgs<ProductDto> args)
    {
        NavigationManager.NavigateTo($"/products/{args.Item.Id}");
    }

    private void UpdateStatusText()
    {
        var hasFilters = _currentFilter is not null && HasActiveFilters(_currentFilter);
        if (hasFilters && _unfilteredTotal.HasValue && _unfilteredTotal.Value != _currentTotal)
        {
            _statusText = $"Showing {_currentTotal:N0} of {_unfilteredTotal.Value:N0} records";
        }
        else
        {
            _statusText = $"{_currentTotal:N0} records";
        }
    }

    private static bool HasActiveFilters(CompositeFilterDescriptor filter)
        => filter.Filters.Count > 0 || filter.Children.Count > 0;
}
