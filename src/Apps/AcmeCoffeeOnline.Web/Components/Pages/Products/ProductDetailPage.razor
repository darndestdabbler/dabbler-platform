@page "/products/{ProductId:int}"
@attribute [DabblerPageAuthorize("/products")]
@using Dabbler.Components.Data.Metadata
@inject IEntityMetadataProvider MetadataProvider

<PageTitle>Product Details — AcmeCoffeeDistributors</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-4">
    <MudStack Spacing="1" Class="mb-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                           OnClick="@(() => NavigationManager.NavigateTo("/products"))"
                           aria-label="Back to products" />
            <MudText Typo="Typo.h4" data-testid="product-detail-title">Product #@ProductId</MudText>
        </MudStack>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            View and edit product details.
        </MudText>
    </MudStack>

    <ProductDetail EntityMetadata="_entityMetadata"
                   PrimaryKey="ProductId"
                   IsReadOnly="false"
                   MetadataProvider="MetadataProvider" />
</MudContainer>

@code {
    [Parameter]
    public int ProductId { get; set; }

    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;

    private EntityMetadata _entityMetadata = default!;

    protected override void OnInitialized()
    {
        _entityMetadata = MetadataProvider.GetEntityMetadata("Product")
            ?? throw new InvalidOperationException("Product metadata is required.");
    }
}
