@page "/products/catalog"
@attribute [DabblerPageAuthorize("/products")]
@using AcmeCoffeeOnline.Shared.DTOs
@using Dabbler.Components.Data

<PageTitle>Products — AcmeCoffeeOnline</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-4">
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mb-4">
        The catalog route now opens the focused product workflow backed by the retained query page surface.
    </MudAlert>

    <ProductList DataProvider="DataProvider" Title="Products" />
</MudContainer>

@code {
    [Inject]
    private IGridDataProvider<ProductDto> DataProvider { get; set; } = default!;
}
