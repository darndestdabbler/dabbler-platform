@page "/login"
@layout AcmeCoffeeOnline.Web.Components.Layout.AuthLayout
@attribute [AllowAnonymous]
@using System.Net.Http.Json
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation

<PageTitle>Sign In — AcmeCoffeeOnline</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8" data-testid="login-page">
    <MudPaper Elevation="2" Class="pa-8">
        <MudText Typo="Typo.h4" GutterBottom="true">Sign In</MudText>

        @if (!string.IsNullOrEmpty(_queryError))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@_queryError</MudAlert>
        }

        @* ── Entra ID / Organization sign-in ── *@
        <MudText Typo="Typo.body2" Class="mb-3">For backoffice staff:</MudText>
        <MudButton Href="@EntraIdChallengeUrl"
                   Variant="Variant.Outlined"
                   Color="Color.Primary"
                   FullWidth="true"
                   StartIcon="@Icons.Material.Filled.Business"
                   Class="mb-6"
                   tabindex="1">
            Sign in with your organization account
        </MudButton>

        <div class="d-flex align-center my-4">
            <MudDivider Class="flex-grow-1" />
            <MudText Typo="Typo.body2" Class="mx-4 mud-text-secondary">or</MudText>
            <MudDivider Class="flex-grow-1" />
        </div>

        @* ── Magic link sign-in ── *@
        <MudText Typo="Typo.body2" Class="mb-3 mt-4">For customers — sign in with email:</MudText>

        @if (_step == LoginStep.EnterEmail)
        {
            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Class="mb-4">@_errorMessage</MudAlert>
            }

            <MudTextField @bind-Value="_email"
                          Label="Email address"
                          InputType="InputType.Email"
                          Required="true"
                          Immediate="true"
                          Class="mb-4"
                          Disabled="_submitting"
                          tabindex="2" />

            <MudButton OnClick="SendMagicLinkAsync"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Disabled="@(_submitting || string.IsNullOrWhiteSpace(_email))"
                       tabindex="3">
                @if (_submitting)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    @:Sending...
                }
                else
                {
                    @:Send sign-in link
                }
            </MudButton>
        }
        else if (_step == LoginStep.EnterCode)
        {
            <MudAlert Severity="Severity.Info" Class="mb-4">
                We sent a sign-in code to <strong>@_email</strong>. Enter the 6-digit code below,
                or click the link in your email.
            </MudAlert>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Class="mb-4">@_errorMessage</MudAlert>
            }

            <MudTextField @bind-Value="_code"
                          Label="6-digit code"
                          InputType="InputType.Text"
                          MaxLength="6"
                          Required="true"
                          Immediate="true"
                          Class="mb-4"
                          Disabled="_submitting"
                          tabindex="2" />

            <MudButton OnClick="VerifyCodeAsync"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Disabled="@(_submitting || string.IsNullOrWhiteSpace(_code))"
                       Class="mb-3"
                       tabindex="3">
                @if (_submitting)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    @:Verifying...
                }
                else
                {
                    @:Verify code
                }
            </MudButton>

            <MudButton OnClick="ResetToEmail"
                       Variant="Variant.Text"
                       Color="Color.Default"
                       FullWidth="true"
                       tabindex="4">
                Use a different email
            </MudButton>
        }
        else if (_step == LoginStep.MfaChallenge)
        {
            <MudAlert Severity="Severity.Info" Class="mb-4">
                Your account requires multi-factor authentication.
                Enter the code from your authenticator app.
            </MudAlert>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Class="mb-4">@_errorMessage</MudAlert>
            }

            <MudTextField @bind-Value="_mfaCode"
                          Label="Authenticator code"
                          InputType="InputType.Text"
                          MaxLength="6"
                          Required="true"
                          Immediate="true"
                          Class="mb-4"
                          Disabled="_submitting"
                          tabindex="2" />

            <MudButton OnClick="VerifyMfaAsync"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Disabled="@(_submitting || string.IsNullOrWhiteSpace(_mfaCode))"
                       tabindex="3">
                @if (_submitting)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    @:Verifying...
                }
                else
                {
                    @:Verify
                }
            </MudButton>
        }

        <MudDivider Class="my-6" />

        <MudText Typo="Typo.body2" Align="Align.Center">
            Don't have an account?
            <MudLink Href="/register">Create one</MudLink>
        </MudText>
    </MudPaper>
</MudContainer>

@code {
    [SupplyParameterFromQuery]
    public string? Error { get; set; }

    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery]
    public string? Token { get; set; }

    private enum LoginStep { EnterEmail, EnterCode, MfaChallenge }
    private LoginStep _step = LoginStep.EnterEmail;

    private string _email = string.Empty;
    private string _code = string.Empty;
    private string _mfaCode = string.Empty;
    private bool _submitting;
    private string? _errorMessage;
    private string? _queryError;
    private int? _mfaUserId;

    private string EntraIdChallengeUrl =>
        $"/auth/challenge/EntraId?returnUrl={Uri.EscapeDataString(ReturnUrl ?? "/")}";

    protected override async Task OnInitializedAsync()
    {
        // Map query string error codes to user-friendly messages
        _queryError = Error switch
        {
            "external-auth-failed" => "Organization sign-in failed. Please try again.",
            "provisioning-failed" => "Unable to set up your account. Please contact support.",
            "expired" => "Your sign-in link has expired. Please request a new one.",
            _ => null
        };

        // If we received a magic link token via URL, verify it immediately
        if (!string.IsNullOrWhiteSpace(Token))
        {
            await VerifyTokenAsync(Token);
        }
    }

    private async Task SendMagicLinkAsync()
    {
        if (string.IsNullOrWhiteSpace(_email))
            return;

        _submitting = true;
        _errorMessage = null;

        try
        {
            var client = HttpClientFactory.CreateClient();
            var baseUri = Navigation.BaseUri.TrimEnd('/');
            var response = await client.PostAsJsonAsync(
                $"{baseUri}/auth/send-magic-link",
                new { email = _email.Trim() });

            if (response.IsSuccessStatusCode)
            {
                _step = LoginStep.EnterCode;
            }
            else
            {
                _errorMessage = "Failed to send sign-in link. Please try again.";
            }
        }
        catch (Exception)
        {
            _errorMessage = "Unable to reach the server. Please try again later.";
        }
        finally
        {
            _submitting = false;
        }
    }

    private async Task VerifyCodeAsync()
    {
        if (string.IsNullOrWhiteSpace(_code))
            return;

        _submitting = true;
        _errorMessage = null;

        try
        {
            var client = HttpClientFactory.CreateClient();
            var baseUri = Navigation.BaseUri.TrimEnd('/');
            var response = await client.PostAsJsonAsync(
                $"{baseUri}/auth/verify",
                new { token = (string?)null, email = _email.Trim(), code = _code.Trim() });

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<VerifyResponse>();
                if (result is null)
                {
                    _errorMessage = "Unexpected response from server.";
                    return;
                }

                if (result.RequiresMfa)
                {
                    _mfaUserId = result.Id;
                    _step = LoginStep.MfaChallenge;
                    return;
                }

                if (!string.IsNullOrWhiteSpace(result.ExchangeToken))
                {
                    var returnUrl = Uri.EscapeDataString(ReturnUrl ?? "/");
                    Navigation.NavigateTo(
                        $"/auth/complete?token={result.ExchangeToken}&returnUrl={returnUrl}",
                        forceLoad: true);
                }
            }
            else
            {
                _errorMessage = "Invalid or expired code. Please try again.";
            }
        }
        catch (Exception)
        {
            _errorMessage = "Unable to reach the server. Please try again later.";
        }
        finally
        {
            _submitting = false;
        }
    }

    private async Task VerifyTokenAsync(string token)
    {
        _submitting = true;
        _errorMessage = null;

        try
        {
            var client = HttpClientFactory.CreateClient();
            var baseUri = Navigation.BaseUri.TrimEnd('/');
            var response = await client.PostAsJsonAsync(
                $"{baseUri}/auth/verify",
                new { token, email = (string?)null, code = (string?)null });

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<VerifyResponse>();
                if (result is null)
                {
                    _errorMessage = "Unexpected response from server.";
                    return;
                }

                if (result.RequiresMfa)
                {
                    _mfaUserId = result.Id;
                    _step = LoginStep.MfaChallenge;
                    return;
                }

                if (!string.IsNullOrWhiteSpace(result.ExchangeToken))
                {
                    var returnUrl = Uri.EscapeDataString(ReturnUrl ?? "/");
                    Navigation.NavigateTo(
                        $"/auth/complete?token={result.ExchangeToken}&returnUrl={returnUrl}",
                        forceLoad: true);
                }
            }
            else
            {
                _queryError = "Your sign-in link is invalid or expired. Please request a new one.";
                _step = LoginStep.EnterEmail;
            }
        }
        catch (Exception)
        {
            _queryError = "Unable to reach the server. Please try again later.";
            _step = LoginStep.EnterEmail;
        }
        finally
        {
            _submitting = false;
        }
    }

    private async Task VerifyMfaAsync()
    {
        if (string.IsNullOrWhiteSpace(_mfaCode) || _mfaUserId is null)
            return;

        _submitting = true;
        _errorMessage = null;

        try
        {
            var client = HttpClientFactory.CreateClient();
            var baseUri = Navigation.BaseUri.TrimEnd('/');
            var response = await client.PostAsJsonAsync(
                $"{baseUri}/auth/verify-mfa",
                new { userId = _mfaUserId.Value, code = _mfaCode.Trim() });

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<MfaVerifyResponse>();
                if (result?.ExchangeToken is not null)
                {
                    var returnUrl = Uri.EscapeDataString(ReturnUrl ?? "/");
                    Navigation.NavigateTo(
                        $"/auth/complete?token={result.ExchangeToken}&returnUrl={returnUrl}",
                        forceLoad: true);
                }
            }
            else
            {
                _errorMessage = "Invalid authenticator code. Please try again.";
            }
        }
        catch (Exception)
        {
            _errorMessage = "Unable to reach the server. Please try again later.";
        }
        finally
        {
            _submitting = false;
        }
    }

    private void ResetToEmail()
    {
        _step = LoginStep.EnterEmail;
        _code = string.Empty;
        _errorMessage = null;
    }

    private record VerifyResponse(bool Success, bool RequiresMfa, int? Id, string? Email, string? ExchangeToken);
    private record MfaVerifyResponse(string? ExchangeToken);
}
