@page "/login"
@layout AcmeCoffeeOnline.Web.Components.Layout.AuthLayout
@attribute [AllowAnonymous]
@using System.Net.Http.Json
@using Microsoft.Extensions.Configuration
@using Microsoft.Extensions.Options
@using AcmeCoffeeOnline.Web.Configuration
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation
@inject IConfiguration Configuration
@inject IOptions<AppAuthenticationOptions> AuthOptions
@inject IJSRuntime JS

<PageTitle>Sign In — AcmeCoffeeDistributors</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-8" data-testid="login-page">
    <MudPaper Elevation="2" Class="pa-8">
        <MudText Typo="Typo.h4" GutterBottom="true">Sign In</MudText>

        @if (!string.IsNullOrEmpty(_queryError))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@_queryError</MudAlert>
        }

        @* ── Entra ID / Organization sign-in ── *@
        @if (AuthOptions.Value.ShowSsoButton)
        {
            <MudText Typo="Typo.body2" Class="mb-3">For internal staff in the internal organization:</MudText>
            <MudButton Href="@EntraIdChallengeUrl"
                       Variant="Variant.Outlined"
                       Color="Color.Primary"
                       FullWidth="true"
                       StartIcon="@Icons.Material.Filled.Business"
                       Class="mb-6"
                       tabindex="1">
                Sign in with your organization account
            </MudButton>

            <div class="d-flex align-center my-4">
                <MudDivider Class="flex-grow-1" />
                <MudText Typo="Typo.body2" Class="mx-4 mud-text-secondary">or</MudText>
                <MudDivider Class="flex-grow-1" />
            </div>
        }

        @* ── Magic link sign-in ── *@
        <MudText Typo="Typo.body2" Class="mb-3 mt-4">For retail-business buyers and employees — sign in with email:</MudText>

        @if (_step == LoginStep.EnterEmail)
        {
            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Class="mb-4">@_errorMessage</MudAlert>
            }

            <MudTextField @bind-Value="_email"
                          Label="Email address"
                          InputType="InputType.Email"
                          Required="true"
                          Immediate="true"
                          Class="mb-4"
                          Disabled="_submitting"
                          tabindex="2" />

            <MudButton OnClick="SendMagicLinkAsync"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Disabled="@(_submitting || string.IsNullOrWhiteSpace(_email))"
                       tabindex="3">
                @if (_submitting)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    @:Sending...
                }
                else
                {
                    @:Send sign-in link
                }
            </MudButton>
        }
        else if (_step == LoginStep.EnterCode)
        {
            <MudAlert Severity="Severity.Info" Class="mb-4">
                We sent a sign-in code to <strong>@_email</strong>. Enter the 6-digit code below,
                or click the link in your email.
            </MudAlert>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Class="mb-4">@_errorMessage</MudAlert>
            }

            <MudTextField @bind-Value="_code"
                          Label="6-digit code"
                          InputType="InputType.Text"
                          MaxLength="6"
                          Required="true"
                          Immediate="true"
                          Class="mb-4"
                          Disabled="_submitting"
                          tabindex="2" />

            <MudButton OnClick="VerifyCodeAsync"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Disabled="@(_submitting || string.IsNullOrWhiteSpace(_code))"
                       Class="mb-3"
                       tabindex="3">
                @if (_submitting)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    @:Verifying...
                }
                else
                {
                    @:Verify code
                }
            </MudButton>

            <MudButton OnClick="ResetToEmail"
                       Variant="Variant.Text"
                       Color="Color.Default"
                       FullWidth="true"
                       tabindex="4">
                Use a different email
            </MudButton>
        }
        else if (_step == LoginStep.MfaChallenge)
        {
            <MudAlert Severity="Severity.Info" Class="mb-4">
                Your account requires multi-factor authentication.
                Enter the code from your authenticator app.
            </MudAlert>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Class="mb-4">@_errorMessage</MudAlert>
            }

            <MudTextField @bind-Value="_mfaCode"
                          Label="Authenticator code"
                          InputType="InputType.Text"
                          MaxLength="6"
                          Required="true"
                          Immediate="true"
                          Class="mb-4"
                          Disabled="_submitting"
                          tabindex="2" />

            <MudButton OnClick="VerifyMfaAsync"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Disabled="@(_submitting || string.IsNullOrWhiteSpace(_mfaCode))"
                       tabindex="3">
                @if (_submitting)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    @:Verifying...
                }
                else
                {
                    @:Verify
                }
            </MudButton>
        }

        @if (AuthOptions.Value.SeededSession.Enabled)
        {
            <MudText Typo="Typo.caption" Class="mt-4 d-block mud-text-secondary">
                In local dev, magic-link codes are written to an in-memory inbox:
                <MudLink Href="/dev/email-inbox" Target="_blank">View dev email inbox</MudLink>
            </MudText>
        }

        <MudDivider Class="my-6" />

        <MudText Typo="Typo.body2" Align="Align.Center">
            Don't have an account?
            <MudLink Href="/register">Create one</MudLink>
        </MudText>
    </MudPaper>

    @if (AuthOptions.Value.SeededSession.Enabled)
    {
        <MudPaper Elevation="1" Class="pa-6 mt-4" Style="border: 2px dashed var(--mud-palette-warning);">
            <MudStack Spacing="3">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.Engineering" Color="Color.Warning" />
                    <MudText Typo="Typo.subtitle1" Color="Color.Warning">Dev Quick Sign-In</MudText>
                </MudStack>

                <MudSelect T="string"
                           @bind-Value="_selectedPersona"
                           Label="Select a test persona"
                           Variant="Variant.Outlined"
                           AnchorOrigin="Origin.BottomCenter">
                    @foreach (var persona in _devPersonas)
                    {
                        <MudSelectItem Value="@persona.Id">
                            @persona.Label
                        </MudSelectItem>
                    }
                </MudSelect>

                <MudButton OnClick="DevSignInAsync"
                           Variant="Variant.Filled"
                           Color="Color.Warning"
                           FullWidth="true"
                           Disabled="@(_devSigningIn || string.IsNullOrEmpty(_selectedPersona))">
                    @if (_devSigningIn)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        @:Signing in...
                    }
                    else
                    {
                        @:Sign in as selected user
                    }
                </MudButton>

                @if (!string.IsNullOrEmpty(_devError))
                {
                    <MudAlert Severity="Severity.Error" Dense="true">@_devError</MudAlert>
                }
            </MudStack>
        </MudPaper>
    }
</MudContainer>

@code {
    [SupplyParameterFromQuery]
    public string? Error { get; set; }

    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery]
    public string? Token { get; set; }

    private enum LoginStep { EnterEmail, EnterCode, MfaChallenge }
    private LoginStep _step = LoginStep.EnterEmail;

    private string _email = string.Empty;
    private string _code = string.Empty;
    private string _mfaCode = string.Empty;
    private bool _submitting;
    private string? _errorMessage;
    private string? _queryError;
    private int? _mfaUserId;

    private string EntraIdChallengeUrl =>
        $"/auth/challenge/EntraId?returnUrl={Uri.EscapeDataString(ReturnUrl ?? "/")}";

    protected override async Task OnInitializedAsync()
    {
        // Map query string error codes to user-friendly messages
        _queryError = Error switch
        {
            "external-auth-failed" => "Organization sign-in failed. Please try again.",
            "sso-unavailable" => "Organization sign-in is not available in this environment.",
            "provisioning-failed" => "Unable to set up your account. Please contact support.",
            "expired" => "Your sign-in link has expired. Please request a new one.",
            _ => null
        };

        // If we received a magic link token via URL, verify it immediately
        if (!string.IsNullOrWhiteSpace(Token))
        {
            await VerifyTokenAsync(Token);
        }
    }

    // When Blazor Server runs in a container, Navigation.BaseUri returns the
    // browser-visible URL (e.g., http://localhost:5010), which is the host's
    // port mapping and is NOT reachable from inside the container. Setting
    // Services:WebSelfBaseUrl to the container-internal URL (e.g.,
    // http://localhost:8080) lets server-side self-POSTs go directly to
    // Kestrel while we preserve the browser's Host header so server-side
    // handlers that read ctx.Request.Host (magic-link email construction) see
    // the public value.
    private async Task<HttpResponseMessage> PostSelfAsync(string path, object body)
    {
        var client = HttpClientFactory.CreateClient();
        var selfBase = Configuration["Services:WebSelfBaseUrl"]?.TrimEnd('/');
        var browserBase = Navigation.BaseUri.TrimEnd('/');
        var targetBase = selfBase ?? browserBase;

        var request = new HttpRequestMessage(HttpMethod.Post, $"{targetBase}{path}")
        {
            Content = JsonContent.Create(body)
        };
        if (selfBase is not null)
        {
            request.Headers.Host = new Uri(browserBase).Authority;
        }
        return await client.SendAsync(request);
    }

    private async Task SendMagicLinkAsync()
    {
        if (string.IsNullOrWhiteSpace(_email))
            return;

        _submitting = true;
        _errorMessage = null;

        try
        {
            var response = await PostSelfAsync(
                "/auth/send-magic-link",
                new { email = _email.Trim() });

            if (response.IsSuccessStatusCode)
            {
                _step = LoginStep.EnterCode;
            }
            else
            {
                _errorMessage = "Failed to send sign-in link. Please try again.";
            }
        }
        catch (Exception)
        {
            _errorMessage = "Unable to reach the server. Please try again later.";
        }
        finally
        {
            _submitting = false;
        }
    }

    private async Task VerifyCodeAsync()
    {
        if (string.IsNullOrWhiteSpace(_code))
            return;

        _submitting = true;
        _errorMessage = null;

        try
        {
            var response = await PostSelfAsync(
                "/auth/verify",
                new { token = (string?)null, email = _email.Trim(), code = _code.Trim() });

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<VerifyResponse>();
                if (result is null)
                {
                    _errorMessage = "Unexpected response from server.";
                    return;
                }

                if (result.RequiresMfa)
                {
                    _mfaUserId = result.Id;
                    _step = LoginStep.MfaChallenge;
                    return;
                }

                if (!string.IsNullOrWhiteSpace(result.ExchangeToken))
                {
                    var returnUrl = Uri.EscapeDataString(ReturnUrl ?? "/");
                    Navigation.NavigateTo(
                        $"/auth/complete?token={result.ExchangeToken}&returnUrl={returnUrl}",
                        forceLoad: true);
                }
            }
            else
            {
                _errorMessage = "Invalid or expired code. Please try again.";
            }
        }
        catch (Exception)
        {
            _errorMessage = "Unable to reach the server. Please try again later.";
        }
        finally
        {
            _submitting = false;
        }
    }

    private async Task VerifyTokenAsync(string token)
    {
        _submitting = true;
        _errorMessage = null;

        try
        {
            var response = await PostSelfAsync(
                "/auth/verify",
                new { token, email = (string?)null, code = (string?)null });

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<VerifyResponse>();
                if (result is null)
                {
                    _errorMessage = "Unexpected response from server.";
                    return;
                }

                if (result.RequiresMfa)
                {
                    _mfaUserId = result.Id;
                    _step = LoginStep.MfaChallenge;
                    return;
                }

                if (!string.IsNullOrWhiteSpace(result.ExchangeToken))
                {
                    var returnUrl = Uri.EscapeDataString(ReturnUrl ?? "/");
                    Navigation.NavigateTo(
                        $"/auth/complete?token={result.ExchangeToken}&returnUrl={returnUrl}",
                        forceLoad: true);
                }
            }
            else
            {
                _queryError = "Your sign-in link is invalid or expired. Please request a new one.";
                _step = LoginStep.EnterEmail;
            }
        }
        catch (Exception)
        {
            _queryError = "Unable to reach the server. Please try again later.";
            _step = LoginStep.EnterEmail;
        }
        finally
        {
            _submitting = false;
        }
    }

    private async Task VerifyMfaAsync()
    {
        if (string.IsNullOrWhiteSpace(_mfaCode) || _mfaUserId is null)
            return;

        _submitting = true;
        _errorMessage = null;

        try
        {
            var response = await PostSelfAsync(
                "/auth/verify-mfa",
                new { userId = _mfaUserId.Value, code = _mfaCode.Trim() });

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<MfaVerifyResponse>();
                if (result?.ExchangeToken is not null)
                {
                    var returnUrl = Uri.EscapeDataString(ReturnUrl ?? "/");
                    Navigation.NavigateTo(
                        $"/auth/complete?token={result.ExchangeToken}&returnUrl={returnUrl}",
                        forceLoad: true);
                }
            }
            else
            {
                _errorMessage = "Invalid authenticator code. Please try again.";
            }
        }
        catch (Exception)
        {
            _errorMessage = "Unable to reach the server. Please try again later.";
        }
        finally
        {
            _submitting = false;
        }
    }

    private void ResetToEmail()
    {
        _step = LoginStep.EnterEmail;
        _code = string.Empty;
        _errorMessage = null;
    }

    private record VerifyResponse(bool Success, bool RequiresMfa, int? Id, string? Email, string? ExchangeToken);
    private record MfaVerifyResponse(string? ExchangeToken);

    // ── Dev Quick Sign-In ──

    private static readonly DevPersona[] _devPersonas =
    [
        new("admin-systemadmin",       "admin@acmecoffee.com",        "Admin — SystemAdmin (full access)",                                          null),
        new("jdoe-backoffice",         "jdoe@acmecoffee.com",         "Jordan Ellis — BackofficeUser",                                               null),
        new("jdoe-bakedin-user",       "jdoe@acmecoffee.com",         "Jordan Ellis — User (baked-in role override, Role Documentation only)",       "User"),
        new("kbrown-backoffice-admin", "kbrown@acmecoffee.com",       "Kai Brown — BackofficeUserAdmin",                                              null),
        new("james-customer",          "james.smith@example.com",     "James Smith — Customer (retail business)",                                     null),
        new("casey-dual",              "casey.hart@acmecoffee.com",   "Casey Hart — Dual membership (internal + retail)",                             null),
        new("sloane-regional",         "sloane.reyes@acmecoffee.com", "Sloane Reyes — Regional sales rep (multi-org admin)",                          null)
    ];

    private string? _selectedPersona;
    private bool _devSigningIn;
    private string? _devError;
    private IJSObjectReference? _devSignInModule;

    private async Task DevSignInAsync()
    {
        if (string.IsNullOrEmpty(_selectedPersona))
            return;

        var persona = _devPersonas.FirstOrDefault(p =>
            string.Equals(p.Id, _selectedPersona, StringComparison.Ordinal));
        if (persona is null)
        {
            _devError = "Selected persona could not be resolved.";
            return;
        }

        _devSigningIn = true;
        _devError = null;

        try
        {
            _devSignInModule ??= await JS.InvokeAsync<IJSObjectReference>(
                "import", "./dev-quick-signin.js");

            await _devSignInModule.InvokeVoidAsync(
                "signIn",
                persona.Email,
                AuthOptions.Value.SeededSession.SharedSecret,
                persona.RolesOverride);
        }
        catch (Exception ex)
        {
            _devError = $"Sign-in failed: {ex.Message}";
        }
        finally
        {
            _devSigningIn = false;
        }
    }

    private record DevPersona(string Id, string Email, string Label, string? RolesOverride);
}
