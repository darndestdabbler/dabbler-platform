@using AcmeCoffeeOnline.Web.Components.Layout

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <DabblerAssetLinks />
    <link href="css/app.css" rel="stylesheet" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />

    <div id="blazor-error-ui">
        An unhandled error has occurred.
        <a href="" class="reload">Reload</a>
        <a class="dismiss">X</a>
    </div>

    <div id="components-reconnect-modal">
        <div class="reconnect-card">
            <div class="reconnect-attempting">
                <h5>Connection lost</h5>
                <p>Attempting to reconnect to the server...</p>
            </div>
            <div class="reconnect-failed">
                <h5>Reconnection failed</h5>
                <p>Please <a href="">reload the page</a> to restore functionality.</p>
            </div>
        </div>
    </div>

    <script src="_framework/blazor.web.js"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
</body>

</html>
