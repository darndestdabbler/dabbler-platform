@inherits LayoutComponentBase
@using System.Security.Claims
@using AcmeCoffeeOnline.Shared.DTOs
@using AcmeCoffeeOnline.Web.Services
@using Dabbler.Security.Blazor.Components
@inject NavigationManager NavigationManager
@inject ShellSessionStateLoader ShellSessionStateLoader

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    @* ── App bar ────────────────────────────────────────────────────── *@
    <MudAppBar Elevation="1" Dense="true">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit"
                       Edge="Edge.Start" OnClick="ToggleDrawer"
                       aria-label="Toggle navigation menu" />
        <MudIcon Icon="@Icons.Material.Filled.LocalCafe" Class="ml-2" />
        <MudText Typo="Typo.subtitle1" Class="ml-2" Style="font-weight: 600;">
            AcmeCoffeeDistributors
        </MudText>

        <MudSpacer />

        @if (!string.IsNullOrWhiteSpace(_activeOrganizationName))
        {
            <div data-testid="active-organization-summary"
                 style="display:flex; flex-direction:column; align-items:flex-end;">
                <span class="mud-typography mud-typography-caption mud-secondary-text">Active org</span>
                <span class="mud-typography mud-typography-body2" data-testid="active-organization-label">
                    @_activeOrganizationName
                </span>
            </div>
        }

        @if (_organizationOptions.Count > 1 || _isSystemAdmin)
        {
            <MudMenu Label="Switch org" StartIcon="@Icons.Material.Filled.Business"
                     Variant="Variant.Text" Color="Color.Inherit" Dense="true"
                     AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                @foreach (var organization in _organizationOptions)
                {
                    <MudMenuItem Disabled="@organization.IsActive"
                                 OnClick="@(() => SwitchOrganizationAsync(organization.OrganizationId))">
                        @organization.OrganizationName
                    </MudMenuItem>
                }
            </MudMenu>
        }

        @if (!string.IsNullOrWhiteSpace(_activeOrganizationName) || _organizationOptions.Count > 0)
        {
            <MudDivider Vertical="true" FlexItem="true" Class="mx-1" Style="height: 24px;" />
        }

        <DabblerRoleSwitcher />
        <MudDivider Vertical="true" FlexItem="true" Class="mx-1" Style="height: 24px;" />

        <MudMenu Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Inherit" Dense="true"
                 AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
            <MudMenuItem Disabled="true">
                <MudText Typo="Typo.body2" Style="font-weight: 600;">@_userName</MudText>
            </MudMenuItem>
            @if (!string.IsNullOrWhiteSpace(_activeOrganizationName))
            {
                <MudMenuItem Disabled="true">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        @_activeOrganizationName (@_activeOrganizationKey)
                    </MudText>
                </MudMenuItem>
            }
            <MudMenuItem Disabled="true">
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @(string.Join(", ", _userRoles))
                </MudText>
            </MudMenuItem>
            <MudDivider />
            <MudMenuItem Icon="@Icons.Material.Filled.Logout"
                         OnClick="@(() => NavigationManager.NavigateTo("/auth/logout", forceLoad: true))">
                Sign Out
            </MudMenuItem>
        </MudMenu>
    </MudAppBar>

    @* ── Left navigation drawer ─────────────────────────────────────── *@
    <MudDrawer @bind-Open="_drawerOpen" Elevation="1" Variant="@DrawerVariant.Responsive"
               data-testid="nav-drawer">
        <MudNavMenu>
            <MudNavLink Href="/dashboard" Icon="@Icons.Material.Filled.Dashboard"
                        Match="NavLinkMatch.All">
                Dashboard
            </MudNavLink>
            <MudNavLink Href="/orders" Icon="@Icons.Material.Filled.ShoppingCart"
                        Match="NavLinkMatch.Prefix">
                Orders
            </MudNavLink>
            <MudNavLink Href="/customers" Icon="@Icons.Material.Filled.People"
                        Match="NavLinkMatch.Prefix">
                Retail Businesses
            </MudNavLink>
            <MudNavLink Href="/products" Icon="@Icons.Material.Filled.Inventory"
                        Match="NavLinkMatch.Prefix">
                Products
            </MudNavLink>

            <MudDivider Class="my-2" />
            <MudNavGroup Title="Reports" Icon="@Icons.Material.Filled.Assessment"
                         Expanded="false">
                <MudNavLink Href="/reports/orders-by-customer"
                            Icon="@Icons.Material.Filled.Assessment">
                    Orders by Retail Business
                </MudNavLink>
                <MudNavLink Href="/reports/sales-by-product"
                            Icon="@Icons.Material.Filled.BarChart">
                    Sales by Product
                </MudNavLink>
            </MudNavGroup>

            @if (_isAdmin)
            {
                <MudDivider Class="my-2" />
                <MudNavGroup Title="Admin" Icon="@Icons.Material.Filled.AdminPanelSettings"
                             Expanded="false">
                    <MudNavLink Href="/admin/users"
                                Icon="@Icons.Material.Filled.People">
                        User Management
                    </MudNavLink>
                    @if (_isSystemAdmin)
                    {
                        <MudNavLink Href="/admin/products"
                                    Icon="@Icons.Material.Filled.Inventory">
                            Product Management
                        </MudNavLink>
                        <MudNavLink Href="/admin/security"
                                    Icon="@Icons.Material.Filled.Shield">
                            Security Dashboard
                        </MudNavLink>
                    }
                </MudNavGroup>
            }
        </MudNavMenu>
    </MudDrawer>

    @* ── Main content area (routed pages) ───────────────────────────── *@
    <MudMainContent Class="pa-4" data-testid="routed-page-content">
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private string _userId = "";
    private string _userName = "";
    private IReadOnlyList<string> _userRoles = Array.Empty<string>();
    private bool _isAdmin;
    private bool _isSystemAdmin;
    private string? _activeOrganizationKey;
    private string? _activeOrganizationName;
    private IReadOnlyList<OrganizationOptionDto> _organizationOptions = [];

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#1976D2",
            Secondary = "#388E3C",
            AppbarBackground = "#FFFFFF",
            AppbarText = "#424242",
            DrawerBackground = "#FAFAFA",
            DrawerText = "#424242",
            Surface = "#FFFFFF",
            Background = "#F5F5F5"
        },
        Typography = new Typography
        {
            Default = new DefaultTypography
            {
                FontFamily = ["Roboto", "Helvetica", "Arial", "sans-serif"]
            }
        },
        LayoutProperties = new LayoutProperties
        {
            DefaultBorderRadius = "4px"
        }
    };

    protected override async Task OnInitializedAsync()
    {
        var shellState = await ShellSessionStateLoader.LoadAsync();

        _userId = shellState.UserId;
        _userName = shellState.UserName;
        _userRoles = shellState.UserRoles;
        _isAdmin = shellState.IsAdmin;
        _isSystemAdmin = shellState.IsSystemAdmin;
        _activeOrganizationKey = shellState.ActiveOrganizationKey;
        _activeOrganizationName = shellState.ActiveOrganizationName;
        _organizationOptions = shellState.OrganizationOptions;
    }

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    private Task SwitchOrganizationAsync(int organizationId)
    {
        var relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        var returnUrl = string.IsNullOrWhiteSpace(relativePath)
            ? "/"
            : "/" + relativePath;

        NavigationManager.NavigateTo(
            $"/auth/switch-organization?organizationId={organizationId}&returnUrl={Uri.EscapeDataString(returnUrl)}",
            forceLoad: true);

        return Task.CompletedTask;
    }
}
