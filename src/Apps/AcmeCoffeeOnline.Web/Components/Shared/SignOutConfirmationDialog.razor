@using MudBlazor

<MudDialog data-testid="signout-confirmation-dialog">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Logout" Class="mr-2" />
            Sign out?
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2">
            Are you sure you want to sign out of AcmeCoffeeDistributors?
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" data-testid="signout-cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="Confirm"
                   data-testid="signout-confirm">
            Sign out
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    private void Confirm() => MudDialog.Close(DialogResult.Ok(true));

    private void Cancel() => MudDialog.Cancel();
}
