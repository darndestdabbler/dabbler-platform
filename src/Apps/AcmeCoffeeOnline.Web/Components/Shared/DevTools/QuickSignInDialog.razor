@using AcmeCoffeeOnline.Web.Configuration
@using Microsoft.Extensions.Options
@inject IOptions<AppAuthenticationOptions> AuthOptions
@inject IJSRuntime JS

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.Login" Color="Color.Warning" />
            <MudText Typo="Typo.h6">Dev Quick Sign-In</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudText Typo="Typo.body2">
                Pick a seeded persona. Signing in reloads the page under the selected identity.
            </MudText>

            <MudSelect T="string"
                       @bind-Value="_selectedPersonaId"
                       Label="Select a test persona"
                       Variant="Variant.Outlined"
                       AnchorOrigin="Origin.BottomCenter"
                       data-testid="dev-tools-persona-select">
                @foreach (var persona in _devPersonas)
                {
                    <MudSelectItem Value="@persona.Id">
                        @persona.Label
                    </MudSelectItem>
                }
            </MudSelect>

            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Dense="true" data-testid="dev-tools-persona-error">
                    @_error
                </MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Warning"
                   OnClick="SignInAsync"
                   Disabled="@(_signingIn || string.IsNullOrEmpty(_selectedPersonaId))"
                   data-testid="dev-tools-persona-signin">
            @if (_signingIn)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                @:Signing in...
            }
            else
            {
                @:Sign in as selected user
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    private static readonly DevPersona[] _devPersonas =
    [
        new("admin-systemadmin",        "admin@acmecoffee.com",        "Admin — SystemAdmin (full access)",                         null),
        new("jdoe-backoffice",          "jdoe@acmecoffee.com",         "Jordan Ellis — BackofficeUser",                              null),
        new("juser-bakedin-user",       "juser@acmecoffee.com",        "Jamie Ng — User (baked-in, Role Documentation only)",        null),
        new("kbrown-backoffice-admin",  "kbrown@acmecoffee.com",       "Kai Brown — BackofficeUserAdmin",                             null),
        new("james-customer",           "james.smith@example.com",     "James Smith — Customer (retail business)",                    null),
        new("casey-dual",               "casey.hart@acmecoffee.com",   "Casey Hart — Dual membership (internal + retail)",            null),
        new("sloane-regional",          "sloane.reyes@acmecoffee.com", "Sloane Reyes — Regional sales rep (multi-org admin)",         null)
    ];

    private string? _selectedPersonaId;
    private bool _signingIn;
    private string? _error;
    private IJSObjectReference? _module;

    private async Task SignInAsync()
    {
        if (string.IsNullOrEmpty(_selectedPersonaId))
        {
            return;
        }

        var persona = _devPersonas.FirstOrDefault(p =>
            string.Equals(p.Id, _selectedPersonaId, StringComparison.Ordinal));
        if (persona is null)
        {
            _error = "Selected persona could not be resolved.";
            return;
        }

        _signingIn = true;
        _error = null;

        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>(
                "import", "./dev-quick-signin.js");

            await _module.InvokeVoidAsync(
                "signIn",
                persona.Email,
                AuthOptions.Value.SeededSession.SharedSecret,
                persona.RolesOverride);
        }
        catch (Exception ex)
        {
            _error = $"Sign-in failed: {ex.Message}";
        }
        finally
        {
            _signingIn = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private sealed record DevPersona(string Id, string Email, string Label, string? RolesOverride);
}
