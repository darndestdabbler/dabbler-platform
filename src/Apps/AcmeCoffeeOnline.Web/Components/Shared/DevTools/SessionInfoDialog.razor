@using System.Text.Json
@using AcmeCoffeeOnline.Web.Services.DevTools
@inject TestAuthClient TestAuth

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.Info" Color="Color.Info" />
            <MudText Typo="Typo.h6">Session Info</MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="2">
            <MudText Typo="Typo.body2">
                Current server-side session for the signed-in user, matching the
                <code>/test-auth/session-info</code> payload.
            </MudText>

            @if (_loading)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Info" />
            }
            else if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true" data-testid="dev-tools-session-error">
                    @_error
                </MudAlert>
            }
            else
            {
                <MudPaper Class="pa-3"
                          Style="background-color: var(--mud-palette-background-gray); max-height: 420px; overflow: auto;"
                          Elevation="0"
                          Outlined="true">
                    <pre data-testid="dev-tools-session-json"
                         style="margin: 0; font-family: ui-monospace, 'Cascadia Code', 'Consolas', monospace; font-size: 0.85rem; white-space: pre-wrap; word-break: break-word;">@_prettyJson</pre>
                </MudPaper>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="RefreshAsync"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   data-testid="dev-tools-session-refresh">
            Refresh
        </MudButton>
        <MudButton OnClick="Close" Color="Color.Primary" Variant="Variant.Filled">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    private bool _loading = true;
    private string? _error;
    private string _prettyJson = "";

    private static readonly JsonSerializerOptions _jsonOptions = new()
    {
        WriteIndented = true,
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task RefreshAsync()
    {
        _loading = true;
        StateHasChanged();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _error = null;
        try
        {
            var snapshot = await TestAuth.GetSessionInfoAsync();
            _prettyJson = JsonSerializer.Serialize(snapshot, _jsonOptions);
        }
        catch (Exception ex)
        {
            _error = $"Could not load session info: {ex.Message}";
            _prettyJson = "";
        }
        finally
        {
            _loading = false;
        }
    }

    private void Close() => MudDialog.Close();
}
