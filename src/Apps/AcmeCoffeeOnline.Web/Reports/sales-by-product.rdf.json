{
  "metadata": {
    "name": "Sales by Product",
    "description": "Sales summary grouped by product showing quantities sold and revenue. Filterable by date range and roast level.",
    "author": "AcmeCoffeeDistributors",
    "version": "1.0",
    "pageWidth": 11.0,
    "pageHeight": 8.5,
    "orientation": "Landscape",
    "marginTop": 0.5,
    "marginBottom": 0.5,
    "marginLeft": 0.75,
    "marginRight": 0.75,
    "defaultFontFamily": "Segoe UI",
    "defaultFontSize": 9
  },
  "dataSources": [
    {
      "name": "main",
      "connectionName": "AcmeCoffeeApi",
      "providerType": "Custom",
      "query": "SELECT * FROM OrderItems JOIN Products ON OrderItems.ProductId = Products.Id WHERE OrderDate BETWEEN @StartDate AND @EndDate ORDER BY ProductName, OrderDate"
    }
  ],
  "parameters": [
    {
      "name": "StartDate",
      "dataType": "DateTime",
      "controlType": "DatePicker",
      "promptText": "Start Date",
      "isRequired": true,
      "sortOrder": 1
    },
    {
      "name": "EndDate",
      "dataType": "DateTime",
      "controlType": "DatePicker",
      "promptText": "End Date",
      "isRequired": true,
      "sortOrder": 2
    },
    {
      "name": "RoastLevel",
      "dataType": "String",
      "controlType": "ComboBox",
      "promptText": "Roast Level",
      "defaultValue": "",
      "isRequired": false,
      "sortOrder": 3,
      "lookupQuery": "SELECT DISTINCT RoastLevel FROM Products ORDER BY RoastLevel"
    },
    {
      "name": "FilterSummary",
      "dataType": "String",
      "controlType": "TextBox",
      "promptText": "Filter Summary",
      "defaultValue": "",
      "isRequired": false,
      "sortOrder": 99,
      "isHidden": true
    }
  ],
  "fields": [
    { "name": "ProductName", "dataType": "String", "sourceColumn": "ProductName" },
    { "name": "RoastLevel", "dataType": "String", "sourceColumn": "RoastLevel" },
    { "name": "OrderId", "dataType": "Int32", "sourceColumn": "OrderId" },
    { "name": "OrderDate", "dataType": "DateTime", "sourceColumn": "OrderDate", "formatString": "d" },
    { "name": "CustomerName", "dataType": "String", "sourceColumn": "CustomerName" },
    { "name": "Quantity", "dataType": "Int32", "sourceColumn": "Quantity" },
    { "name": "UnitPrice", "dataType": "Decimal", "sourceColumn": "UnitPrice", "formatString": "C2" },
    { "name": "LineTotal", "dataType": "Decimal", "sourceColumn": "LineTotal", "formatString": "C2" }
  ],
  "grouping": [
    {
      "fieldName": "ProductName",
      "sortDirection": "Ascending",
      "headerBandName": "productHeader",
      "footerBandName": "productFooter",
      "keepTogether": false,
      "resetAggregates": true,
      "pageBreakBefore": false
    }
  ],
  "bands": [
    {
      "name": "reportHeader",
      "type": "ReportHeader",
      "height": 1.2,
      "elements": [
        {
          "type": "StaticText",
          "x": 0,
          "y": 0.1,
          "width": 5.0,
          "height": 0.4,
          "value": "Sales by Product",
          "styleName": "reportTitle"
        },
        {
          "type": "TextField",
          "x": 0,
          "y": 0.55,
          "width": 6.0,
          "height": 0.25,
          "expression": "{@FilterSummary}",
          "styleName": "filterSummary"
        },
        {
          "type": "TextField",
          "x": 7.0,
          "y": 0.55,
          "width": 2.5,
          "height": 0.25,
          "expression": "{Now}",
          "formatString": "g",
          "styleName": "dateStamp"
        },
        {
          "type": "Line",
          "x": 0,
          "y": 1.0,
          "width": 9.5,
          "height": 0,
          "lineDirection": "Horizontal",
          "styleName": "thickLine"
        }
      ]
    },
    {
      "name": "pageHeader",
      "type": "PageHeader",
      "height": 0.4,
      "elements": [
        {
          "type": "StaticText",
          "x": 0,
          "y": 0.05,
          "width": 0.8,
          "height": 0.25,
          "value": "Order #",
          "styleName": "columnHeader"
        },
        {
          "type": "StaticText",
          "x": 0.8,
          "y": 0.05,
          "width": 1.5,
          "height": 0.25,
          "value": "Order Date",
          "styleName": "columnHeader"
        },
        {
          "type": "StaticText",
          "x": 2.3,
          "y": 0.05,
          "width": 3.2,
          "height": 0.25,
          "value": "Retail business contact",
          "styleName": "columnHeader"
        },
        {
          "type": "StaticText",
          "x": 5.5,
          "y": 0.05,
          "width": 1.0,
          "height": 0.25,
          "value": "Qty",
          "styleName": "columnHeaderRight"
        },
        {
          "type": "StaticText",
          "x": 6.5,
          "y": 0.05,
          "width": 1.5,
          "height": 0.25,
          "value": "Unit Price",
          "styleName": "columnHeaderRight"
        },
        {
          "type": "StaticText",
          "x": 8.0,
          "y": 0.05,
          "width": 1.5,
          "height": 0.25,
          "value": "Line Total",
          "styleName": "columnHeaderRight"
        },
        {
          "type": "Line",
          "x": 0,
          "y": 0.35,
          "width": 9.5,
          "height": 0,
          "lineDirection": "Horizontal",
          "styleName": "headerLine"
        }
      ]
    },
    {
      "name": "productHeader",
      "type": "GroupHeader",
      "height": 0.45,
      "groupName": "ProductName",
      "elements": [
        {
          "type": "Rectangle",
          "x": 0,
          "y": 0,
          "width": 9.5,
          "height": 0.4,
          "styleName": "groupHeaderBackground"
        },
        {
          "type": "TextField",
          "x": 0.1,
          "y": 0.05,
          "width": 5.0,
          "height": 0.25,
          "fieldName": "ProductName",
          "styleName": "groupHeaderText"
        },
        {
          "type": "TextField",
          "x": 6.0,
          "y": 0.05,
          "width": 3.0,
          "height": 0.25,
          "expression": "\"Roast: \" + [RoastLevel]",
          "styleName": "groupHeaderDetail"
        }
      ]
    },
    {
      "name": "detail",
      "type": "Detail",
      "height": 0.26,
      "elements": [
        {
          "type": "TextField",
          "x": 0,
          "y": 0.02,
          "width": 0.8,
          "height": 0.2,
          "fieldName": "OrderId",
          "styleName": "detailText"
        },
        {
          "type": "TextField",
          "x": 0.8,
          "y": 0.02,
          "width": 1.5,
          "height": 0.2,
          "fieldName": "OrderDate",
          "styleName": "detailText"
        },
        {
          "type": "TextField",
          "x": 2.3,
          "y": 0.02,
          "width": 3.2,
          "height": 0.2,
          "fieldName": "CustomerName",
          "styleName": "detailText"
        },
        {
          "type": "TextField",
          "x": 5.5,
          "y": 0.02,
          "width": 1.0,
          "height": 0.2,
          "fieldName": "Quantity",
          "styleName": "detailNumber"
        },
        {
          "type": "TextField",
          "x": 6.5,
          "y": 0.02,
          "width": 1.5,
          "height": 0.2,
          "fieldName": "UnitPrice",
          "styleName": "detailCurrency"
        },
        {
          "type": "TextField",
          "x": 8.0,
          "y": 0.02,
          "width": 1.5,
          "height": 0.2,
          "fieldName": "LineTotal",
          "styleName": "detailCurrency"
        }
      ]
    },
    {
      "name": "productFooter",
      "type": "GroupFooter",
      "height": 0.4,
      "groupName": "ProductName",
      "elements": [
        {
          "type": "Line",
          "x": 5.5,
          "y": 0.0,
          "width": 4.0,
          "height": 0,
          "lineDirection": "Horizontal",
          "styleName": "subtotalLine"
        },
        {
          "type": "TextField",
          "x": 0.1,
          "y": 0.05,
          "width": 5.0,
          "height": 0.25,
          "expression": "\"Total for \" + [ProductName]",
          "styleName": "groupFooterLabel"
        },
        {
          "type": "TextField",
          "x": 5.5,
          "y": 0.05,
          "width": 1.0,
          "height": 0.25,
          "expression": "Sum([Quantity])",
          "formatString": "N0",
          "styleName": "groupFooterCount"
        },
        {
          "type": "TextField",
          "x": 8.0,
          "y": 0.05,
          "width": 1.5,
          "height": 0.25,
          "expression": "Sum([LineTotal])",
          "formatString": "C2",
          "styleName": "groupFooterTotal"
        }
      ]
    },
    {
      "name": "pageFooter",
      "type": "PageFooter",
      "height": 0.4,
      "elements": [
        {
          "type": "Line",
          "x": 0,
          "y": 0.0,
          "width": 9.5,
          "height": 0,
          "lineDirection": "Horizontal",
          "styleName": "thinLine"
        },
        {
          "type": "TextField",
          "x": 0,
          "y": 0.08,
          "width": 3.0,
          "height": 0.25,
          "expression": "{Now}",
          "formatString": "D",
          "styleName": "footerDate"
        },
        {
          "type": "TextField",
          "x": 6.5,
          "y": 0.08,
          "width": 3.0,
          "height": 0.25,
          "expression": "\"Page \" + {PageNumber} + \" of \" + {PageCount}",
          "styleName": "pageNumber"
        }
      ]
    },
    {
      "name": "reportFooter",
      "type": "ReportFooter",
      "height": 0.6,
      "elements": [
        {
          "type": "Line",
          "x": 0,
          "y": 0.0,
          "width": 9.5,
          "height": 0,
          "lineDirection": "Horizontal",
          "styleName": "thickLine"
        },
        {
          "type": "StaticText",
          "x": 0,
          "y": 0.1,
          "width": 2.0,
          "height": 0.3,
          "value": "Grand Total",
          "styleName": "grandTotalLabel"
        },
        {
          "type": "TextField",
          "x": 4.5,
          "y": 0.1,
          "width": 1.5,
          "height": 0.3,
          "expression": "Sum([Quantity], \"report\")",
          "formatString": "N0",
          "styleName": "grandTotalCount"
        },
        {
          "type": "StaticText",
          "x": 5.7,
          "y": 0.1,
          "width": 1.0,
          "height": 0.3,
          "value": "units",
          "styleName": "grandTotalCountLabel"
        },
        {
          "type": "TextField",
          "x": 8.0,
          "y": 0.1,
          "width": 1.5,
          "height": 0.3,
          "expression": "Sum([LineTotal], \"report\")",
          "formatString": "C2",
          "styleName": "grandTotalAmount"
        }
      ]
    }
  ],
  "styles": [
    {
      "name": "reportTitle",
      "fontFamily": "Segoe UI",
      "fontSize": 18,
      "isBold": true,
      "foregroundColor": "#1A1A2E"
    },
    {
      "name": "filterSummary",
      "fontSize": 9,
      "foregroundColor": "#666666",
      "isItalic": true
    },
    {
      "name": "dateStamp",
      "fontSize": 9,
      "foregroundColor": "#666666",
      "isItalic": true,
      "horizontalAlignment": "Right"
    },
    {
      "name": "columnHeader",
      "fontSize": 8,
      "isBold": true,
      "foregroundColor": "#333333",
      "backgroundColor": "#F0F0F0",
      "verticalAlignment": "Middle",
      "paddingLeft": 0.03
    },
    {
