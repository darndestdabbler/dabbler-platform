      "paddingRight": 0.03
    },
    {
      "name": "detailCurrency",
      "fontSize": 9,
      "horizontalAlignment": "Right",
      "verticalAlignment": "Middle",
      "paddingRight": 0.03
    },
    {
      "name": "subtotalLine",
      "foregroundColor": "#666666"
    },
    {
      "name": "groupFooterLabel",
      "fontSize": 9,
      "isBold": true,
