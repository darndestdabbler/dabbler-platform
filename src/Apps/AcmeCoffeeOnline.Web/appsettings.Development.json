{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "DetailedErrors": true,
  "ApiBaseUrl": "http://localhost:5021",
  "Authentication": {
    "DeliveryMode": "MagicLink",
    "SeededSession": {
      "Enabled": true,
      "SharedSecret": "acme-local-seeded-session",
      "AllowedRoles": [ "SystemAdmin", "CrossOrgUserAdmin", "CrossOrgMonitor", "UserAdmin", "User", "BackofficeUserAdmin", "BackofficeUser", "Customer", "WarehouseUser" ]
    }
  },
  "PlatformStubMode": {
    "Enabled": true
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=AcmeCoffeeOnline_Dev;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "DabblerSecurity": {
    "InternalApiKey": "dev-internal-key-acme",
    "Oidc": {
      "Authority": "https://localhost:5100",
      "ClientId": "acmecoffee-dev",
      "ClientSecret": "acmecoffee-secret-dev-only"
    }
  }
}
