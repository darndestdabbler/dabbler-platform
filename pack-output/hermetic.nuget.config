<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="local-pack-output" value="C:/Users/denmi/source/repos/dabbler-platform/pack-output" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <!-- In-repo packages MUST resolve from the local feed only -->
    <packageSource key="local-pack-output">
      <package pattern="Dabbler.Api.Querying" />
      <package pattern="Dabbler.Components" />
      <package pattern="Dabbler.Components.Compat" />
      <package pattern="Dabbler.Platform.Stubs" />
      <package pattern="Dabbler.Platform.Stubs.Components" />
      <package pattern="Dabbler.Platform.Stubs.Reports" />
      <package pattern="Dabbler.Platform.Stubs.Security" />
      <package pattern="Dabbler.Reports.Core" />
      <package pattern="Dabbler.Reports.Export" />
      <package pattern="Dabbler.Reports.Blazor" />
      <package pattern="Dabbler.Security" />
      <package pattern="Dabbler.Security.Blazor" />
      <package pattern="Dabbler.Security.DevIdp.Tool" />
      <package pattern="Dabbler.Testing.Blazor" />
      <package pattern="Dabbler.Templates" />
    </packageSource>
    <!-- All other packages resolve from nuget.org -->
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
  <config>
    <add key="globalPackagesFolder" value="C:/Users/denmi/source/repos/dabbler-platform/pack-output/.nuget-cache" />
  </config>
</configuration>
